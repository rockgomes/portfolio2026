---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title: string; description?: string; noindex?: boolean; showSwitch?: boolean }
const { title, description = '', noindex = false, showSwitch = false } = Astro.props;
// The build writes pages as files (astro.config.mjs), so the path ends in .html at build time. The real
// addresses have no .html (same as Webflow): /project/flex-academy, and / for the homepage.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
// Link preview image (scripts/make-share-image.mjs): the top of the homepage, 1200x630 drawn at 2x.
const shareImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <!-- Browser icons: the ❖ master glyph (scripts/make-icons.py) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Link previews (LinkedIn, Slack, iMessage, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rock Gomes" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="The top of Rock Gomes's portfolio: the headline 'I design products, start to finish. Clear, tested, and ready to go live.' next to a live table prototype." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
    {showSwitch && (
      <script is:inline>
        // Set the audience view before first paint so the page does not flash.
        (function () {
          var v = new URLSearchParams(location.search).get('view');
          if (!v) { try { v = localStorage.getItem('rg-view'); } catch (e) {} }
          if (v === 'recruiter' || v === 'engineer') document.documentElement.dataset.view = v;
          else document.documentElement.dataset.view = 'design';
        })();
      </script>
    )}
  </head>
  <body>
    <SiteHeader showSwitch={showSwitch} />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
