---
// Figma: Cursor set (44:562). Arrow path copied from the Figma asset; fill is each person's token colour, with the dark 1.2px outline.
interface Props { name: string; color: 'client' | 'pm' | 'rock' | 'dev' | 'you'; style?: string; class?: string }
const { name, color, style, class: cls } = Astro.props;
---
<span class:list={['cursor', `c-${color}`, cls]} style={style} data-overlay aria-hidden="true">
  <svg class="arrow" width="14" height="18" viewBox="0 0 14 18" fill="none"><path d="M1 1L13 10.5L7.2 11.2L4.4 16.8L1 1Z" fill="var(--c)" stroke="var(--color-text-primary)" stroke-width="1.2" stroke-linejoin="round" /></svg><span class="tag t-mono-label">{name}</span>
</span>
<style>
  .cursor { position: absolute; z-index: 5; pointer-events: none; width: 0; height: 0; }
  .arrow { position: absolute; left: 0; top: 0; overflow: visible; }
  .tag { position: absolute; left: 12px; top: 16px; padding: 3px 6px; border-radius: var(--radius-tag); background: var(--c); color: var(--color-surface-page); white-space: nowrap; }
  /* --c comes from the shared person colours in base.css (.c-*) */
</style>
