---
// Dropdown button for the engineer Storybook. Same look as the Columns button and menu in HeroTable.astro
// (Figma 154:21266, "tab / Columns"). DesignSystemsDev.astro handles opening and picking.
interface Props { name: string; label: string; options: string[]; value: string }
const { name, label, options, value } = Astro.props;
const chevron = '<svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2.5 4l2.5 2.5L7.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>';
---
<div class="dd" data-sb-dd={name}>
  <button type="button" class="dd-btn" aria-haspopup="menu" aria-expanded="false" aria-controls={`sb-dd-${name}`} aria-label={`${label}: ${value}`} data-sb-dd-btn><span data-sb-dd-value>{value}</span> <Fragment set:html={chevron} /></button>
  <div class="dd-menu" role="menu" id={`sb-dd-${name}`} aria-label={label} hidden>
    {options.map((o) => <button type="button" role="menuitemradio" aria-checked={o === value ? 'true' : 'false'} data-value={o}>{o}</button>)}
  </div>
</div>
<style>
  .dd { position: relative; display: inline-block; }
  .dd-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: var(--radius-control); border: 1px solid var(--color-border-strong); background: var(--color-surface-page); cursor: pointer; font: var(--type-ui-control); color: var(--color-text-secondary); white-space: nowrap; }
  .dd-btn:hover, .dd-btn[aria-expanded='true'] { color: var(--color-text-primary); }
  .dd-menu { position: absolute; top: calc(100% + 8px); right: 0; z-index: 10; min-width: 160px; display: flex; flex-direction: column; padding: 4px; background: var(--color-surface-page); border: 1px solid var(--color-border-strong); border-radius: 8px; box-shadow: var(--shadow-panel); }
  .dd-menu button { display: flex; align-items: center; gap: 10px; text-align: left; border: 0; background: transparent; padding: 7px 10px; border-radius: 5px; cursor: pointer; font: var(--type-ui-control); color: var(--color-text-primary); white-space: nowrap; }
  .dd-menu button:hover, .dd-menu button:focus-visible { background: var(--color-annotation-measure-soft); }
  .dd-menu button[aria-checked='true'] { color: var(--color-annotation-measure); font: var(--type-ui-control-strong); }
</style>
