---
// Homepage motion (motion plan): redlines measure themselves, selections are drawn like a drag, the numbers rules
// draw left to right, the Experience timeline draws with the scroll, the About labels appear one by one.
// All of it plays once per element (the timeline follows the scroll), and not at all with reduced motion.
---
<script>
  import { gsap, playOnce, reduceMotion } from '../lib/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // Switching views adds or removes sections, so scroll animations measure the page again (SiteHeader sends viewchange).
  document.documentElement.addEventListener('viewchange', () => requestAnimationFrame(() => ScrollTrigger.refresh()));

  // Redlines: both halves grow out from the label, then the end ticks, then the label.
  document.querySelectorAll<HTMLElement>('.dim').forEach((d) => {
    const sides = d.querySelectorAll<HTMLElement>('.side');
    const lines = [sides[0]?.querySelector('.line'), sides[1]?.querySelector('.line')].filter(Boolean) as HTMLElement[];
    const ticks = d.querySelectorAll('.tick'); const label = d.querySelector('.label');
    playOnce(d,
      () => { gsap.set(lines[0], { scaleX: 0, transformOrigin: '100% 50%' }); gsap.set(lines[1], { scaleX: 0, transformOrigin: '0% 50%' }); gsap.set(ticks, { scaleY: 0 }); gsap.set(label, { autoAlpha: 0 }); },
      () => gsap.timeline({ delay: 0.1 })
        .to(lines, { scaleX: 1, duration: 0.7, ease: 'power3.inOut' })
        .to(ticks, { scaleY: 1, duration: 0.25 }, '-=0.15')
        .to(label, { autoAlpha: 1, duration: 0.3 }, '-=0.1'));
  });

  // Selection boxes: drawn from the top-left corner like a marquee drag, then the handles and the size label.
  // Where a cursor waits inside the box (the headline), it does the drag and then leaves.
  document.querySelectorAll<HTMLElement>('[data-selection]').forEach((s) => {
    const handles = s.querySelectorAll('.h'); const size = s.querySelector('[data-size]');
    const host = s.parentElement!; const cursor = host.querySelector<HTMLElement>(':scope > .cursor');
    playOnce(host,
      () => { gsap.set(s, { clipPath: 'inset(-12px 100% 100% -12px)' }); gsap.set(handles, { scale: 0 }); gsap.set(size, { autoAlpha: 0 }); },
      () => {
        const tl = gsap.timeline({ delay: 0.25 });
        if (cursor) tl.fromTo(cursor, { autoAlpha: 0, x: -24, y: -18 }, { autoAlpha: 1, x: 0, y: 0, duration: 0.45 });
        tl.to(s, { clipPath: 'inset(-12px -12px -40px -12px)', duration: 0.9, ease: 'power2.inOut', clearProps: 'clipPath' });
        if (cursor) tl.to(cursor, { x: () => s.offsetWidth, y: () => s.offsetHeight, duration: 0.9, ease: 'power2.inOut' }, '<');
        tl.to(handles, { scale: 1, duration: 0.25, stagger: 0.03, ease: 'back.out(2)' })
          .to(size, { autoAlpha: 1, duration: 0.3 }, '<0.1');
        if (cursor) tl.to(cursor, { autoAlpha: 0, x: '+=14', y: '+=10', duration: 0.4, ease: 'power2.in' }, '+=0.35');
        // Once it has faded out, the cursor goes back to its start: a hidden cursor at the far corner still made the page
        // taller (the portrait's ends below the footer). Nothing visible changes.
        if (cursor) tl.set(cursor, { x: 0, y: 0 });
        // The hero story waits for the headline to finish (HeroStory.astro)
        if (cursor) tl.eventCallback('onComplete', () => document.dispatchEvent(new Event('hero:headline-done')));
        return tl;
      },
      0.5);
  });

  // Text selection on a title word: the highlight grows left to right, then the end caret lands.
  document.querySelectorAll<HTMLElement>('[data-text-selection]').forEach((t) => {
    const hl = t.querySelector('.hl'); const end = t.querySelector('.caret.e');
    playOnce(t.parentElement,
      () => { gsap.set(hl, { scaleX: 0, transformOrigin: '0% 50%' }); gsap.set(end, { autoAlpha: 0 }); },
      () => gsap.timeline({ delay: 0.3 })
        .to(hl, { scaleX: 1, duration: 0.55, ease: 'power2.inOut' })
        .to(end, { autoAlpha: 1, duration: 0.2 }),
      0.6);
  });

  // Numbers: the rule above each stat draws left to right, one after another (the values count up in Numbers.astro).
  const rules = document.querySelectorAll<HTMLElement>('[data-stat-rule]');
  playOnce(rules[0]?.closest('section') ?? null,
    () => gsap.set(rules, { scaleX: 0, transformOrigin: '0% 50%' }),
    () => gsap.to(rules, { scaleX: 1, duration: 0.8, stagger: 0.12, ease: 'power3.inOut' }),
    0.4);

  // Experience timeline: the red line grows with the scroll and shrinks back; each role's marker pops when reached.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline && !reduceMotion()) {
    gsap.fromTo(timeline, { '--draw': 0 }, { '--draw': 1, ease: 'none', scrollTrigger: { trigger: timeline, start: 'top 70%', end: 'bottom 70%', scrub: 0.4 } });
    timeline.querySelectorAll<HTMLElement>('.item').forEach((item) => {
      const mark = item.querySelector('.marker i');
      const st = { trigger: item, start: 'top 70%', toggleActions: 'play none none reverse' };
      gsap.fromTo(mark, { scale: 0 }, { scale: 1, duration: 0.35, ease: 'back.out(2.5)', scrollTrigger: st });
      gsap.fromTo(item.querySelector('.body'), { autoAlpha: 0.35 }, { autoAlpha: 1, duration: 0.4, scrollTrigger: { ...st } });
    });
  }

  // About: after the portrait selection draws, its labels appear one by one, top to bottom; the leader line draws
  // out to "subject: Rock" right after that label.
  const portrait = document.querySelector<HTMLElement>('#about .portrait');
  const tags = portrait ? [...portrait.querySelectorAll<HTMLElement>(':scope > .tag')] : [];
  const leader = portrait?.querySelector<HTMLElement>('.leader');
  playOnce(portrait ?? null,
    () => { gsap.set(tags, { autoAlpha: 0, x: -8 }); gsap.set(leader ?? [], { scaleX: 0, transformOrigin: '0% 50%' }); },
    () => {
      const tl = gsap.timeline({ delay: 1.2 });
      tags.forEach((t, i) => { tl.to(t, { autoAlpha: 1, x: 0, duration: 0.35 }, i * 0.3); if (i === 1 && leader) tl.to(leader, { scaleX: 1, duration: 0.35, ease: 'power2.inOut' }, i * 0.3 + 0.2); });
      return tl;
    },
    0.4);
  // Selected work: each collaborator moves in when their card comes into view, posts a comment, stays a moment,
  // then goes back the way they came, taking the comment along. (With reduced motion the comments just show.)
  document.querySelectorAll<HTMLElement>('[data-grid] .thumb-wrap').forEach((wrap) => {
    const cur = wrap.querySelector<HTMLElement>(':scope > .cursor'); if (!cur) return;
    const cm = wrap.querySelector<HTMLElement>(':scope > .cm');
    const away = { x: -70, y: 60 };
    playOnce(wrap,
      () => { if (cm) gsap.set(cm, { autoAlpha: 0 }); },
      () => {
        const tl = gsap.timeline({ delay: 0.6 });
        tl.fromTo(cur, { ...away, autoAlpha: 0 }, { x: 0, y: 0, autoAlpha: 1, duration: 0.8, ease: 'power2.out' });
        if (cm) tl.fromTo(cm, { autoAlpha: 0, scale: 0.9, transformOrigin: '0% 0%' }, { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'back.out(1.8)' }, '+=0.2');
        tl.to(cur, { ...away, autoAlpha: 0, duration: 0.8, ease: 'power2.in', clearProps: 'transform' }, '+=3.2');
        if (cm) tl.to(cm, { autoAlpha: 0, scale: 0.92, duration: 0.4, ease: 'power2.in' }, '<');
        return tl;
      },
      0.5);
  });
</script>
