---
// Figma: About (96:6936). Portrait with annotation tags, draggable selection overlay.
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import SelectionBox from './SelectionBox.astro';
import Cursor from './Cursor.astro';
import portrait from '../assets/home/portrait.png';
const alt = 'Rock standing on a rock by a mountain lake, in black and white';
// The engineer view writes each label as a data-* attribute of the photo, on a dark chip.
const tags = [
  { k: 'scene', v: 'mountain lake, morning haze', top: 75 },
  { k: 'subject', v: 'Rock', top: 261 },
  { k: 'prop', v: 'one rock (fitting)', top: 367 },
  { k: 'mode', v: 'monochrome', top: 479 },
];
---
<section class="about" id="about" aria-labelledby="about-title" data-recruiter-also>
  <div class="wrap inner section-top">
    <SectionHeader num="05" title="About" titleId="about-title" subtitle="subject annotated for completeness" dimension={`portrait.w = ${portrait.width} · portrait.h = ${portrait.height}`} command="file portrait.png" />
    <div class="body">
      <div class="pcol">
      <div class="portrait" data-draggable>
        <Image src={portrait} alt={alt} widths={[440, 880]} sizes="440px" class="img" />
        {tags.map((g) => <span class="tag ui-tag ui-tag-outline" style={`top:${(g.top / 544 * 100).toFixed(2)}%`}><span data-not-engineer>{g.k}: {g.v}</span><span data-engineer><span class="k">data-{g.k}="</span>{g.v}<span class="k">"</span></span></span>)}
        <i class="leader" aria-hidden="true"></i>
        <SelectionBox label="440 × 544" live />
        <Cursor name="Rock" color="rock" class="p-cursor" />
      </div>
      <p class="alt t-mono-label" data-engineer aria-hidden="true"><span class="k">alt</span>="{alt}"</p>
      </div>
      <div class="text">
        <p><strong>I am Rock. Senior product designer in Tallinn, Estonia.</strong> I have spent ten years on the kind of software people use all day at work: loan back-offices, support tools, CRM lists with 29,000 rows, checkouts that have to work in four countries.</p>
        <p>I like the hard, boring parts. Permissions. Edge cases. Tables that have to stay readable at 200 columns. The part where a design system has to survive a rebrand.</p>
        <p>I also build. Not slides of a thing, the thing. I use AI tools heavily to get from a Figma file to a clickable version fast, then I read the code, fix the tokens and the CSS, and hand the team something they can test. The two Dealfront demos on this page are that.</p>
        <p>Before this: Dealfront, Inbank, Pipedrive, Bigbank, and a back-office design system for a UK pharmacy group. Outside of work: photography, the gym, and small games.</p>
        <dl class="facts t-mono-body">
          <div><dt>based</dt><dd>Tallinn, Estonia (EET, UTC+2)</dd></div>
          <div><dt>works</dt><dd>contract or full-time, remote first</dd></div>
          <div><dt>tools</dt><dd>Figma, tokens, CSS, GSAP, Next.js, AI assistants</dd></div>
          <div><dt>speaks</dt><dd>English, Portuguese</dd></div>
        </dl>
        <p class="links t-mono-body"><a href="https://www.linkedin.com/in/rockgomes" target="_blank" rel="noopener">linkedin.com/in/rockgomes</a><a href="https://github.com/rockgomes" target="_blank" rel="noopener">github.com/rockgomes</a></p>
      </div>
    </div>
  </div>
</section>
<style>
  .inner { display: flex; flex-direction: column; gap: var(--space-48); padding-bottom: var(--space-120); }
  .body { display: flex; gap: var(--space-80); align-items: flex-start; }
  .pcol { display: flex; flex-direction: column; gap: var(--space-12); width: 440px; max-width: 100%; flex: none; }
  .portrait { position: relative; width: 100%; aspect-ratio: 440 / 544; border: 1px solid var(--color-border-strong); flex: none; touch-action: none; }
  /* Rock's cursor works as in the hero headline: it only shows while it draws the selection (Motion.astro), then leaves */
  .portrait :global(.p-cursor) { left: 0; top: 0; visibility: hidden; }
  .portrait :global(.img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tag { position: absolute; left: 39px; } /* the shared Tag, outline tone */
  .leader { position: absolute; left: 33.86%; top: 50%; width: 36px; height: 1px; background: var(--color-annotation-measure); }
  .alt { margin: 0; color: var(--color-text-secondary); }
  .alt .k { color: var(--color-annotation-measure); }
  /* Engineer view: dark chips (the inverse of the page), no ratio leader, no selection */
  :global(html[data-view='engineer']) .tag { border-color: transparent; background: var(--color-text-primary); color: var(--color-surface-page); white-space: normal; max-width: calc(100% - 78px); }
  .tag .k { opacity: 0.6; }
  :global(html[data-view='engineer']) .leader, :global(html[data-view='engineer'] .about .portrait .sel) { display: none; }
  .text { width: min(500px, 100%); display: flex; flex-direction: column; gap: var(--space-16); min-width: 0; }
  .text > p:not(.links) { margin: 0; font: var(--type-body-default); color: var(--color-text-secondary); }
  .text strong { font-weight: 600; color: var(--color-text-primary); }
  .facts { margin: 0; padding-top: var(--space-8); display: flex; flex-direction: column; gap: 6px; }
  .facts div { display: flex; gap: var(--space-12); }
  .facts dt { width: 56px; flex: none; color: var(--color-annotation-measure); }
  .facts dd { margin: 0; color: var(--color-text-secondary); }
  .links { margin: 0; padding-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-16); }
  .links a { color: var(--color-annotation-measure); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  /* Recruiter view (sober): no photo labels or their subtitle; no facts list, the summary at the top has them */
  :global(html[data-view='recruiter']) .about :is(.tag, .leader, .facts), :global(html[data-view='recruiter']) .about :global(.sh .sub) { display: none; }
  @media (max-width: 1040px) { .body { flex-direction: column; gap: var(--space-48); } }
  @media (max-width: 720px) { .inner { padding-bottom: var(--space-80); } }
  @media (max-width: 640px) { .tag { left: 16px; } :global(html[data-view='engineer']) .tag { max-width: calc(100% - 32px); } .leader { display: none; } }
</style>
