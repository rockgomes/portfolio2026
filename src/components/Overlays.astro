---
// Behaviour for the multiplayer overlays: text selection on a title word, live size labels, draggable boxes that stay where dropped.
---
<script>
  // 1. Text selection over the word "work" in the Selected work title (glyph-accurate, re-measured on resize).
  function placeTextSelection() {
    document.querySelectorAll<HTMLElement>('[data-text-selection-host]').forEach((host) => {
      const sel = host.querySelector<HTMLElement>('[data-text-selection]'); const title = host.querySelector<HTMLElement>('[data-title]');
      if (!sel || !title) return;
      const walker = document.createTreeWalker(title, NodeFilter.SHOW_TEXT); let node: Text | null = null; let idx = -1;
      while (walker.nextNode()) { const n = walker.currentNode as Text; const i = n.data.lastIndexOf('work'); if (i > -1) { node = n; idx = i; } }
      if (!node) return;
      const range = document.createRange(); range.setStart(node, idx); range.setEnd(node, idx + 4);
      const r = range.getBoundingClientRect(); const h = host.getBoundingClientRect();
      if (!r.width) { sel.classList.remove('on'); return; }
      Object.assign(sel.style, { left: `${r.left - h.left - 2}px`, top: `${r.top - h.top}px`, width: `${r.width + 5}px`, height: `${r.height}px` });
      sel.classList.add('on');
    });
  }
  // 2. Live size labels: every selection box marked live shows the real size of the element it selects.
  function placeSizes() {
    document.querySelectorAll<HTMLElement>('[data-selection="live"]').forEach((s) => {
      const p = s.parentElement!; const lab = s.querySelector<HTMLElement>('[data-size]');
      if (lab && !p.classList.contains('dragging')) lab.textContent = `${Math.round(p.offsetWidth)} × ${Math.round(p.offsetHeight)}`;
    });
  }
  const all = () => { placeTextSelection(); placeSizes(); };
  const ro = new ResizeObserver(all);
  document.querySelectorAll<HTMLElement>('[data-selection="live"]').forEach((s) => ro.observe(s.parentElement!));
  addEventListener('resize', all); document.addEventListener('work:filtered', () => setTimeout(all, 420));
  (document as any).fonts?.ready.then(all); all();

  // 3. Draggable: boxes with a selection can be dragged and stay where they are dropped (inside their section).
  // While dragging, the size label shows the offset; double-click puts the box back.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const signed = (n: number) => `${n >= 0 ? '+' : '−'}${Math.abs(Math.round(n))}`;
  document.querySelectorAll<HTMLElement>('[data-draggable]').forEach((el) => {
    let sx = 0, sy = 0, bx = 0, by = 0, ox = 0, oy = 0, down = false, moved = false;
    const lab = el.querySelector<HTMLElement>('[data-selection] [data-size]');
    const place = () => { el.style.transform = ox || oy ? `translate(${ox}px, ${oy}px)` : ''; el.classList.toggle('moved', !!(ox || oy)); };
    el.addEventListener('pointerdown', (e) => { if (e.button !== 0 || innerWidth < 1200) return; down = true; moved = false; sx = e.clientX; sy = e.clientY; bx = ox; by = oy; el.setPointerCapture(e.pointerId); el.style.transition = 'none'; });
    el.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) > 4) { moved = true; el.classList.add('dragging'); }
      if (!moved) return;
      const sec = (el.closest('section') ?? document.body).getBoundingClientRect(); const r = el.getBoundingClientRect();
      const left = r.left - ox, top = r.top - oy; // where the box sits with no offset
      ox = Math.min(sec.right - left - r.width, Math.max(sec.left - left, bx + dx));
      oy = Math.min(sec.bottom - top - r.height, Math.max(sec.top - top, by + dy));
      place();
      if (lab) lab.textContent = `x ${signed(ox)} · y ${signed(oy)}`;
    });
    const up = () => { if (!down) return; down = false; el.classList.remove('dragging'); placeSizes(); };
    el.addEventListener('pointerup', up); el.addEventListener('pointercancel', up);
    el.addEventListener('dblclick', () => { if (!ox && !oy) return; ox = 0; oy = 0; el.style.transition = reduce ? 'none' : 'transform 0.45s cubic-bezier(.2,.8,.2,1)'; place(); placeSizes(); });
    el.addEventListener('dragstart', (e) => e.preventDefault()); // the browser's own image drag would cancel ours
    el.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  });
</script>
