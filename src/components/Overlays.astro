---
// Behaviour for the multiplayer overlays: live size labels, draggable boxes that stay where dropped.
---
<script>
  // 1. Live size labels: every selection box marked live shows the real size of the element it selects.
  // Boxes marked data-fit="text" wrap the text lines of their parent (descenders and overhangs included), and
  // their label shows the size of that box. The parent's waiting cursor (headline) starts at the box's corner.
  function fitToText(s: HTMLElement) {
    const p = s.parentElement!; const pr = p.getBoundingClientRect(); const box = { l: Infinity, t: Infinity, r: -Infinity, b: -Infinity };
    const walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT, { acceptNode: (n) => (n.parentElement?.closest('[data-overlay]') || !n.textContent?.trim() ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT) });
    const range = document.createRange();
    while (walker.nextNode()) { range.selectNodeContents(walker.currentNode); for (const r of range.getClientRects()) { box.l = Math.min(box.l, r.left); box.t = Math.min(box.t, r.top); box.r = Math.max(box.r, r.right); box.b = Math.max(box.b, r.bottom); } }
    if (!isFinite(box.l)) return;
    const left = Math.floor(box.l - pr.left), top = Math.floor(box.t - pr.top), w = Math.ceil(box.r - pr.left) - left, h = Math.ceil(box.b - pr.top) - top;
    Object.assign(s.style, { left: `${left}px`, top: `${top}px`, width: `${w}px`, height: `${h}px`, right: 'auto', bottom: 'auto' });
    const cur = p.querySelector<HTMLElement>(':scope > .cursor'); if (cur) Object.assign(cur.style, { left: `${left}px`, top: `${top}px` });
  }
  function placeSizes() {
    document.querySelectorAll<HTMLElement>('[data-selection="live"]').forEach((s) => {
      const p = s.parentElement!; const lab = s.querySelector<HTMLElement>('[data-size]');
      if (p.classList.contains('dragging')) return;
      if (s.dataset.fit === 'text') fitToText(s);
      const el = s.dataset.fit === 'text' ? s : p;
      if (lab) lab.textContent = `${Math.round(el.offsetWidth)} × ${Math.round(el.offsetHeight)}`;
    });
  }
  const all = () => { placeSizes(); };
  const ro = new ResizeObserver(all);
  document.querySelectorAll<HTMLElement>('[data-selection="live"]').forEach((s) => ro.observe(s.parentElement!));
  addEventListener('resize', all); document.addEventListener('work:filtered', () => setTimeout(all, 420));
  (document as any).fonts?.ready.then(all); all();

  // 2. Draggable: boxes with a selection can be dragged (not in the recruiter or engineer view, which have no selections) and stay where they are dropped (inside their section,
  // or inside the closest [data-drag-bounds]).
  // While dragging, the size label shows the offset; double-click puts the box back.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const signed = (n: number) => `${n >= 0 ? '+' : '−'}${Math.abs(Math.round(n))}`;
  document.querySelectorAll<HTMLElement>('[data-draggable]').forEach((el) => {
    let sx = 0, sy = 0, bx = 0, by = 0, ox = 0, oy = 0, down = false, moved = false;
    const lab = el.querySelector<HTMLElement>('[data-selection] [data-size]');
    const place = () => { el.style.transform = ox || oy ? `translate(${ox}px, ${oy}px)` : ''; el.classList.toggle('moved', !!(ox || oy)); };
    el.addEventListener('pointerdown', (e) => { if (e.button !== 0 || innerWidth < 1200 || ['recruiter', 'engineer'].includes(document.documentElement.dataset.view ?? '')) return; down = true; moved = false; sx = e.clientX; sy = e.clientY; bx = ox; by = oy; el.setPointerCapture(e.pointerId); el.style.transition = 'none'; });
    el.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) > 4) { moved = true; el.classList.add('dragging'); }
      if (!moved) return;
      const sec = (el.closest('[data-drag-bounds]') ?? el.closest('section') ?? document.body).getBoundingClientRect(); const r = el.getBoundingClientRect();
      const left = r.left - ox, top = r.top - oy; // where the box sits with no offset
      ox = Math.min(sec.right - left - r.width, Math.max(sec.left - left, bx + dx));
      oy = Math.min(sec.bottom - top - r.height, Math.max(sec.top - top, by + dy));
      place();
      if (lab) lab.textContent = `x ${signed(ox)} · y ${signed(oy)}`;
    });
    const up = () => { if (!down) return; down = false; el.classList.remove('dragging'); placeSizes(); };
    el.addEventListener('pointerup', up); el.addEventListener('pointercancel', up);
    el.addEventListener('dblclick', () => { if (!ox && !oy) return; ox = 0; oy = 0; el.style.transition = reduce ? 'none' : 'transform 0.45s cubic-bezier(.2,.8,.2,1)'; place(); placeSizes(); });
    el.addEventListener('dragstart', (e) => e.preventDefault()); // the browser's own image drag would cancel ours
    el.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  });
</script>
