---
// Figma: Hero (96:6786) = Statement (96:6787) + Specimen with the live table window (96:6797).
import Dimension from './Dimension.astro';
import SelectionBox from './SelectionBox.astro';
import Cursor from './Cursor.astro';
import Comment from './Comment.astro';
import { messages } from '../data/heroStory';
import HeroStory from './HeroStory.astro';
import HeroTable from './HeroTable.astro';
import Inspector from './Inspector.astro';
// Each person's story messages, as children of their cursor (HeroStory shows them one by one).
const says = (color: string) => messages.map((m, i) => ({ ...m, i })).filter((m) => m.color === color);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="statement">
      <p class="gutter t-mono-label" aria-hidden="true" data-type-spec data-not-engineer>h1 · IBM Plex Sans 600 · 56/60</p>
      <p class="tag tag-open t-mono-label" aria-hidden="true" data-engineer>&lt;h1 id="hero-title"&gt;</p>
      <h1 id="hero-title" class="h1">
        <span class="h1-box" data-draggable>I design products, start to finish. <span class="accent">Clear, tested, and ready to go live.</span><SelectionBox label="498 × 252" live fit="text" class="h1-sel" /><Cursor name="Rock" color="rock" class="h1-cursor" /></span>
      </h1>
      <p class="tag tag-close t-mono-label" aria-hidden="true" data-engineer>&lt;/h1&gt;</p>
      <p class="sub lead">I'm Rock, a Senior Product Designer based in Tallinn, open to contract and full-time projects.</p>
      <p class="sub">I design the screens, build the tokens and components behind them, and ship a version the team can click through before anyone writes a ticket.</p>
    </div>

    <div class="specimen" data-specimen>
      <div data-not-engineer><Dimension label="live prototype · 734 × 509" live="specimen" /></div>
      <p class="tag jsx t-mono-label" aria-hidden="true" data-engineer>{'<FilterPanel rows={40} data="example">'}</p>
      <HeroTable />
      <p class="tag jsx jsx-close t-mono-label" aria-hidden="true" data-engineer>&lt;/FilterPanel&gt;</p>
      <div class="caption t-mono-label" data-not-engineer><span>fig. 00 · filter builder, example data <button type="button" class="replay" data-story-replay hidden>↻ replay the session</button></span><span data-table-meta>rows = 40 · fields = 6</span></div>

      <!-- Start points for the hero story. Hidden at rest (Rock's request): they fade in to act, then fade out.
           Each cursor carries its person's messages, so a message moves with the action it talks about. -->
      {[{ name: 'Rock', color: 'rock', left: 8 }, { name: 'PM', color: 'pm', left: 92 }, { name: 'Dev', color: 'dev', left: 164 }].map((c) => (
        <Cursor name={c.name} color={c.color as 'rock' | 'pm' | 'dev'} style={`left: ${c.left}px; top: 596px;`}>
          {says(c.color).map((m) => <Comment who={m.who} initial={m.initial} color={m.color} class:list={['say', m.above && 'say-above']} data-say={m.i}>{m.text}</Comment>)}
        </Cursor>
      ))}
      <HeroStory />
      <Inspector />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 64px 97px; }
  .grid { display: grid; grid-template-columns: minmax(0, 498px) minmax(0, 734px); justify-content: space-between; gap: var(--space-48); align-items: start; }
  .statement { display: flex; flex-direction: column; gap: var(--space-24); min-width: 0; }
  /* The type label mirrors the redline on the right (12px tall, 12px gap), so the headline's top meets the table's top */
  .gutter { margin: 0 0 -12px; height: 12px; line-height: 12px; color: var(--color-annotation-measure); }
  .h1 { margin: 0 0 28px; font: var(--type-display-hero); letter-spacing: var(--tracking-display-hero); color: var(--color-text-primary); }
  .h1-box { position: relative; display: block; }
  /* The headline box wraps the letters (Overlays.astro measures the text lines), and its label shows that size */
  /* Rock's cursor only shows while it draws the selection (Motion.astro), then leaves */
  .h1-box :global(.h1-cursor) { left: 0; top: 0; visibility: hidden; }
  .accent { color: var(--color-text-accent); }
  /* Engineer view (Figma: Hero C + 2B): code tags instead of the type label, selection and redline.
     The h1 tags sit 25px from the letters: above the capitals, below the last baseline. */
  .tag { margin: 0; color: var(--color-annotation-measure); white-space: nowrap; }
  .tag-open { margin-bottom: -14px; }
  .tag-close { margin: -40px 0 4px; }
  .jsx { line-height: 12px; height: 12px; }
  .jsx-close { padding-left: var(--space-24); }
  :global(html[data-view='engineer']) .h1-box :global(.h1-sel), :global(html[data-view='engineer']) .h1-box :global(.h1-cursor) { display: none; }
  :global(html[data-view='engineer']) .h1-box { cursor: auto; transform: none !important; }
  .sub { margin: 0; font: var(--type-body-lead); color: var(--color-text-secondary); }
  .sub.lead { font-weight: 500; color: var(--color-text-primary); }
  .specimen { position: relative; display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .caption { display: flex; justify-content: space-between; gap: var(--space-16); padding-left: var(--space-24); color: var(--color-text-muted); }
  /* Cursors and the comment thread sit above the table's + Condition menu (z-index 10) */
  .specimen > :global(.cursor) { z-index: 12; visibility: hidden; opacity: 0; }
  /* A story message sits below and right of its cursor, like the Projects comments (18px right, 43px down). Hidden until
     HeroStory shows it; HeroStory also keeps it inside the table's width. .say-above sits over the cursor instead. */
  .specimen > :global(.cursor .say) { left: 18px; top: 43px; width: 260px; visibility: hidden; opacity: 0; }
  .specimen > :global(.cursor .say-above) { top: auto; bottom: 20px; border-radius: 10px 10px 10px 2px; }
  .replay { margin-left: var(--space-8); padding: 0; border: 0; background: none; font: inherit; color: var(--color-annotation-measure); cursor: pointer; }
  .replay:hover { text-decoration: underline; }
  @media (max-width: 1199px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .statement { max-width: 640px; }
  }
  @media (max-width: 640px) { .hero { padding-block: 40px 64px; } .caption { padding-left: 0; flex-direction: column; gap: var(--space-4); } }
</style>

<script>
  // Live labels (the headline selection size is handled in Overlays), read from the page as it renders:
  // the headline's type spec, and the size of the live table.
  const fmt = (n: number) => Math.round(n);
  const win = document.querySelector<HTMLElement>('[data-hero-table]');
  const h1 = document.querySelector<HTMLElement>('#hero-title');
  const ro = new ResizeObserver(() => {
    const dl = document.querySelector<HTMLElement>('[data-dimension="specimen"] .label');
    if (win && dl) dl.textContent = `live prototype · ${fmt(win.offsetWidth)} × ${fmt(win.offsetHeight)}`;
    const tl = document.querySelector<HTMLElement>('[data-type-spec]');
    if (h1 && tl) { const c = getComputedStyle(h1); tl.textContent = `h1 · ${c.fontFamily.split(',')[0].replace(/["']/g, '')} ${c.fontWeight} · ${fmt(parseFloat(c.fontSize))}/${fmt(parseFloat(c.lineHeight))}`; }
  });
  if (win) ro.observe(win); if (h1) ro.observe(h1);
</script>
