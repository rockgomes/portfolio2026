---
// Figma: Projects (96:6873) = Section header + Filter panel (B, 96:6877) + Work card grid (52:2051).
// Filter rules (from the prototype): nothing selected = everything. Type is single choice.
// Same group = OR, different groups = AND. Counts show what you would get. Zero-result tags are disabled.
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';
import Cursor from './Cursor.astro';
import Comment from './Comment.astro';
import { isPrivate } from '../lib/private';

const projects = (await getCollection('projects')).filter((p) => !isPrivate(p.data)).map((p) => ({
  id: p.id, href: `/project/${p.id}`, img: p.data.homeImage, alt: p.data.homeImageAlt, demo: p.data.demoUrl, d: p.data,
}));
const experiments = (await getCollection('experiments')).filter((e) => !isPrivate(e.data)).map((e) => ({
  id: e.id, href: `/experiments/${e.id}`, img: e.data.cardImage, alt: '', demo: '', d: e.data,
}));
const items = [...projects, ...experiments].sort((a, b) => a.d.cardOrder - b.d.cardOrder);
const filterData = items.map((i) => ({ id: i.id, type: i.d.type, industry: i.d.industry, focus: i.d.focus }));
---
<section class="work" id="work" aria-labelledby="work-title">
  <div class="wrap inner section-top">
    <div class="sh-wrap">
      <SectionHeader anchor title="Projects" titleId="work-title" subtitle="client work and experiments in one list · filter with the tags on the left" />
    </div>

    <div class="layout">
      <aside class="side" aria-label="Filter projects" data-side>
        <!-- Below 1040px the panel folds into this button, so the projects come first -->
        <button type="button" class="ftoggle btn" aria-expanded="false" aria-controls="filter-panel" data-filter-toggle>Filter projects <span class="fcount t-mono-label" data-filter-toggle-count>{items.length} / {items.length}</span><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2.5 4l2.5 2.5L7.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></button>
        <div class="panel" id="filter-panel" data-filter-panel data-not-engineer>
          <div class="tabs utabs" role="tablist" aria-label="Filter mode">
            <button type="button" class="utab" role="tab" aria-selected="true" data-tab="groups">Filters</button>
            <button type="button" class="utab" role="tab" aria-selected="false" data-tab="flat">Tags</button>
            <span class="sp"></span>
            <span class="cnt t-mono-label" aria-live="polite" data-filter-count>{items.length} / {items.length}</span>
          </div>
          <div class="search-wrap">
            <label class="search">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="5" cy="5" r="3.6" stroke="currentColor" stroke-width="1.3"/><path d="M8 8l2.6 2.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
              <span class="sr-only">Find a tag</span>
              <input type="search" placeholder="Find a tag" autocomplete="off" data-filter-search />
            </label>
          </div>
          <div data-filter-groups></div>
          <button type="button" class="fshow btn btn-primary" data-filter-show>Show {items.length} projects</button>
        </div>
        <!-- Engineer view (Figma: Projects C, terminal): the same filter as a shell command. Click a flag value to
             switch it; the prompt at the bottom is a real input that finds a tag, like "Find a tag" above. -->
        <div class="panel dpanel" data-dev-panel data-engineer>
          <div class="dhead"><span class="t-mono-label">zsh</span><span class="sp"></span><span class="cnt t-mono-label" aria-live="polite" data-dev-count>{items.length} / {items.length}</span></div>
          <div class="dbody t-mono-body" data-dev-body></div>
          <label class="prompt t-mono-body"><span class="p" aria-hidden="true">$ </span><span class="sr-only">Find a tag</span><input type="text" spellcheck="false" autocomplete="off" placeholder="find a tag" data-dev-search /><span class="caret" aria-hidden="true"></span></label>
          <button type="button" class="fshow btn btn-primary" data-filter-show>Show {items.length} projects</button>
        </div>
      </aside>

      <div class="main">
        <div class="active" data-filter-active hidden data-not-engineer></div>
        <ul class="grid" data-grid>
          {items.map((it) => (
            <WorkCard id={it.id} href={it.href} img={it.img} alt={it.alt} demo={it.demo} d={it.d}>
              {/* Collaborators come in when the card comes into view, comment, then leave with their comment (Motion.astro).
                  Places are from Figma at 1440px (card 485px); on narrower cards they move left with the card's right edge, so they never leave the page. */}
              {it.id === 'dealfront-dynamic-lists' && <Fragment slot="overlay"><Cursor name="Dev" color="dev" style="left: min(150px, calc(100% - 335px)); top: 200px;" /><Comment who="Dev" initial="D" color="dev" when="just now" style="left: min(168px, calc(100% - 317px)); top: 243px; width: 290px;">Views only store the filter, so this was easy to build.</Comment></Fragment>}
              {it.id === 'inbank---hire-purchase' && <Fragment slot="overlay"><Cursor name="Client" color="client" style="left: min(195px, calc(100% - 290px)); top: 110px;" /><Comment who="Client" initial="C" when="2 min ago" style="left: min(213px, calc(100% - 272px)); top: 153px; width: 300px;">Support tickets went down after launch. Great job!</Comment></Fragment>}
              {it.id === 'bigbank---loan-flow' && <Fragment slot="overlay"><Cursor name="PM" color="pm" style="left: min(150px, calc(100% - 335px)); top: 150px;" /><Comment who="PM" initial="P" color="pm" when="just now" style="left: min(168px, calc(100% - 317px)); top: 193px; width: 290px;">This flow now works the same in all 7 countries. One design, no forks.</Comment></Fragment>}
            </WorkCard>
          ))}
        </ul>
        <div class="empty" data-filter-empty hidden>
          <p class="empty-t">No projects match all of these.</p>
          <p class="empty-s t-mono-label">Remove a filter to see more.</p>
          <button type="button" class="clear-all btn" data-clear-all>Clear all filters</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="work-filter-data" set:html={JSON.stringify(filterData)} />

<style>
  .inner { display: flex; flex-direction: column; gap: var(--space-48); }
  .sh-wrap { position: relative; }
  .layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: var(--space-40); align-items: start; }
  /* Sticky 24px under the sticky header. On short screens the tag list scrolls inside the panel, so every row and
     "more" stay reachable; the resolved comment keeps its size below. */
  .side { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: var(--space-12); max-height: calc(100vh - var(--header-h) - 48px); overflow-y: auto; scrollbar-width: thin; }
  .side > :global(*) { flex: none; }
  .panel { background: var(--color-surface-page); border: 1px solid var(--color-border-strong); border-radius: 10px; box-shadow: var(--shadow-panel); padding-bottom: var(--space-8); overflow: hidden; }
  .side > .panel { flex: 0 1 auto; min-height: 220px; display: flex; flex-direction: column; }
  .side > .panel > :global(*) { flex: none; }
  .side > .panel > [data-filter-groups] { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .tabs { padding-top: var(--space-12); } /* the shared Underline tab bar (.utabs) */
  .tabs .cnt { padding-bottom: 7px; }
  .sp { flex: 1 1 0; }
  .cnt { color: var(--color-text-muted); letter-spacing: 0; }
  .search-wrap { padding: 10px 10px 4px; }
  .search { display: flex; align-items: center; gap: var(--space-8); padding: 6px 9px; border: 1px solid var(--color-border-strong); border-radius: 6px; color: var(--color-text-muted); }
  .search:focus-within { border-color: var(--color-annotation-measure); }
  .search input { border: 0; outline: 0; background: transparent; width: 100%; min-width: 0; font: var(--type-ui-panel); color: var(--color-text-primary); }
  .search input::placeholder { color: var(--color-text-muted); }
  .panel :global(.sec) { display: flex; align-items: center; gap: 6px; padding: 10px 14px 4px; font: 600 11.5px/16px var(--font-sans); color: var(--color-text-primary); }
  .panel :global(.sec .caret) { border: 0; background: transparent; padding: 0; width: 8px; height: 8px; display: grid; place-items: center; cursor: pointer; color: var(--color-text-muted); }
  .panel :global(.sec .caret svg) { transition: transform 0.15s; }
  .panel :global(.sec .caret[aria-expanded='false'] svg) { transform: rotate(-90deg); }
  .panel :global(.sec .clr) { margin-left: auto; border: 0; background: transparent; padding: 0; cursor: pointer; font: var(--type-ui-status); color: var(--color-annotation-measure); }
  .panel :global(.row) { width: 100%; display: flex; align-items: center; gap: var(--space-8); height: 28px; padding: 0 14px 0 26px; border: 0; background: transparent; cursor: pointer; text-align: left; }
  .panel :global(.row:hover) { background: var(--color-surface-stage); }
  .panel :global(.row .ic) { width: 13px; flex: none; display: flex; justify-content: center; font: 400 11px/15px var(--font-mono); color: var(--color-figma-component); }
  .panel :global(.row .lab) { flex: 1 1 0; min-width: 0; font: var(--type-ui-panel); color: var(--color-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .panel :global(.row .num) { font: var(--type-mono-count); color: var(--color-text-muted); }
  .panel :global(.row .ok) { width: 10px; flex: none; display: grid; place-items: center; opacity: 0; color: var(--color-annotation-measure); }
  .panel :global(.row[aria-checked='true']) { background: var(--color-annotation-measure-soft); }
  .panel :global(.row[aria-checked='true'] .lab) { font: var(--type-ui-panel-strong); color: var(--color-annotation-measure); }
  .panel :global(.row[aria-checked='true'] .num) { color: var(--color-annotation-measure); }
  .panel :global(.row[aria-checked='true'] .ok) { opacity: 1; }
  .panel :global(.row:disabled) { cursor: default; opacity: 0.4; }
  .panel :global(.row:disabled:hover) { background: transparent; }
  .panel :global(.row mark) { background: var(--color-annotation-measure-soft); color: inherit; border-radius: var(--radius-tag); }
  .panel :global(.more) { border: 0; background: transparent; cursor: pointer; padding: 6px 14px 4px 46px; font: var(--type-ui-panel); color: var(--color-text-muted); text-align: left; }
  .panel :global(.more:hover) { color: var(--color-text-primary); }
  .panel :global(.none) { padding: 6px 14px 4px 26px; font: var(--type-ui-panel); color: var(--color-text-muted); }
  .main { min-width: 0; }
  .active { display: flex; flex-wrap: wrap; gap: var(--space-8); align-items: center; margin-bottom: var(--space-24); }
  .active :global(.pill i) { font-style: normal; color: var(--color-text-muted); }
  .active :global(.clear-all-inline) { border: 0; background: transparent; cursor: pointer; padding: var(--space-4) 0; font: var(--type-mono-label); color: var(--color-annotation-measure); }
  .grid { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-48) var(--space-24); }
  .empty { border: 1px dashed var(--color-border-strong); padding: var(--space-32) var(--space-24); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .empty p { margin: 0; } .empty-t { font: var(--type-heading-item); }
  .empty-s { color: var(--color-text-muted); }
  .ftoggle, .fshow { display: none; }
  /* The filter as a terminal. Each flag value is a real button; on values are green. */
  .dhead { display: flex; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-primary); }
  .dbody { padding: 10px 0 4px; white-space: pre; color: var(--color-text-primary); overflow-x: auto; }
  .dpanel :global(.ln) { display: flex; gap: var(--space-8); width: 100%; min-height: 19px; padding: 0 14px; border: 0; background: transparent; font: inherit; color: inherit; text-align: left; }
  .dpanel :global(.ln > .code) { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .dpanel :global(button.ln) { cursor: pointer; }
  .dpanel :global(button.ln:hover) { background: var(--color-surface-stage); }
  .dpanel :global(button.ln:focus-visible) { outline: 2px solid var(--color-annotation-measure); outline-offset: -2px; }
  .dpanel :global(button.ln:disabled) { cursor: default; opacity: 0.4; }
  .dpanel :global(button.ln:disabled:hover) { background: transparent; }
  .dpanel :global(.p), .dpanel :global(.num), .dpanel :global(.out) { color: var(--color-text-muted); }
  .dpanel :global(.s) { color: var(--color-status-positive); }
  .dpanel :global(.nw) { white-space: nowrap; }
  .dpanel :global(.f) { color: var(--color-text-secondary); }
  .dpanel :global(button.ln[aria-checked='true']) { background: var(--color-annotation-measure-soft); }
  .dpanel :global(button.ln[aria-checked='true'] .f), .dpanel :global(button.ln[aria-checked='true'] .num) { color: var(--color-annotation-measure); }
  .dpanel :global(mark) { background: var(--color-annotation-measure-soft); color: inherit; border-radius: var(--radius-tag); }
  /* The prompt: a real input. The block caret blinks while it is empty and not in use; typing shows the normal caret. */
  .prompt { display: flex; align-items: center; padding: 4px 14px 2px; cursor: text; }
  .prompt input { flex: 1 1 0; min-width: 0; padding: 0; border: 0; outline: 0; background: transparent; font: inherit; color: var(--color-text-primary); caret-color: var(--color-annotation-measure); }
  .prompt input::placeholder { color: var(--color-text-muted); opacity: 0; }
  .prompt:focus-within input::placeholder { opacity: 1; }
  .prompt:focus-within { box-shadow: inset 2px 0 0 var(--color-annotation-measure); }
  .caret { order: -1; display: inline-block; width: 7px; height: 14px; margin-right: -7px; background: var(--color-text-primary); animation: blink 1.1s steps(1) infinite; pointer-events: none; }
  .prompt:focus-within .caret, .prompt:has(input:not(:placeholder-shown)) .caret { visibility: hidden; }
  .prompt .p { order: -2; white-space: pre; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  @media (max-width: 1040px) {
    .layout { grid-template-columns: minmax(0, 1fr); } .side { position: static; max-height: none; } .panel { max-width: 420px; }
    /* The panel folds into a button; it opens in place, and "Show N projects" closes it and scrolls to the cards */
    .ftoggle { display: inline-flex; align-self: flex-start; } /* the shared Button (.btn) */
    .ftoggle svg { color: var(--color-text-secondary); transition: transform 0.2s; }
    .ftoggle[aria-expanded='true'] svg { transform: rotate(180deg); }
    .fcount { color: var(--color-text-muted); }
    .side:not([data-open]) > .panel { display: none; }
    .dpanel { max-width: none; }
    .fshow { display: flex; justify-content: center; margin: 8px 10px 4px; } /* the shared Button, Primary */
    /* The comment describes the sticky panel, which only exists on wide screens */
  }
  @media (prefers-reduced-motion: reduce) { .ftoggle svg { transition: none; } }
  @media (max-width: 720px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { GLYPHS } from '../lib/glyphs';
  import { gsap, playOnce, reduceMotion } from '../lib/motion';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);
  type Item = { id: string; type: 'client' | 'experiment'; industry: string[]; focus: string[] };
  const DATA: Item[] = JSON.parse(document.getElementById('work-filter-data')!.textContent || '[]');
  const panel = document.querySelector<HTMLElement>('[data-filter-panel]')!;
  const side = document.querySelector<HTMLElement>('[data-side]')!;
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-filter-toggle]')!;
  const toggleCount = document.querySelector<HTMLElement>('[data-filter-toggle-count]')!;
  const showBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-show]')];
  // Small screens: the toggle opens and closes the panel; "Show N projects" closes it and scrolls to the cards.
  const setPanel = (open: boolean) => { side.toggleAttribute('data-open', open); toggleBtn.setAttribute('aria-expanded', String(open)); };
  toggleBtn.addEventListener('click', () => setPanel(!side.hasAttribute('data-open')));
  showBtns.forEach((b) => b.addEventListener('click', () => { setPanel(false); const pills = document.querySelector<HTMLElement>('[data-filter-active]'); (pills && !pills.hidden ? pills : document.querySelector('[data-grid]'))?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); toggleBtn.focus({ preventScroll: true }); }));
  const groupsEl = panel.querySelector<HTMLElement>('[data-filter-groups]')!;
  const countEl = panel.querySelector<HTMLElement>('[data-filter-count]')!;
  const searchEl = panel.querySelector<HTMLInputElement>('[data-filter-search]')!;
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;
  const activeEl = document.querySelector<HTMLElement>('[data-filter-active]')!;
  const FOCUS_LIMIT = 4;
  const TYPES: [string, string][] = [['all', 'All'], ['client', 'Client work'], ['experiment', 'Experiments']];
  const MASTER = GLYPHS.master, VARIANT = GLYPHS.variant;
  const CHECK = '<svg width="10" height="8" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const CARET = '<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true"><path d="M1.5 2.5L4 5.5L6.5 2.5Z" fill="currentColor"/></svg>';
  const state = { type: 'all', industry: [] as string[], focus: [] as string[], q: '', tab: 'groups', more: false, open: { type: true, industry: true, focus: true } as Record<string, boolean> };
  const slug = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // read URL (?type=experiment&industry=fintech,saas&focus=data)
  const allTags = (k: 'industry' | 'focus') => [...new Set(DATA.flatMap((d) => d[k]))];
  { const u = new URL(location.href); const t = u.searchParams.get('type'); if (t === 'client' || t === 'experiment') state.type = t;
    for (const k of ['industry', 'focus'] as const) { const v = u.searchParams.get(k); if (v) { const want = v.split(','); state[k] = allTags(k).filter((tg) => want.includes(slug(tg))); } } }

  const okType = (d: Item, t = state.type) => t === 'all' || d.type === t;
  const okGroup = (d: Item, k: 'industry' | 'focus', sel = state[k]) => !sel.length || sel.some((s) => d[k].includes(s));
  const visible = () => DATA.filter((d) => okType(d) && okGroup(d, 'industry') && okGroup(d, 'focus'));
  const countFor = (k: string, v: string) => DATA.filter((d) => (k === 'type' ? okType(d, v) : okType(d)) && (k === 'industry' ? d.industry.includes(v) : okGroup(d, 'industry')) && (k === 'focus' ? d.focus.includes(v) : okGroup(d, 'focus'))).length;
  const hl = (label: string) => { const q = state.q.toLowerCase(); const i = q ? label.toLowerCase().indexOf(q) : -1; return i < 0 ? esc(label) : esc(label.slice(0, i)) + '<mark>' + esc(label.slice(i, i + q.length)) + '</mark>' + esc(label.slice(i + q.length)); };
  const row = (key: string, value: string, label: string, icon: string, on: boolean, n: number, multi: boolean) =>
    `<button type="button" class="row" role="${multi ? 'checkbox' : 'radio'}" aria-checked="${on}" data-key="${key}" data-val="${esc(value)}"${n === 0 && !on ? ' disabled' : ''}><span class="ic" aria-hidden="true">${icon}</span><span class="lab">${hl(label)}</span><span class="num">${n}</span><span class="ok">${CHECK}</span></button>`;
  const section = (key: string, label: string, clear: boolean, body: string) =>
    `<div class="sec"><button type="button" class="caret" aria-expanded="${state.open[key]}" aria-label="${state.open[key] ? 'Collapse' : 'Expand'} ${label}" data-toggle="${key}">${CARET}</button><span>${label}</span>${clear ? `<button type="button" class="clr" data-clear="${key}">Clear</button>` : ''}</div>` + (state.open[key] ? `<div role="${key === 'type' ? 'radiogroup' : 'group'}" aria-label="${label}">${body}</div>` : '');
  const tagRows = (k: 'industry' | 'focus') => allTags(k).map((t) => ({ t, n: countFor(k, t), on: state[k].includes(t) })).sort((a, b) => b.n - a.n || a.t.localeCompare(b.t));

  function renderPanel() {
    const q = state.q.toLowerCase(); let html = '';
    if (state.tab === 'groups') {
      if (!q) html += section('type', 'Type', false, TYPES.map(([v, l]) => row('type', v, l, MASTER, state.type === v, countFor('type', v), false)).join(''));
      for (const [k, label] of [['industry', 'Industry'], ['focus', 'Focus']] as const) {
        let list = tagRows(k).filter((o) => !q || o.t.toLowerCase().includes(q)); let hidden = 0;
        if (k === 'focus' && !q && !state.more && list.length > FOCUS_LIMIT) { const head = list.slice(0, FOCUS_LIMIT); list.slice(FOCUS_LIMIT).forEach((o) => { if (o.on) head.push(o); }); hidden = list.length - head.length; list = head; }
        let body = list.map((o) => row(k, o.t, o.t, VARIANT, o.on, o.n, true)).join('') || `<p class="none">No ${label.toLowerCase()} tags match</p>`;
        if (hidden > 0) body += `<button type="button" class="more" data-more="1">${hidden} more</button>`;
        else if (k === 'focus' && !q && state.more) body += `<button type="button" class="more" data-more="0">Show fewer</button>`;
        html += section(k, label, state[k].length > 0, body);
      }
    } else {
      const flat = (['industry', 'focus'] as const).flatMap((k) => tagRows(k).map((o) => ({ ...o, k }))).filter((o) => !q || o.t.toLowerCase().includes(q)).sort((a, b) => a.t.localeCompare(b.t));
      html = `<div role="group" aria-label="All tags" style="padding-top:6px">${flat.map((o) => row(o.k, o.t, o.t, VARIANT, o.on, o.n, true)).join('') || '<p class="none">No tags match</p>'}</div>`;
    }
    const focusId = (document.activeElement as HTMLElement | null)?.closest('.row') ? `${(document.activeElement as HTMLElement).dataset.key}|${(document.activeElement as HTMLElement).dataset.val}` : '';
    groupsEl.innerHTML = html;
    if (focusId) { const [k, v] = focusId.split('|'); groupsEl.querySelector<HTMLElement>(`.row[data-key="${k}"][data-val="${CSS.escape(v)}"]`)?.focus(); }
    panel.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === state.tab)));
  }

  function renderActive() {
    const pills: string[] = [];
    if (state.type !== 'all') pills.push(`<button type="button" class="pill ui-tag ui-tag-selected" data-pill="type">Type <i>is</i> ${state.type === 'client' ? 'Client work' : 'Experiments'} ×</button>`);
    for (const [k, label] of [['industry', 'Industry'], ['focus', 'Focus']] as const) if (state[k].length) pills.push(`<button type="button" class="pill ui-tag ui-tag-selected" data-pill="${k}">${label} <i>is</i> ${state[k].map(esc).join(' <i>or</i> ')} ×</button>`);
    activeEl.hidden = !pills.length;
    activeEl.innerHTML = pills.join('') + (pills.length > 1 ? '<button type="button" class="clear-all-inline" data-clear-all>Clear all</button>' : '');
  }

  // Filtering (motion plan, moment 04): cards that stay slide to their new place with GSAP Flip, the others fade out.
  // Hidden cards stay in the page (the hidden attribute), so Flip can animate them out and back in.
  const cardEls = [...grid.querySelectorAll<HTMLElement>('.card')];
  // Entry (motion plan, moment 04): each card rises in when it comes into view; the right column follows the left.
  // The first filter change ends this for good, so a card can never be left invisible by a filter.
  let entryDone = false;
  cardEls.forEach((el) => {
    const col = () => (el.offsetLeft > grid.clientWidth / 3 ? 1 : 0);
    playOnce(el, () => gsap.set(el, { autoAlpha: 0, y: 28 }), () => { if (!entryDone) gsap.to(el, { autoAlpha: 1, y: 0, duration: 0.7, delay: col() * 0.12, ease: 'power3.out', clearProps: 'transform' }); }, 0.15);
  });
  const endEntry = () => { if (entryDone) return; entryDone = true; gsap.killTweensOf(cardEls); gsap.set(cardEls, { clearProps: 'opacity,visibility,transform' }); };

  // While cards slide, the grid keeps its height and then eases to the new one, so the page below does not jump.
  let flip: gsap.core.Timeline | null = null;
  let initialised = false; // the first render (filters from the URL) does not animate
  function renderGrid() {
    const vis = new Set(visible().map((d) => d.id));
    if (reduceMotion() || !initialised) { cardEls.forEach((el) => { el.hidden = !vis.has(el.dataset.id!); }); }
    else {
      endEntry();
      const before = Flip.getState(cardEls);
      flip?.kill(); gsap.killTweensOf(grid);
      const from = grid.offsetHeight;
      grid.style.height = '';
      cardEls.forEach((el) => { el.hidden = !vis.has(el.dataset.id!); });
      const to = grid.offsetHeight;
      flip = Flip.from(before, {
        duration: 0.55, ease: 'power3.inOut', absolute: true,
        onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, scale: 0.96 }, { autoAlpha: 1, scale: 1, duration: 0.35, delay: 0.2, ease: 'power2.out' }),
        onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.96, duration: 0.2, ease: 'power2.in' }),
      });
      gsap.fromTo(grid, { height: from }, { height: to, duration: 0.55, ease: 'power3.inOut', clearProps: 'height' });
    }
    empty.hidden = vis.size > 0; countEl.textContent = `${vis.size} / ${DATA.length}`;
    toggleCount.textContent = countEl.textContent; showBtns.forEach((b) => { b.textContent = vis.size === 1 ? 'Show 1 project' : `Show ${vis.size} projects`; });
    document.dispatchEvent(new CustomEvent('work:filtered'));
  }

  function syncUrl() {
    const u = new URL(location.href);
    if (state.type !== 'all') u.searchParams.set('type', state.type); else u.searchParams.delete('type');
    for (const k of ['industry', 'focus'] as const) { if (state[k].length) u.searchParams.set(k, state[k].map(slug).join(',')); else u.searchParams.delete(k); }
    history.replaceState(null, '', u);
  }
  // Engineer view: the same state, drawn as a terminal command. The prompt finds a tag (state.q, shared with "Find a tag").
  const dev = document.querySelector<HTMLElement>('[data-dev-panel]')!;
  const devBody = dev.querySelector<HTMLElement>('[data-dev-body]')!;
  const devCount = dev.querySelector<HTMLElement>('[data-dev-count]')!;
  const devSearch = dev.querySelector<HTMLInputElement>('[data-dev-search]')!;
  const sp = (cls: string, t: string) => `<span class="${cls}">${esc(t)}</span>`;
  const plain = (html: string) => `<div class="ln"><span class="code">${html}</span></div>`;
  const val = (key: string, v: string, label: string, on: boolean, n: number, multi: boolean, off = false) =>
    `<button type="button" class="ln" role="${multi ? 'checkbox' : 'radio'}" aria-checked="${on}" aria-label="${esc(v)}, ${n} projects" data-key="${key}" data-val="${esc(v)}"${off ? ' disabled' : ''}><span class="code"><span class="f">  ${label}</span></span><span class="num">${n}</span></button>`;
  function renderDev() {
    const n = visible().length; const q = state.q.toLowerCase(); let h = '';
    const flags = [`--type=${state.type}`, ...(['industry', 'focus'] as const).filter((k) => state[k].length).map((k) => `--${k}=${state[k].map(slug).join(',')}`)];
    h += `<div class="ln"><span class="code" style="white-space: pre-wrap">${sp('p', '$ ')}ls work ${flags.map((f) => sp('s nw', f)).join(' ')}</span></div>`;
    h += plain(sp('out', `${n} ${n === 1 ? 'project' : 'projects'}`));
    h += plain('');
    if (!q) { h += plain('--type'); for (const [v] of TYPES) h += val('type', v, v, state.type === v, countFor('type', v), false); }
    let found = 0;
    for (const k of ['industry', 'focus'] as const) {
      const rows = tagRows(k).filter((o) => !q || o.t.toLowerCase().includes(q)); found += rows.length;
      if (!rows.length) continue;
      h += plain(`--${k}`);
      for (const o of rows) h += val(k, o.t, hl(slug(o.t)), o.on, o.n, true, o.n === 0 && !o.on);
    }
    if (q && !found) h += plain(sp('out', `zsh: no tag matches "${state.q}"`));
    h += plain('');
    const focused = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('button.ln');
    const fid = focused ? `${focused.dataset.key}|${focused.dataset.val}` : '';
    devBody.innerHTML = h;
    if (fid) { const [k, v] = fid.split('|'); devBody.querySelector<HTMLElement>(`button.ln[data-key="${k}"][data-val="${CSS.escape(v)}"]`)?.focus(); }
    devCount.textContent = `${n} / ${DATA.length}`;
  }
  dev.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.ln'); if (!b || b.disabled) return;
    const k = b.dataset.key!, v = b.dataset.val!;
    if (k === 'type') state.type = v; else toggle(k as 'industry' | 'focus', v);
    render();
  });
  devSearch.addEventListener('input', () => { state.q = devSearch.value.trim(); searchEl.value = devSearch.value; renderPanel(); renderDev(); });
  devSearch.addEventListener('keydown', (e) => { if (e.key === 'Escape') { devSearch.value = ''; devSearch.dispatchEvent(new Event('input')); } });
  const render = (grid = true) => { renderPanel(); renderActive(); renderDev(); if (grid) { renderGrid(); syncUrl(); } };
  const toggle = (k: 'industry' | 'focus', v: string) => { const s = state[k]; const i = s.indexOf(v); if (i > -1) s.splice(i, 1); else s.push(v); };
  const clearAll = () => { state.type = 'all'; state.industry = []; state.focus = []; };

  panel.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const r = t.closest<HTMLButtonElement>('.row'); if (r && !r.disabled) { const k = r.dataset.key!; if (k === 'type') state.type = r.dataset.val!; else toggle(k as 'industry' | 'focus', r.dataset.val!); return render(); }
    const tab = t.closest<HTMLElement>('[data-tab]'); if (tab) { state.tab = tab.dataset.tab!; return render(false); }
    const tg = t.closest<HTMLElement>('[data-toggle]'); if (tg) { state.open[tg.dataset.toggle!] = !state.open[tg.dataset.toggle!]; return render(false); }
    const cl = t.closest<HTMLElement>('[data-clear]'); if (cl) { (state as any)[cl.dataset.clear!] = []; return render(); }
    const m = t.closest<HTMLElement>('[data-more]'); if (m) { state.more = m.dataset.more === '1'; return render(false); }
  });
  searchEl.addEventListener('input', () => { state.q = searchEl.value.trim(); renderPanel(); renderDev(); });
  const onPill = (e: Event) => { const t = e.target as HTMLElement; const p = t.closest<HTMLElement>('[data-pill]'); if (p) { if (p.dataset.pill === 'type') state.type = 'all'; else (state as any)[p.dataset.pill!] = []; return render(); } if (t.closest('[data-clear-all]')) { clearAll(); render(); } };
  activeEl.addEventListener('click', onPill); empty.addEventListener('click', onPill);
  render();
  initialised = true;
</script>
