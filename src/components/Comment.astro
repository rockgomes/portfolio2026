---
// Figma: Comment (44:575). Not shown in the engineer view. `when` is optional (the hero story's messages have none).
interface Props { who: string; initial: string; when?: string; color?: 'client' | 'pm' | 'dev' | 'rock'; style?: string; class?: string; [attr: `data-${string}`]: string | number }
const { who, initial, when, color = 'client', style, class: cls, ...data } = Astro.props;
---
<div class:list={['cm', 'ui-comment-card', 'ui-comment-float', `c-${color}`, cls]} style={style} data-overlay aria-hidden="true" {...data}>
  <span class="ui-avatar t-mono-label">{initial}</span>
  <div class="body">
    <p class="meta"><span class="who">{who}</span>{when && <span class="when t-mono-label">{when}</span>}</p>
    <p class="txt t-body-small"><slot /></p>
  </div>
</div>
<style>
  /* Card, avatar and colours are shared (base.css: .ui-comment-card, .ui-avatar, .c-*) */
  .cm { position: absolute; z-index: 6; display: flex; gap: 10px; align-items: flex-start; }
  .body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1 0 0; }
  .meta { margin: 0; display: flex; gap: var(--space-8); align-items: baseline; white-space: nowrap; }
  .who { font: var(--type-ui-button); color: var(--color-text-primary); }
  .when { color: var(--color-text-muted); }
  .txt { margin: 0; color: var(--color-text-secondary); }
  :global(html[data-view='engineer']) .cm { display: none; }
</style>
