---
// Figma: Experience (96:6929), Timeline item 21:111
import SectionHeader from './SectionHeader.astro';
import IconGitBranch from './IconGitBranch.astro';
import Tabs from './Tabs.astro';
// Independent work (from 2025) is one entry with a tab per client. Facts from Rock's CV (Oct 2026).
type Client = { id: string; name: string; about: string; text: string }; // about: one line on the business (no dates: projects run about 6 months)
type Item = { years: string; company: string; role: string; text?: string; clients?: Client[] };
const items: Item[] = [
  { years: '2025 - now', company: 'Independent', role: 'Senior Product Designer · contract', clients: [
    { id: 'well', name: 'Well', about: "Bestway Group · the UK's second-largest pharmacy chain, ~700 branches, 360+ care homes", text: 'I worked across the whole back-office, from onboarding new care homes to the care home structure, the medication cycles and all the other views staff use every day. I also helped on Direct to Patient, its public version. I rebuilt the design system and helped the front-end team implement it.' },
    { id: 'dealfront', name: 'Dealfront', about: 'B2B sales intelligence SaaS, used by 15,000+ companies · now called Leadfeeder', text: 'I worked on AI features, lists and data management, and user management. I took each one end to end, from testing ideas with sales teams to handoff to the developers, using AI for ideation and testing. I also designed the permissions and SSO the product needed for enterprise clients.' },
    { id: 'romeo', name: 'Romeo', about: 'Dating app with 3M+ users, online since 2001 · Amsterdam and Berlin', text: 'I work across the whole app. Right now I\'m focused on redesigning the web version and growing the design system I manage. We use Claude a lot in our workflow, so I build the system to be easy for AI agents to read, too.' },
  ] },
  { years: '2023 - 2024', company: 'Inbank', role: 'Senior Product Designer', text: 'I was Inbank\'s first in-house designer, so I owned design across the whole product: the hire-purchase flows in 4 countries, the customer service back-office, and a design system built from scratch. Today every market, online banking, partner channels and the back-office use it.' },
  { years: '2020 - 2022', company: 'Pipedrive', role: 'Senior Product Designer', text: 'I owned design for Integrations and Developer Experience. That means the app marketplace and the tools developers use to build apps for it. I set the patterns for how apps show and behave inside Pipedrive. I worked closely with PMs and developers, and with the business side on the roadmap, resources and goals.' },
  { years: '2016 - 2020', company: 'Bigbank', role: 'Product Designer', text: 'In four years at Bigbank, I worked on both sides of lending: the loan application customers fill in, in 5 countries, and the back-office tools behind it. I also built the bank\'s first design system, with a coded component library.' },
];
---
<section class="exp" id="experience" aria-labelledby="exp-title" data-recruiter-also>
  <div class="wrap inner section-top">
    <SectionHeader anchor title="Experience" titleId="exp-title" subtitle={`2016 → ${new Date().getFullYear()}`} dimension={`timeline.span = ${new Date().getFullYear() - 2016} yrs · roles = ${items.length}`} command="git log --graph --since=2016" />
    <ol class="timeline" data-timeline>
      {items.map((it, i) => (
        <li class="item">
          <span class="marker" aria-hidden="true"><i></i></span>
          <div class="years t-mono-small"><span>{it.years}</span></div>
          <div class="body">
            <div class="corow">
              <h3 class="co t-heading-item">{it.company}</h3>
              {i === 0 && <span class="ref t-mono-label" data-engineer>HEAD -&gt; main</span>}
            </div>
            <p class="role t-body-small">{it.role}</p>
            {it.text && <p class="text">{it.text}</p>}
            {it.clients && (
              <div class="clients" data-clients>
                <Tabs label="Clients" id="client" tabs={it.clients.map((c) => c.name)} keys={it.clients.map((c) => c.id)}>
                  {(name: string) => <><IconGitBranch data-engineer /><span data-not-engineer>{name}</span><span data-engineer>{name.toLowerCase()}</span></>}
                </Tabs>
                {it.clients.map((c, i) => (
                  <div class="cpanel" role="tabpanel" id={`client-panel-${c.id}`} aria-labelledby={`client-tab-${c.id}`} hidden={i !== 0}>
                    <p class="cmeta t-mono-small">{c.about}</p>
                    <p class="text">{c.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .inner { display: flex; flex-direction: column; gap: var(--space-48); }
  /* The line is a pseudo-element (not a border), so it can draw itself as you scroll (--draw, Motion.astro). Same place as the old 1px border. */
  .timeline { position: relative; list-style: none; margin: 0; padding: 0 0 0 5px; }
  .timeline::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--color-annotation-measure); transform-origin: 50% 0%; transform: scaleY(var(--draw, 1)); }
  .item { display: flex; align-items: flex-start; padding-block: var(--space-32); border-bottom: 1px solid var(--color-border-subtle); }
  .marker { position: relative; width: 32px; height: 16px; flex: none; }
  /* 7px square (border included) centred on the 1px line at the timeline's left edge; the marker box starts 5px in */
  .marker i { position: absolute; left: -8px; top: 5px; width: 7px; height: 7px; background: var(--color-surface-page); border: 1px solid var(--color-annotation-measure); }
  .years { width: 184px; flex: none; display: flex; flex-direction: column; gap: var(--space-4); color: var(--color-text-secondary); white-space: nowrap; }
  .body { width: min(540px, 100%); display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .co { margin: 0; color: var(--color-text-primary); }
  .role { margin: 0; color: var(--color-text-secondary); }
  .text { margin: 0; font: var(--type-body-default); color: var(--color-text-secondary); }
  /* Independent: one tab per client (same tab style as the hero table) */
  .clients { display: flex; flex-direction: column; gap: var(--space-12); padding-top: 6px; }
  .cpanel { display: flex; flex-direction: column; gap: 6px; }
  .cmeta { margin: 0; color: var(--color-text-muted); }
  .corow { display: flex; align-items: center; gap: var(--space-12); flex-wrap: wrap; }
  /* Recruiter view (Figma: Timeline item, View=Recruiter): a round 9px dot centred on the 1px line; the current role
     fills its dot. */
  :global(html[data-view='recruiter']) .marker i { left: -9px; top: 4px; width: 9px; height: 9px; border: 1.5px solid var(--color-annotation-measure); border-radius: 50%; }
  :global(html[data-view='recruiter']) .item:first-child .marker i { background: var(--color-annotation-measure); }
  /* Engineer view (Figma: Experience A - git log graph): the timeline becomes a git log graph. One green branch line
     from the current role down, round commits (filled = HEAD), client tabs as branches with the Lucide git-branch icon. */
  :global(html[data-view='engineer']) .timeline::before { width: 2px; top: calc(var(--space-32) + 8px); }
  :global(html[data-view='engineer']) .marker i { left: -9.5px; top: 3px; width: 11px; height: 11px; border: 2px solid var(--color-annotation-measure); border-radius: 50%; }
  :global(html[data-view='engineer']) .item:first-child .marker i { background: var(--color-annotation-measure); }
  .ref { padding: 2px 8px; border-radius: 999px; background: var(--color-annotation-measure-soft); color: var(--color-annotation-measure); white-space: nowrap; }
  :global(html[data-view='engineer']) .clients :global(.ui-tab) { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px 5px 8px; border-radius: 6px; font: var(--type-mono-label); color: var(--color-text-secondary); }
  :global(html[data-view='engineer']) .clients :global(.ui-tab .gb) { color: var(--color-text-muted); flex: none; }
  :global(html[data-view='engineer']) .clients :global(.ui-tab[aria-selected='true']) { background: var(--color-annotation-measure-soft); border-color: var(--color-annotation-measure); color: var(--color-annotation-measure); font-weight: 400; }
  :global(html[data-view='engineer']) .clients :global(.ui-tab[aria-selected='true'] .gb) { color: var(--color-annotation-measure); }
  @media (max-width: 720px) { .item { flex-wrap: wrap; row-gap: 10px; } .years { width: auto; flex-direction: row; gap: var(--space-12); } .body { flex: 1 1 100%; padding-left: var(--space-32); } }
</style>

<script>
  import { bindChoice } from '../lib/choice';

  // Client tabs: click or arrow keys switch the panel; the new panel fades in and the height eases.
  document.querySelectorAll<HTMLElement>('[data-clients]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    bindChoice({ options: tabs, panels: tabs.map((t) => box.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)), box });
  });
</script>

