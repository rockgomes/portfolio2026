---
// Figma: Header (96:6775) with the audience switch (96:7322).
import CopyEmail from './CopyEmail.astro';
import Segmented from './Segmented.astro';
import SbDropdown from './SbDropdown.astro';
interface Props { showSwitch?: boolean }
const { showSwitch = true } = Astro.props;
const views = [['design', 'Designer'], ['recruiter', 'Recruiter'], ['engineer', 'Engineer']];
const viewOptions = views.map(([v, label]) => ({ label, attrs: { 'data-view-option': v } }));
// Projects: client work and experiments in one list. The recruiter view has no Projects section, so no Projects link.
// `in`: the views that show the link.
const links = [
  { href: '/#work', label: 'Projects', in: 'others' },
  { href: '/#experience', label: 'Experience', in: 'all' },
  { href: '/#about', label: 'About', in: 'all' },
];
---
<header class="hdr">
  <div class="wrap inner">
    <a class="brand" href="/"><span class="name">Rock Gomes</span></a>
    {showSwitch && (
      <div class="switch" data-switch>
        <span class="lab">View as</span>
        <Segmented label="View as" options={viewOptions} />
        <!-- Less room (Figma 500:10264): the same choice as a dropdown -->
        <div class="vdd" data-view-dd><SbDropdown name="view" label="View as" options={views.map(([, l]) => l)} value={views[0][1]} /></div>
      </div>
    )}
    <div class="end">
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} data-in={l.in}>{l.label}</a>)}
      <CopyEmail variant="short" /> <!-- short: the full address is in the footer -->
      <a class="cv-btn btn btn-primary" href="/Rock_Gomes_CV.pdf" download>Download CV (PDF)</a> <!-- recruiter view only (Figma 94:6774) -->
    </nav>
    <div class="menu-wrap">
      <button type="button" class="menu-btn btn" aria-expanded="false" aria-controls="site-menu" data-menu-btn>Menu <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2.5 4l2.5 2.5L7.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></button>
      <!-- Below 1040px the nav links move into this panel, right under the button (same style as the filter panel) -->
      <nav class="mpanel" id="site-menu" aria-label="Main" data-menu hidden>
        {links.map((l) => <a href={l.href} data-in={l.in} data-menu-link>{l.label}</a>)}
        <!-- Smallest screens (Figma 504:10288): the switch moves here, full width -->
        {showSwitch && <div class="mview"><span class="lab">View as</span><Segmented label="View as" options={viewOptions} /></div>}
        <div class="mcopy"><span class="t-mono-label lab2">rock@rockgomes.com</span><CopyEmail variant="short" /></div>
      </nav>
    </div>
    </div>
  </div>
  <div class="mbackdrop" data-menu-backdrop hidden></div>
</header>
<style>
  /* Sticky: stays at the top while the page scrolls (above the overlays, which go up to z-index 12) */
  .hdr { position: sticky; top: 0; z-index: 40; background: var(--color-surface-page); border-bottom: 1px solid var(--color-border-strong); }
  /* Three columns with equal sides, so the switch sits in the middle in every view, whatever the nav holds */
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-24); padding-block: var(--space-16); min-height: 67px; }
  .brand { justify-self: start; display: flex; gap: var(--space-8); align-items: center; text-decoration: none; white-space: nowrap; min-width: 0; }
  .end { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: var(--space-24); }
  .name { font: var(--type-ui-brand); color: var(--color-text-primary); }
  .switch { grid-column: 2; display: flex; align-items: center; gap: 10px; }
  .lab { font: 400 11.5px/1 var(--font-mono); color: var(--color-text-muted); white-space: nowrap; }
  .vdd, .mview { display: none; } /* the switch on smaller screens: see the media queries at the end */
  /* The chosen option shows its own view's colour (tokens color/view/*), so it changes on the click, not after the
     page has switched. It also stays out of the colour fade of the switch (base.css, .view-fading). */
  .hdr :global([data-view-option='design'][aria-checked='true']) { background: var(--color-view-design-soft); color: var(--color-view-design); }
  .hdr :global([data-view-option='recruiter'][aria-checked='true']) { background: var(--color-view-recruiter-soft); color: var(--color-view-recruiter); }
  .hdr :global([data-view-option='engineer'][aria-checked='true']) { background: var(--color-view-engineer-soft); color: var(--color-view-engineer); }
  :global(html.view-fading) .hdr :global([data-view-option]) { transition: none !important; }
  .nav { display: flex; align-items: center; gap: var(--space-24); white-space: nowrap; }
  .nav a:not(.btn) { font: var(--type-ui-nav); color: var(--color-text-secondary); text-decoration: none; }
  .nav a:not(.btn):hover { color: var(--color-text-primary); }
  .menu-btn { display: none; } /* the shared Button (.btn), shown below 1040px */
  .menu-btn svg { color: var(--color-text-secondary); transition: transform 0.2s; }
  .menu-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .menu-wrap { position: relative; display: none; }
  .mpanel { position: absolute; top: calc(100% + 8px); right: 0; z-index: 2; width: 300px; display: flex; flex-direction: column; padding: 6px; background: var(--color-surface-page); border: 1px solid var(--color-border-strong); border-radius: 10px; box-shadow: var(--shadow-panel); }
  /* The page dims behind the open menu. It lives inside the header's layer (z-index 40), at -1: under the header
     and the menu, above the page. A tap on it closes the menu. */
  .mbackdrop { position: fixed; inset: 0; z-index: -1; background: color-mix(in srgb, var(--color-text-primary) 28%, transparent); }
  .mpanel a { display: flex; align-items: baseline; gap: var(--space-12); padding: 10px 12px; border-radius: 6px; font: var(--type-ui-nav); color: var(--color-text-primary); text-decoration: none; }
  .mpanel a:hover, .mpanel a:focus-visible { background: var(--color-annotation-measure-soft); }
  .mcopy { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); margin-top: 6px; padding: 10px 12px 6px; border-top: 1px solid var(--color-border-subtle); }
  .lab2 { color: var(--color-text-secondary); }
  @media (min-width: 1041px) { :global(html:not([data-view='recruiter'])) .mpanel, :global(html:not([data-view='recruiter'])) .mbackdrop { display: none !important; } }
  @media (min-width: 1280px) { .mpanel, .mbackdrop { display: none !important; } }
  .nav .cv-btn { display: none; margin-left: -16px; } /* Figma: 8px from copy email (nav gap is 24px) */
  @media (min-width: 1041px) { :global(html[data-view='recruiter']) .nav .cv-btn { display: inline-flex; } } /* phones: the contact card has it */
  /* Links for some views only (see `links`) */
  :global(html[data-view='recruiter']) [data-in='others'] { display: none !important; }
  /* The recruiter header also has the CV button, so its links and copy email need more room: from 1041px to 1279px
     they go into the Menu, as on smaller screens, and the CV button stays */
  @media (min-width: 1041px) and (max-width: 1279px) {
    :global(html[data-view='recruiter']) .nav a:not(.cv-btn), :global(html[data-view='recruiter']) .nav :global(.copy) { display: none; }
    :global(html[data-view='recruiter']) .menu-wrap { display: block; }
    :global(html[data-view='recruiter']) .menu-btn { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .menu-btn svg { transition: none; } }
  @media (max-width: 1040px) { .nav a { display: none; } .menu-wrap { display: block; } .menu-btn { display: inline-flex; } }
  @media (max-width: 720px) {
    /* Phones: one row. The switch sits next to the Menu button instead of in the middle. */
    .nav { display: none; } .inner { grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--space-12); }
    .end { grid-column: 3; }
    /* The panel spans the content width (gutter to gutter), with bigger tap targets */
    .mpanel { width: calc(100vw - 2 * max(var(--gutter), env(safe-area-inset-left, 0px))); }
    .mpanel a { padding: 14px 12px; font: var(--type-ui-nav-large); }
  }
  /* The view switch gets smaller step by step as the room runs out:
     less room, a "View as" dropdown (Figma 500:10264); smallest screens, in the menu after the links (Figma 504:10288) */
  @media (max-width: 520px) { .switch > :global(.ui-seg) { display: none; } .vdd { display: block; } }
  @media (max-width: 380px) {
    .switch { display: none; }
    .mview { display: flex; flex-direction: column; gap: var(--space-8); margin-top: 6px; padding: 12px 12px 14px; border-top: 1px solid var(--color-border-subtle); }
    .mview :global(.ui-seg) { display: flex; }
    .mview :global(.ui-seg button) { flex: 1; }
  }
  /* Just above the two breakpoints the centred switch comes close to the buttons on the right: "View as" makes way */
  @media (min-width: 721px) and (max-width: 820px), (min-width: 1041px) and (max-width: 1100px) { .lab { display: none; } }
</style>
<script>
  import { switchView } from '../lib/view-switch';
  import { bindChoice, mark } from '../lib/choice';
  import { bindDropdowns, setDropdownValue } from '../lib/dropdown';

  // View switch: sets <html data-view> (with the switch motion, src/lib/view-switch.ts), keeps it in the URL (?view=)
  // and in localStorage. The switch itself shows the new choice at once.
  const VIEWS = ['design', 'recruiter', 'engineer'];
  // The same choice in three places, one shown at a time: the header radio group, the dropdown (less room) and the
  // radio group in the menu (smallest screens). All three always show the current view.
  const groups = [...document.querySelectorAll<HTMLElement>('.hdr .ui-seg')].map((g) => [...g.querySelectorAll<HTMLButtonElement>('[data-view-option]')]);
  const dd = document.querySelector<HTMLElement>('[data-view-dd] [data-sb-dd]');
  const label = (v: string) => groups[0].find((b) => b.dataset.viewOption === v)!.textContent!;
  const apply = (v: string, push: boolean) => {
    if (!VIEWS.includes(v)) v = 'design';
    groups.forEach((g) => mark(g, g.findIndex((b) => b.dataset.viewOption === v)));
    if (dd) setDropdownValue(dd, label(v));
    try { localStorage.setItem('rg-view', v); } catch {}
    if (push) {
      const u = new URL(location.href);
      if (v === 'design') u.searchParams.delete('view'); else u.searchParams.set('view', v);
      history.replaceState(null, '', u);
    }
    switchView(v, push);
  };
  // Only pages with the switch (the homepage) take the chosen view. Case study pages are the same for every visitor,
  // so a view chosen on the homepage does not follow the visitor there (it stays stored for the way back).
  if (groups.length) {
    const fromUrl = new URL(location.href).searchParams.get('view');
    let stored: string | null = null; try { stored = localStorage.getItem('rg-view'); } catch {}
    apply(fromUrl || stored || 'design', false);
    groups.forEach((g) => bindChoice({ options: g, onSelect: (i) => apply(g[i].dataset.viewOption!, true) }));
  }
  if (dd) bindDropdowns([dd], (_, l) => apply(groups[0].find((b) => b.textContent === l)!.dataset.viewOption!, true), true);

  // Mobile menu (below 1040px): a panel under the Menu button over a dimmed page. A link, Escape, or a tap on the
  // backdrop closes it. On the smallest screens it also holds the view switch.
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  if (menuBtn && menu && backdrop) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setMenu = (open: boolean, focus = false) => {
      menu.hidden = !open; backdrop.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open));
      if (open && !reduce) {
        menu.animate([{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'none' }], { duration: 200, easing: 'cubic-bezier(.2,.8,.2,1)' });
        backdrop.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
      }
      if (open && focus) [...menu.querySelectorAll<HTMLElement>('[data-menu-link]')].find((a) => a.getClientRects().length)?.focus(); // the first link this view shows
    };
    menuBtn.addEventListener('click', () => setMenu(menu.hidden !== false, true));
    // A link or a view picked in the menu (smallest screens) closes it, so the visitor sees the page change
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-menu-link], [data-view-option]')) setMenu(false); });
    backdrop.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
    addEventListener('resize', () => { if (!menuBtn.getClientRects().length && !menu.hidden) setMenu(false); }); // the Menu button is gone at this width
  }
</script>
