---
// Figma: View - Recruiter (94:6774). The one-page summary shown when the header switch is on "Recruiter"
// (?view=recruiter). Facts follow Rock's CV (Oct 2026): "10+ years", Well listed by name.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import CopyEmail from './CopyEmail.astro';

const pills = ['Contract or full-time', 'Remote first', 'Tallinn, Estonia (UTC+2)'];
const facts = [
  ['experience', '10+ years'],
  ['companies', 'Well (Bestway Group), Dealfront, Inbank, Pipedrive, Bigbank'],
  ['strong at', 'Back-office systems, data-heavy SaaS, design systems, prototyping'],
  ['tools', 'Figma, design tokens, CSS, GSAP, Next.js, AI assistants'],
  ['languages', 'English, Portuguese'],
];
// Short lines from Figma; title, company, year and image come from each project's content file.
const picks: [string, string][] = [
  ['dealfront-ai-company-profile', 'An AI layer that answers sales questions. Shipped in two weeks.'],
  ['dealfront-dynamic-lists', 'Saved filter and column views on one list.'],
  ['inbank---customer-service-backoffice', 'Rebuilt the internal support tool from scratch.'],
  ['inbank---hire-purchase', 'Checkout redesign across 4 countries. Fewer support tickets.'],
  ['pipedrive---app-management', 'Pipedrive marketplace apps, managed in one place.'],
];
const projects = await getCollection('projects');
const experiments = await getCollection('experiments');
const total = projects.length + experiments.length;
const row = (e: (typeof projects)[number] | (typeof experiments)[number], line: string) => ({
  href: e.collection === 'projects' ? `/project/${e.id}` : `/experiments/${e.id}`,
  image: e.collection === 'projects' ? e.data.homeImage : e.data.cardImage,
  title: e.data.cardTitle, line, meta: [e.data.cardCompany, e.data.cardYear].filter(Boolean).join(' · '),
});
const work = picks.flatMap(([id, line]) => projects.filter((p) => p.id === id).map((e) => row(e, line)));
// The rest follow the picks, in homepage card order, with each card's own line.
const rest = [...projects, ...experiments].filter((e) => !picks.some(([id]) => id === e.id))
  .sort((a, b) => a.data.cardOrder - b.data.cardOrder).map((e) => row(e, e.data.cardLine));
---
<section class="rec" data-recruiter aria-labelledby="rec-title">
  <div class="wrap grid">
    <div class="main">
      <p class="eyebrow">The short version</p>
      <h1 id="rec-title" class="title">Senior Product Designer.<br />Complex B2B tools, design systems.</h1>
      <ul class="pills">
        <li class="ui-pill ui-pill-positive"><i aria-hidden="true"></i>Open to work</li>
        {pills.map((p) => <li class="ui-pill">{p}</li>)}
      </ul>
      <p class="lede">Ten years designing software people use all day at work: loan back-offices, support tools, data-heavy CRM lists and checkouts across four countries. I also build working prototypes, so teams can test the real thing before anyone writes a ticket.</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>

    <aside class="side" aria-labelledby="rec-work">
      <div class="side-h">
        <h2 id="rec-work">Projects</h2>
        <span class="count">{total} projects</span>
      </div>
      <ul class="work" id="rec-list">
        {[...work, ...rest].map((w) => (
          <li>
            <a class="item" href={w.href}>
              <span class="thumb">{w.image && <Image src={w.image} alt="" widths={[88, 176]} sizes="88px" />}</span>
              <span class="txt">
                <span class="t">{w.title}</span>
                <span class="l">{w.line}</span>
                <span class="m">{w.meta}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="contact">
        <p class="mail">rock@rockgomes.com <CopyEmail variant="short" /></p>
        <p class="note">Email is the fastest way. I reply within a day.</p>
        <a class="li" href="https://www.linkedin.com/in/rockgomes" target="_blank" rel="noopener">linkedin.com/in/rockgomes</a>
        <a class="cv btn btn-primary" href="/Rock_Gomes_CV.pdf" download>Download CV (PDF)</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .rec { padding-block: var(--space-64) 0; } /* the numbers section below brings its own top space */
  .grid { display: grid; grid-template-columns: minmax(0, 768px) minmax(0, 440px); justify-content: space-between; gap: var(--space-80); align-items: start; }
  .main { display: flex; flex-direction: column; min-width: 0; }
  .eyebrow { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-muted); }
  .title { margin: var(--space-12) 0 0; font: 600 44px/1.08 var(--font-sans); letter-spacing: -0.025em; color: var(--color-text-primary); text-wrap: balance; }
  .pills { list-style: none; margin: 0; padding: 14px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .lede { margin: var(--space-24) 0 0; max-width: 640px; font: 400 16px/1.6 var(--font-sans); color: var(--color-text-secondary); }
  .facts { margin: var(--space-32) 0 0; max-width: 680px; border-top: 1px solid var(--color-border-subtle); }
  .facts div { display: grid; grid-template-columns: 150px minmax(0, 1fr); border-bottom: 1px solid var(--color-border-subtle); }
  .facts dt { padding: 14px 0 12px; font: 400 12px/16px var(--font-mono); color: var(--color-text-muted); }
  .facts dd { margin: 0; padding: var(--space-12) 0; font: 400 14px/18px var(--font-sans); color: var(--color-text-primary); }
  .side { display: flex; flex-direction: column; min-width: 0; }
  .side-h { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-12); }
  .side-h h2 { margin: 0; font: 600 13px/17px var(--font-sans); color: var(--color-text-primary); }
  .count { font: 400 13px/17px var(--font-sans); color: var(--color-text-muted); }
  .work { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  /* Two columns: the list scrolls in a box that shows the 5 picks and half of the 6th row, so the cut row and the fade
     show there is more. The fade goes away at the end of the list. One column: all rows, no box. */
  @media (min-width: 1041px) {
    .work { max-height: 454px; overflow-y: auto; scrollbar-width: thin; mask-image: linear-gradient(to bottom, black calc(100% - 56px), transparent); }
    .work[data-end] { mask-image: none; }
    .item:focus-visible { outline-offset: -2px; }
  }
  .item { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 14px; align-items: center; padding: var(--space-8); border-radius: 10px; text-decoration: none; }
  .item:hover, .item:focus-visible { background: var(--color-surface-stage); }
  .thumb { width: 88px; height: 58px; border-radius: 6px; border: 1px solid var(--color-border-subtle); overflow: hidden; background: var(--color-surface-stage); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .t { font: 600 14px/18px var(--font-sans); color: var(--color-text-primary); }
  .l { padding-top: 2px; font: 400 12.5px/17.5px var(--font-sans); color: var(--color-text-secondary); }
  .m { font: 400 11px/14px var(--font-mono); color: var(--color-text-muted); }
  .contact { margin-top: var(--space-32); display: flex; flex-direction: column; gap: 6px; padding: var(--space-16); border: 1px solid var(--color-border-strong); border-radius: 12px; }
  .contact p { margin: 0; }
  .mail { display: flex; align-items: center; justify-content: space-between; gap: var(--space-12); flex-wrap: wrap; font: 700 15px/20px var(--font-sans); color: var(--color-text-primary); }
  .note { font: 400 13px/17px var(--font-sans); color: var(--color-text-secondary); }
  .li { font: 400 12px/16px var(--font-mono); color: var(--color-annotation-measure); text-decoration: none; }
  .li:hover { text-decoration: underline; }
  .cv { align-self: flex-start; margin-top: var(--space-8); }
  @media (max-width: 1040px) { .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-48); } }
  @media (max-width: 560px) { .title { font-size: 34px; } .facts div { grid-template-columns: 110px minmax(0, 1fr); } }
</style>

<script>
  // The fade at the bottom of the work list goes away once the list is scrolled to its end.
  const list = document.getElementById('rec-list');
  const end = () => list?.toggleAttribute('data-end', list.scrollTop + list.clientHeight >= list.scrollHeight - 2);
  list?.addEventListener('scroll', end, { passive: true });
  addEventListener('resize', end);
  // The list has no size while another view shows, so measure again when the view changes (SiteHeader sends viewchange).
  document.documentElement.addEventListener('viewchange', () => requestAnimationFrame(end));
  end();
</script>
