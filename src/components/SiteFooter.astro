---
// Figma: Footer (96:6970). The "You" cursor becomes the visitor's own pointer inside the footer (motion plan, moment 07).
import CopyEmail from './CopyEmail.astro';
import Cursor from './Cursor.astro';
---
<footer class="ftr">
  <div class="wrap">
    <!-- A canvas ruler instead of a plain line: real pixels across the content width (numbers filled in live) -->
    <div class="ruler" aria-hidden="true" data-ruler>
      <i class="ticks minor"></i><i class="ticks major"></i>
      <span class="nums t-mono-label" data-ruler-nums>{Array.from({ length: 17 }, (_, i) => <span style={`left:${i * 80}px`}>{i * 80}</span>)}</span>
    </div>
    <div class="main">
      <div class="cta">
        <p class="headline">Have a complex tool that needs a designer who ships?</p>
        <p class="sub t-mono-small">Email is the fastest way. I reply within a day.</p>
        <div class="email">
          <a href="mailto:rock@rockgomes.com" class="addr">rock@rockgomes.com</a>
          <span class="btn-wrap" data-you-area><CopyEmail variant="short" /><Cursor name="You" color="you" style="left: 66px; top: 23px;" /><span class="copied" data-copied data-overlay aria-hidden="true" hidden><span class="av t-mono-label">Y</span><span class="t-body-small"><b>You</b> Copied</span></span></span>
        </div>
      </div>
      <div class="links">
        <p class="lab t-mono-label">links</p>
        <a href="https://www.linkedin.com/in/rockgomes" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://github.com/rockgomes" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="#top">Back to top ↑</a>
      </div>
    </div>
    <div class="colophon t-mono-label">
      <p>rev 2026.10<span class="gap"></span>Set in IBM Plex Sans and IBM Plex Mono<span class="gap"></span>Built with Astro, hosted on Netlify</p>
      <p>Motion turns off when your device asks for reduced motion<span class="gap"></span>Built by hand, by Rock</p>
    </div>
  </div>
</footer>
<style>
  /* The footer is its own zone (grey, edge to edge), so it is clear where the pointer turns into "You" */
  .ftr { background: var(--color-surface-stage); border-top: 1px solid var(--color-border-strong); }
  .ftr .wrap { display: flex; flex-direction: column; gap: 48px; padding-bottom: 48px; }
  .ftr .wrap > .ruler + .main { margin-top: -48px; }
  /* Ruler hanging from the footer's top border: a small tick every 8px, a bigger tick and a number every 80px */
  .ruler { position: relative; height: 30px; overflow: hidden; }
  .ticks { position: absolute; left: 0; right: 0; top: 0; }
  .ticks.minor { height: 5px; background: repeating-linear-gradient(to right, var(--color-text-muted) 0 1px, transparent 1px 8px); opacity: 0.6; }
  .ticks.major { height: 11px; background: repeating-linear-gradient(to right, var(--color-text-secondary) 0 1px, transparent 1px 80px); }
  .nums { position: absolute; left: 0; right: 0; top: 13px; height: 16px; color: var(--color-text-muted); }
  .nums :global(span) { position: absolute; padding-left: 4px; white-space: nowrap; }
  .nums :global(.end) { padding: 0 0 0 4px; color: var(--color-annotation-measure); }
  .main { display: flex; flex-wrap: wrap; gap: 48px; justify-content: space-between; align-items: flex-start; padding-top: 40px; }
  .cta { width: min(520px, 100%); display: flex; flex-direction: column; gap: 24px; }
  .headline { margin: 0; font: var(--type-heading-section); letter-spacing: var(--tracking-heading-section); color: var(--color-text-primary); }
  .sub { margin: 0; color: var(--color-text-muted); }
  .email { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .addr { font: var(--type-body-default); color: var(--color-text-primary); text-decoration: none; }
  .btn-wrap { position: relative; display: inline-flex; }
  .links { display: flex; flex-direction: column; gap: 10px; }
  .links .lab { margin: 0; color: var(--color-annotation-measure); }
  .links a { font: var(--type-ui-nav); color: var(--color-text-secondary); text-decoration: none; }
  .links a:hover { color: var(--color-text-primary); }
  .colophon { border-top: 1px solid var(--color-border-subtle); padding-top: 16px; display: flex; flex-direction: column; gap: 6px; color: var(--color-text-muted); }
  .colophon p { margin: 0; }
  .gap { display: inline-block; width: 3em; }
  @media (max-width: 720px) { .gap { display: block; width: 0; height: 0; } }
  /* While the pointer is in the footer, the "You" cursor replaces the system arrow (script below) */
  :global(.ftr.you-here), :global(.ftr.you-here *) { cursor: none !important; }
  .copied { position: absolute; z-index: 7; display: flex; gap: 8px; align-items: center; padding: 6px 12px 7px 6px; white-space: nowrap; background: var(--color-surface-sunken); border: 1px solid var(--color-border-strong); border-radius: 2px 10px 10px 10px; filter: drop-shadow(0 8px 12px rgba(0,0,0,0.1)); pointer-events: none; }
  .copied .av { width: 22px; height: 22px; border-radius: 11px; display: grid; place-items: center; background: var(--color-cursor-pm); color: var(--color-surface-page); }
  .copied b { font-weight: 600; color: var(--color-text-primary); margin-right: 4px; }
  .copied .t-body-small { color: var(--color-text-secondary); }
</style>

<script>
  import { gsap, playOnce, reduceMotion } from '../lib/motion';

  const ftr = document.querySelector<HTMLElement>('footer.ftr');
  const you = ftr?.querySelector<HTMLElement>('.cursor.c-you');
  const bubble = ftr?.querySelector<HTMLElement>('[data-copied]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const wide = () => innerWidth >= 1200; // overlays only show at this width
  let at = { x: 0, y: 0 }; // the cursor's offset from its Figma spot

  // Your pointer becomes "You": the system arrow hides and the cursor sits exactly where your mouse is.
  if (ftr && you && fine && !reduceMotion()) {
    const place = (e: PointerEvent) => {
      const base = you.offsetParent as HTMLElement | null; if (!base) return;
      const b = base.getBoundingClientRect();
      at = { x: e.clientX - b.left - you.offsetLeft - 1, y: e.clientY - b.top - you.offsetTop - 1 }; // the arrow's tip is 1px in
      gsap.set(you, at);
    };
    ftr.addEventListener('pointerenter', (e) => { if (!wide()) return; gsap.killTweensOf(you); ftr.classList.add('you-here'); place(e); });
    ftr.addEventListener('pointermove', (e) => { if (ftr.classList.contains('you-here')) place(e); });
    ftr.addEventListener('pointerleave', () => {
      if (!ftr.classList.contains('you-here')) return;
      ftr.classList.remove('you-here'); at = { x: 0, y: 0 };
      gsap.to(you, { x: 0, y: 0, duration: 0.6, ease: 'power3.inOut' });
    });
  }

  // Ruler numbers: one every 80px, as many as fit the real content width (the last one shows that width).
  const ruler = ftr?.querySelector<HTMLElement>('[data-ruler]');
  const nums = ruler?.querySelector<HTMLElement>('[data-ruler-nums]');
  if (ruler && nums) {
    const draw = () => {
      const w = Math.round(ruler.offsetWidth); const out: string[] = [];
      for (let x = 0; x <= w - 40; x += 80) out.push(`<span style="left:${x}px">${x}</span>`);
      out.push(`<span class="end" style="right:0">${w}</span>`);
      nums.innerHTML = out.join('');
    };
    new ResizeObserver(draw).observe(ruler); draw();
    // Draws itself left to right once, when it comes into view.
    playOnce(ruler, () => gsap.set(ruler, { clipPath: 'inset(0 100% 0 0)' }), () => gsap.to(ruler, { clipPath: 'inset(0 0% 0 0)', duration: 1.1, ease: 'power2.inOut', clearProps: 'clipPath' }), 0.6);
  }

  // Copying the email from the footer leaves a comment from You, right under the cursor.
  document.addEventListener('email:copied', (e) => {
    const { ok, button } = (e as CustomEvent).detail ?? {};
    if (!ok || !ftr || !you || !bubble || !ftr.contains(button)) return;
    bubble.style.left = `${you.offsetLeft + at.x + 14}px`; bubble.style.top = `${you.offsetTop + at.y + 40}px`;
    bubble.hidden = false;
    gsap.killTweensOf(bubble);
    if (reduceMotion()) { setTimeout(() => (bubble.hidden = true), 2200); return; }
    gsap.fromTo(bubble, { autoAlpha: 0, scale: 0.9, transformOrigin: '0% 0%' }, { autoAlpha: 1, scale: 1, duration: 0.3, ease: 'back.out(1.8)' });
    gsap.to(bubble, { autoAlpha: 0, delay: 2, duration: 0.3, onComplete: () => { bubble.hidden = true; } });
  });
</script>
