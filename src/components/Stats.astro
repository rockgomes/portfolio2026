---
// Figma: Stat (large) 61:2812, in a row of four. Used by Numbers (homepage) and case study pages. Numeric values count
// up once when scrolled into view (not with reduced motion). The rule above each stat is [data-stat-rule]: on the
// homepage Motion.astro draws it in.
export interface Stat { value: string; unit: string; text: string; count?: number; suffix?: string }
interface Props { stats: Stat[] }
const { stats } = Astro.props;
---
<div class="stats" data-stats>
  {stats.map((s) => (
    <div class="stat" data-stat>
      <i class="rule" data-stat-rule aria-hidden="true"></i>
      <p class="value"><span class="big" data-count-to={s.count} data-suffix={s.suffix}>{s.value}</span><span class="unit t-mono-small">{s.unit}</span></p>
      <p class="text">{s.text}</p>
    </div>
  ))}
</div>
<style>
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-24); }
  .stat { position: relative; padding-top: 25px; /* 1px rule + 24px, same as the old border */ display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--color-border-strong); }
  .value { margin: 0; display: flex; gap: var(--space-8); align-items: baseline; white-space: nowrap; }
  .big { font: var(--type-display-row); letter-spacing: var(--tracking-display-row); color: var(--color-text-primary); font-variant-numeric: tabular-nums; }
  .unit { color: var(--color-text-secondary); }
  .text { margin: 0; font: var(--type-body-default); color: var(--color-text-secondary); }
  @media (max-width: 1040px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-40); } }
  @media (max-width: 560px) { .stats { grid-template-columns: minmax(0, 1fr); } }
</style>
<script>
  import { playOnce } from '../lib/motion';

  // Count up once, when the number comes into view (shared rule in src/lib/motion.ts: never with reduced motion)
  document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => {
    const to = Number(el.dataset.countTo); if (!to) return;
    const suffix = el.dataset.suffix ?? '';
    playOnce(el, () => { el.textContent = '0'; }, () => {
      const t0 = performance.now(); const dur = 900;
      const step = (t: number) => { const p = Math.min(1, (t - t0) / dur); el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3)))) + (p < 1 ? '' : suffix); if (p < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    }, 0.6);
  });
</script>
