---
// Figma: Section header (20:28). Display title + mono subtitle, optional dimension line.
// No section number: Rock removed them to cut visual noise (Oct 2026).
// anchor (optional): the engineer view shows a GitHub-style "#" heading anchor that hangs left of the title.
// command (optional): in the engineer view, a shell command takes the place of the dimension line.
import Dimension from './Dimension.astro';
interface Props { anchor?: boolean; title: string; subtitle: string; dimension?: string; command?: string; id?: string; titleId?: string }
const { anchor, title, subtitle, dimension, command, id, titleId } = Astro.props;
const cut = command ? command.indexOf(' --') : -1;
const [cmdName, cmdFlags] = !command ? ['', ''] : cut < 0 ? [command, ''] : [command.slice(0, cut), command.slice(cut + 1)];
---
<div class="sh" id={id}>
  <div class="row">
    {anchor && <span class="anchor" aria-hidden="true" data-engineer>#</span>}
    <h2 class="title" id={titleId} data-title><slot name="title">{title}</slot></h2>
  </div>
  <p class="sub t-mono-label">{subtitle}</p>
  {dimension && (command ? <div data-not-engineer><Dimension label={dimension} /></div> : <Dimension label={dimension} />)}
  {command && <p class="cmd t-mono-label" data-engineer><span class="prompt" aria-hidden="true">$ </span>{cmdName}{cmdFlags && <> <span class="flags">{cmdFlags}</span></>}</p>}
</div>
<style>
  .sh { display: flex; flex-direction: column; gap: var(--space-12); position: relative; }
  /* The "#" anchor hangs in the left margin, so the title, subtitle and section content share one left edge.
     Below 1200px the margin is too narrow, so the anchor sits on its own line above the title. */
  .row { position: relative; }
  .anchor { position: absolute; right: calc(100% + 14px); top: 0; font: var(--type-mono-small); line-height: 44px; color: var(--color-text-muted); white-space: nowrap; }
  .title { margin: 0; font: var(--type-display-row); letter-spacing: var(--tracking-display-row); color: var(--color-text-primary); text-wrap: balance; }
  .sub { margin: 0; color: var(--color-annotation-measure); }
  .cmd { margin: 0; color: var(--color-text-primary); }
  .prompt { color: var(--color-text-muted); }
  .flags { color: var(--color-annotation-measure); }
  @media (max-width: 1199px) { .anchor { position: static; display: block; line-height: 1.4; margin-bottom: var(--space-8); } }
  /* Recruiter view (sober): no dimension line, a smaller title (the recruiter headline size), grey subtitle */
  :global(html[data-view='recruiter']) .sh :global(.dim) { display: none; }
  :global(html[data-view='recruiter']) .title { font: var(--type-heading-section); letter-spacing: var(--tracking-heading-section); }
  :global(html[data-view='recruiter']) .sub { color: var(--color-text-muted); }
</style>
