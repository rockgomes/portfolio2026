---
// Hero story (motion plan, moment 01): a short working session on the hero table, based on the Dynamic Lists project.
// The PM brings the users' problem, Rock proposes and builds the fix (a saved view), the Dev asks how it works, Rock answers.
// It starts without the table's top bar: the bar of saved views slides in when Rock proposes them.
// It starts after the headline animation. While it plays, each message sits next to the cursor of the person who says it
// (the messages are children of the cursors, in Hero.astro), so a visitor reads it and watches the action in the same place.
// It ends in the resting state: "ICP · Not churned" selected, no cursors (they fade in to act and fade out at the end),
// and one resolved comment (this thread) that opens to show the whole conversation.
// Plays once per browser tab on wide screens, never with reduced motion. A visitor's own table state is put back after it.
import ResolvedLabel from './ResolvedLabel.astro';
import { messages } from '../data/heroStory';
---
<div class="thread" data-story-thread data-state="end" data-overlay role="group" aria-label="Comment thread">
  {messages.map((m) => (
    <div class:list={['msg', `c-${m.color}`, m.keep && 'keep']} data-msg>
      <span class="av t-mono-label" aria-hidden="true">{m.initial}</span>
      <div class="body">
        <p class="meta"><span class="who">{m.who}</span></p>
        <p class="txt t-body-small">{m.text}</p>
      </div>
    </div>
  ))}
  <button type="button" class="resolved" data-resolved aria-expanded="false"><ResolvedLabel><span class="replies"> · 3 replies<span class="act" data-replies>Show</span></span></ResolvedLabel></button>
</div>

<style>
  /* Same card as Comment.astro (Figma 44:575). Anchored by its bottom edge, so the thread grows up over the table. */
  /* left: Figma's 502px at 1440px (Specimen 734px). On a narrower Specimen it keeps the same 58px overhang past the table, inside the page gutter. */
  .thread { position: absolute; left: min(502px, calc(100% - 232px)); top: 608px; width: 290px; transform: translateY(-100%); z-index: 11; display: flex; flex-direction: column; gap: 10px; padding: 10px 14px 12px 10px; background: var(--color-surface-sunken); border: 1px solid var(--color-border-strong); border-radius: 2px 10px 10px 10px; filter: drop-shadow(0 8px 12px rgba(0,0,0,0.1)); }
  .thread[data-state='end'] .msg:not(.keep) { display: none; }
  /* Engineer view: the inspect panel replaces the story and its comment */
  :global(html[data-view='engineer']) .thread, :global(html[data-view='engineer'] [data-story-replay]) { display: none !important; }
  .msg { display: flex; gap: 10px; align-items: flex-start; overflow: hidden; }
  .av { width: 26px; height: 26px; border-radius: 13px; display: grid; place-items: center; background: var(--c); color: var(--color-surface-page); flex: none; }
  .body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1 0 0; }
  .meta { margin: 0; display: flex; gap: 8px; align-items: baseline; white-space: nowrap; }
  .who { font: var(--type-ui-button); color: var(--color-text-primary); }
  .txt { margin: 0; color: var(--color-text-secondary); }
  .resolved { align-self: flex-start; margin: 0 0 0 36px; padding: 2px 4px; border: 0; border-radius: 3px; background: none; cursor: pointer; text-align: left; }
  .resolved:hover :global(.rl) { color: var(--color-text-primary); }
  /* "Show" / "Hide": tells the visitor the resolved comment opens. */
  .act { margin-left: 6px; color: var(--color-text-primary); text-decoration: underline; text-decoration-color: var(--color-border-strong); text-underline-offset: 3px; }
  .resolved:hover .act { text-decoration-color: currentColor; }
  .resolved:disabled { cursor: default; background: none; }
  .c-pm { --c: var(--color-cursor-pm); }
  .c-dev { --c: var(--color-annotation-measure); }
  .c-rock { --c: var(--color-annotation-redline); }
</style>

<script>
  import { gsap, reduceMotion } from '../lib/motion';

  const thread = document.querySelector<HTMLElement>('[data-story-thread]');
  const msgs = thread ? [...thread.querySelectorAll<HTMLElement>('[data-msg]')] : [];
  const toggle = thread?.querySelector<HTMLButtonElement>('[data-resolved]');
  const replies = thread?.querySelector<HTMLElement>('[data-replies]');
  const others = msgs.filter((m) => !m.classList.contains('keep'));

  // Grow an element from zero height, so the thread gets taller as it opens.
  const grow = (el: HTMLElement) => gsap.fromTo(el, { height: 0, autoAlpha: 0 }, { height: 'auto', autoAlpha: 1, duration: 0.4, ease: 'power2.out', clearProps: 'height' });

  // The resolved comment opens and folds the whole conversation. Works with or without motion.
  function setOpen(open: boolean) {
    if (!thread || !toggle || !replies) return;
    thread.dataset.state = open ? 'open' : 'end';
    toggle.setAttribute('aria-expanded', String(open));
    replies.textContent = open ? 'Hide' : 'Show';
    if (open && !reduceMotion()) others.forEach((m) => grow(m));
  }
  toggle?.addEventListener('click', () => { if (thread?.dataset.state !== 'story') setOpen(thread?.dataset.state !== 'open'); });

  const SEEN = 'rg-hero-story-seen';
  const spec = document.querySelector<HTMLElement>('[data-specimen]');
  const table = document.querySelector<HTMLElement>('[data-hero-table]');
  const api = (table as any)?.heroTable;
  const replay = document.querySelector<HTMLButtonElement>('[data-story-replay]');
  const rock = spec?.querySelector<HTMLElement>(':scope > .cursor.c-rock');
  const pm = spec?.querySelector<HTMLElement>(':scope > .cursor.c-pm');
  const dev = spec?.querySelector<HTMLElement>(':scope > .cursor.c-dev');
  const wide = () => innerWidth >= 1200; // the cursors and comments only show at this width
  // The story messages, by their place in the conversation. Each one is a child of its person's cursor (Hero.astro).
  const says = msgs.map((_, i) => spec?.querySelector<HTMLElement>(`:scope > .cursor [data-say="${i}"]`)).filter((b): b is HTMLElement => !!b);

  if (spec && table && api && thread && toggle && pm && dev && rock && says.length === msgs.length && !reduceMotion()) run(spec, table, thread, toggle, pm, dev, rock);

  function run(spec: HTMLElement, table: HTMLElement, thread: HTMLElement, toggle: HTMLButtonElement, pm: HTMLElement, dev: HTMLElement, rock: HTMLElement) {
    let tl: gsap.core.Timeline | null = null;
    let snapshot: unknown = null;

    // Slower than before, so people can follow (Rock's request): a cursor move takes 1.3s (was 0.9s).
    const MOVE = 1.3;
    // The top bar (saved views) is not there at the start: it slides in when Rock proposes saved views (Rock's request).
    // While it is still tucked away, a cursor aims where its target will be once the bar is in.
    const bar = table.querySelector<HTMLElement>('[data-views-bar]')!;
    const scroll = table.querySelector<HTMLElement>('.scroll')!;
    const tucked = () => Math.max(0, -parseFloat(getComputedStyle(bar).marginTop));
    let barH = 0;
    // A point on an element, in the specimen's coordinates, turned into the offset a cursor needs to reach it.
    const to = (cur: HTMLElement, el: () => Element | null, fx = 0.5, fy = 0.6) => {
      const at = () => { const s = spec.getBoundingClientRect(); const r = (el() ?? table).getBoundingClientRect(); return { x: r.left - s.left + r.width * fx - cur.offsetLeft, y: r.top - s.top + r.height * fy - cur.offsetTop + tucked() }; };
      return { x: () => at().x, y: () => at().y, duration: MOVE, ease: 'power2.inOut' };
    };
    const q = (sel: string) => () => table.querySelector(sel);
    const press = (sel: string) => () => { const el = table.querySelector(sel); if (el) gsap.fromTo(el, { scale: 0.93 }, { scale: 1, duration: 0.35, ease: 'back.out(2)' }); };
    // A message fades in by its cursor (sliding 6px towards it), and fades out when the story moves on.
    const sayFrom = (b: HTMLElement) => ({ autoAlpha: 0, y: b.classList.contains('say-above') ? 6 : -6 });
    const sayIn = { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out' };
    const sayOut = { autoAlpha: 0, duration: 0.3 };
    // A message sits 18px right of its cursor, but never more than 40px past the table's right edge
    // (the page gutter is wider than that from 1200px). Checked on every frame, because the cursors move.
    const DX = 18, OVER = 40;
    const fit = () => {
      const s = spec.getBoundingClientRect();
      for (const b of says) {
        const cx = b.parentElement!.getBoundingClientRect().left - s.left;
        b.style.left = `${Math.max(0, Math.min(cx + DX, s.width + OVER - b.offsetWidth)) - cx}px`;
      }
    };

    function finish() {
      if (!tl) return;
      tl.kill(); tl = null;
      spec.removeEventListener('pointerdown', skip);
      gsap.ticker.remove(fit);
      gsap.killTweensOf([pm, dev, rock, thread, ...msgs, toggle, ...says, bar, scroll]);
      gsap.set([bar, scroll], { clearProps: 'marginTop,opacity,visibility,maxHeight' });
      gsap.set([pm, dev, rock, ...says], { clearProps: 'transform,opacity,visibility,left' });
      gsap.set([thread, ...msgs, toggle], { clearProps: 'opacity,visibility,transform,height' });
      [...msgs, toggle].forEach((el) => (el.hidden = false));
      toggle.disabled = false; setOpen(false);
      if (snapshot) api.load(snapshot); api.pause(false);
    }
    const skip = () => finish();

    // Put the table and thread at the start of the story (also used right at load, so the end state never flashes first).
    let prepared = false;
    function prepare() {
      snapshot = api.snapshot(); api.pause(true); api.start();
      barH = (table as any).closeBar();
      thread.dataset.state = 'story'; toggle.disabled = true;
      [...msgs, toggle].forEach((el) => (el.hidden = true));
      gsap.set(thread, { autoAlpha: 0 });
      prepared = true;
      spec.addEventListener('pointerdown', skipEarly);
    }
    // Before the timeline starts, a click on the table still has to restore it.
    function skipEarly() { cancelled = true; unprepare(); }
    let cancelled = false;
    function unprepare() {
      spec.removeEventListener('pointerdown', skipEarly);
      if (!prepared) return; prepared = false;
      gsap.set(thread, { clearProps: 'opacity,visibility' }); [...msgs, toggle].forEach((el) => (el.hidden = false));
      gsap.set([bar, scroll], { clearProps: 'marginTop,opacity,visibility,maxHeight' });
      toggle.disabled = false; setOpen(false);
      if (snapshot) api.load(snapshot); api.pause(false);
    }

    function play() {
      if (tl) finish();
      if (!prepared) prepare();
      spec.removeEventListener('pointerdown', skipEarly);
      prepared = false;
      try { sessionStorage.setItem(SEEN, '1'); } catch {}
      const count = table.querySelector<HTMLElement>('[data-count]')!;

      // The cursors fade in as they move up from their start points (below the table), and go back there fading out.
      // Each message shows by its cursor while that person acts, so it can be read during the action.
      // The thread stays hidden until the end, then shows as the resolved comment.
      tl = gsap.timeline({ delay: 0.3, onComplete: () => finish() });
      gsap.ticker.add(fit); fit();
      // 1. The PM brings the users' problem. Their message has 3s on its own (was 1.4s) before Rock comes in.
      // The PM stops on the pill, not beside it: at 1200px the table hides the Status column, and a PM beside the pill stuck out past the screen edge.
      tl.to(pm, { ...to(pm, q('.pill-churned'), 0.3, 0.8), autoAlpha: 1 })
        .fromTo(says[0], sayFrom(says[0]), sayIn, '-=0.3')
      // 2. Rock proposes the fix, then builds it: a condition, then Save as view. His message sits above his cursor,
      // so it never covers the + Condition menu, and stays while he works.
        .to(rock, { ...to(rock, q('[data-add]')), autoAlpha: 1 }, '+=3')
        .fromTo(says[1], sayFrom(says[1]), sayIn, '<0.4')
      // As he proposes it, the top bar slides in from the window's top edge. The rows make room, so the window keeps its
      // height, and the PM's cursor stays on the pill it points at.
        .to(bar, { marginTop: 0, autoAlpha: 1, duration: 0.8, ease: 'power2.inOut' }, '<0.3')
        .to(scroll, { maxHeight: () => parseFloat(scroll.style.maxHeight) - barH, duration: 0.8, ease: 'power2.inOut' }, '<')
        .to(pm, { y: `+=${barH}`, duration: 0.8, ease: 'power2.inOut' }, '<')
        .add(press('[data-add]'), '+=1.6').add(() => api.openMenu())
        .to(says[0], sayOut, '<')
      // He picks the condition near the right end of the menu item, so his message clears the menu.
        .to(rock, { ...to(rock, q('[data-add-i="3"]'), 0.95), duration: 0.9 }, '+=0.6')
        .add(press('[data-add-i="3"]'))
        .add(() => { api.addCond(3); gsap.to({ n: 40 }, { n: 28, duration: 0.9, ease: 'power2.out', onUpdate() { count.textContent = String(Math.round(this.targets()[0].n)); } }); }, '+=0.25')
        .to(rock, to(rock, q('[data-save-view]')), '+=1.1')
        .add(press('[data-save-view]'))
        .add(() => { const tab = api.saveView('ICP · Not churned'); if (tab) gsap.from(tab, { autoAlpha: 0, scale: 0.85, duration: 0.6, ease: 'back.out(1.8)' }); }, '+=0.25')
      // 3. The Dev asks how it works; Rock answers by the match count. The PM leaves as the Dev comes in
      // (Rock's request: the PM's cursor sat on Rock's answer).
        .to(dev, { ...to(dev, q('[data-preset]:not([data-preset="all"]):not([data-preset="emea"])'), 0.6, 0.9), autoAlpha: 1 }, '+=0.8')
        .to(pm, { x: 0, y: 0, autoAlpha: 0, duration: MOVE, ease: 'power2.inOut' }, '<') // back the way they came
        .fromTo(says[2], sayFrom(says[2]), sayIn, '-=0.3')
      // After 3s to read the question, both earlier messages go as Rock moves to answer (at 1200px the Dev's message
      // sits over the match count, where Rock goes).
        .to([says[1], says[2]], sayOut, '+=3')
        .to(rock, { ...to(rock, q('[data-count]'), 0.2, 2.2), duration: 1 }, '<')
        .fromTo(says[3], sayFrom(says[3]), sayIn, '-=0.2')
      // 4. After 4s to read the answer, the messages go, the resolved comment shows, and the Dev and Rock leave
        .to(says[3], { ...sayOut, duration: 0.4 }, '+=4')
        .add(() => { thread.dataset.state = 'end'; msgs[0].hidden = false; toggle.hidden = false; }, '<')
        .to(thread, { autoAlpha: 1, duration: 0.5 }, '<')
        .to([dev, rock], { x: 0, y: 0, autoAlpha: 0, duration: 1.2, ease: 'power2.inOut', stagger: 0.15 }, '<'); // back the way they came

      // Clicking the table skips to the end, so a visitor can use it. Scrolling and keys do not.
      spec.addEventListener('pointerdown', skip);
    }

    // Start after the headline animation (Motion.astro), or after a short wait if that event never comes.
    function startWhenReady() {
      let started = false;
      prepare();
      const go = () => { if (!started && !cancelled) { started = true; play(); } };
      document.addEventListener('hero:headline-done', go, { once: true });
      setTimeout(go, 5000);
    }

    let seen = false; try { seen = sessionStorage.getItem(SEEN) === '1'; } catch {}
    // A visitor's own table state is saved before the story and put back after it, so it never gets lost.
    // In the recruiter view the hero is hidden, and in the engineer view the inspect panel takes its place (Figma 187:1648),
    // so the story waits until the visitor switches to the design lead view.
    const html = document.documentElement;
    const waits = (v?: string) => v === 'recruiter' || v === 'engineer';
    if (wide() && !seen) {
      if (!waits(html.dataset.view)) startWhenReady();
      else html.addEventListener('viewchange', function onView(e) { if (!waits((e as CustomEvent).detail)) { html.removeEventListener('viewchange', onView); startWhenReady(); } });
    }
    // Leaving the design lead view ends the story at once, as a click on the table does. Otherwise the cursors go on
    // working on the table in the engineer view. A story that has not started yet is cancelled.
    html.addEventListener('viewchange', (e) => {
      if (!waits((e as CustomEvent).detail)) return;
      if (tl) finish();
      else if (prepared) { cancelled = true; unprepare(); }
    });
    if (replay) { replay.hidden = !wide(); replay.addEventListener('click', (e) => { e.stopPropagation(); play(); }); }
  }
</script>
