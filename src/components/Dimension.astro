---
// Figma: Dimension / Horizontal (20:3). Blue measure line with ticks and a measure label. Set data-measure to fill the label live from the parent width.
interface Props { label: string; live?: string }
const { label, live } = Astro.props;
---
<div class="dim" aria-hidden="true" data-dimension={live}>
  <span class="side"><i class="tick"></i><i class="line"></i></span>
  <span class="label t-mono-label">{label}</span>
  <span class="side"><i class="line"></i><i class="tick"></i></span>
</div>
<style>
  .dim { display: flex; align-items: center; gap: 10px; height: 12px; width: 100%; }
  .side { flex: 1 0 0; min-width: 0; display: flex; align-items: center; overflow: hidden; }
  .tick { width: 1px; height: 9px; background: var(--color-annotation-measure); flex: none; }
  .line { flex: 1 0 0; height: 1px; background: var(--color-annotation-measure); }
  .label { color: var(--color-annotation-measure); white-space: nowrap; text-align: center; }
</style>
