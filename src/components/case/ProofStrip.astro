---
// A row of pictures with a short mono label under each, and one caption (Figma: Steps / winning prototype 540:1754,
// Phones / search 542:1724). Plain, each picture has the 1px strong border of a Proof. `phones` puts phone screens,
// rounded, in the middle of a Proof's stage frame. Below 560px the plain row stacks; phones stay side by side.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Item { src: ImageMetadata; alt: string; label: string }
interface Props { items: Item[]; caption?: string; phones?: boolean }
const { items, caption, phones = false } = Astro.props;
const sizes = phones ? '244px' : '(min-width: 1040px) 256px, (min-width: 560px) 33vw, 100vw';
---
<figure class:list={['strip', { phones }]} data-proof-strip>
  <ol class="row">
    {items.map((it) => (
      <li class="item">
        <Image class="pic" src={it.src} alt={it.alt} widths={[...new Set([488, 768, it.src.width])].filter((w) => w <= it.src.width)} sizes={sizes} loading="lazy" />
        <span class="label t-mono-small">{it.label}</span>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .strip { margin: 0; display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .row { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-16); }
  .item { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .pic { display: block; width: 100%; height: auto; border: 1px solid var(--color-border-strong); }
  .label { color: var(--color-text-secondary); }
  figcaption { font: var(--type-body-small); color: var(--color-text-muted); }
  .phones .row { justify-content: center; gap: var(--space-32); padding: var(--space-32); border: 1px solid var(--color-border-strong); background: var(--color-surface-stage); }
  .phones .item { flex: 0 1 244px; }
  .phones .pic { border-radius: 24px; }
  @media (max-width: 560px) {
    .strip:not(.phones) .row { flex-direction: column; }
    .phones .row { gap: var(--space-16); padding: var(--space-16); }
  }
</style>
