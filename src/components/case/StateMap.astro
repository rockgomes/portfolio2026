---
// A state map that moves (Figma maps 586:1336, 586:1368, 586:1397, in the prototype style): states are real buttons,
// the moves between them are SVG lines. In view, it plays its runs one after the other: a dot travels each line, the
// line and its chip light up, and the state it reaches becomes the current one. Pause it, or click a state with a
// dashed border to take the next step yourself. With reduced motion nothing plays on its own and a click moves at
// once. Without JS it is the still map. The canvas is 798 x 398 and scales down to the box; below 62% it scrolls.
import IconRotateCw from '../IconRotateCw.astro';
import { arrowHead, MAP_W, MAP_H, type StateMapDef } from './state-map';
interface Props { map: StateMapDef }
const { map } = Astro.props;
const start = map.nodes.find((n) => n.start)!;
---
<div class="smap" data-state-map role="group" aria-label={`${map.label}, a state map`}>
  <p class="sr-only">{map.description}</p>
  <div class="scroll" data-scroll>
    <div class="fit" data-fit>
      <div class="stage" data-stage>
        <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} width={MAP_W} height={MAP_H} aria-hidden="true">
          {map.edges.map((e, i) => (
            <g class="edge" data-edge={i} data-from={e.from} data-to={e.to}>
              <path class="line" d={e.d} />
              <path class="line" d={arrowHead(e.d)} />
              <path class="trace" d={e.d} />
            </g>
          ))}
          <circle class="dot" data-dot r="5" cx="0" cy="0" />
        </svg>
        {map.edges.map((e, i) => e.chip && (
          <span class="chip" data-chip={i} aria-hidden="true" style={`left:${e.chip.x}px;top:${e.chip.y}px`}>{e.chip.text}</span>
        ))}
        {map.nodes.map((n) => (
          <button type="button" class:list={['node', { start: n.start, profile: n.tabs }]} data-node={n.id} data-start={n.start ? '' : undefined} data-tab-end={n.tabs ? n.tabEnd ?? n.tabs.length - 1 : undefined} aria-current={n.start ? 'true' : undefined} aria-disabled="true" tabindex="-1" style={`left:${n.x}px;top:${n.y}px;width:${n.w}px;height:${n.h}px`}>
            {n.start && <svg class="play" width="8" height="9" viewBox="0 0 8 9" aria-hidden="true"><path d="M0 0L8 4.5L0 9Z" /></svg>}
            <span class="name">{n.label}</span>
            {n.tabs && <span class="tabs">{n.tabs.map((t) => <span class="tab">{t}</span>)}</span>}
          </button>
        ))}
      </div>
    </div>
  </div>
  <div class="bar">
    <p class="now t-mono-label">state <b data-now>{start.label}</b></p>
    <p class="hint" data-hint></p>
    <button type="button" class="btn btn-icon" data-play aria-label="Play" aria-pressed="false">
      <svg class="i-pause" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.14" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="4" width="4" height="16" rx="1" /><rect x="6" y="4" width="4" height="16" rx="1" /></svg>
      <svg class="i-play" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.14" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3" /></svg>
    </button>
    <button type="button" class="btn btn-icon" data-restart aria-label="Start again"><IconRotateCw /></button>
  </div>
  <script type="application/json" data-runs set:html={JSON.stringify(map.runs)} />
</div>
<style>
  .smap { display: flex; flex-direction: column; }
  .scroll { overflow-x: auto; overflow-y: hidden; }
  .fit { position: relative; width: 798px; height: 398px; }
  .stage { position: absolute; inset: 0 auto auto 0; width: 798px; height: 398px; transform-origin: 0 0; }
  .stage > svg { position: absolute; inset: 0; overflow: visible; }

  /* Lines: the Figma connector, 2px blue with a chevron. While the map plays, the lines it has not used yet are faint
     and the ones it used stay lit, so the path of the run shows. */
  .line, .trace { fill: none; stroke: var(--color-annotation-measure); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .trace { opacity: 0; }
  .line { transition: opacity 0.4s ease; }
  .dot { fill: var(--color-annotation-measure); stroke: var(--color-surface-page); stroke-width: 2; opacity: 0; }
  .live .edge:not(.lit) .line { opacity: 0.3; }

  .chip { position: absolute; transform: translate(-50%, -50%); padding: 2px 6px; border-radius: var(--radius-tag); background: var(--color-annotation-measure); color: var(--color-surface-page); font: var(--type-ui-pill-small); white-space: nowrap; transition: opacity 0.4s ease; }
  .live .chip:not(.lit) { opacity: 0.45; }

  /* States: the white frame of the Figma maps. The current one gets a blue border and a soft ring; the ones you can
     go to next get a dashed border. */
  .node { position: absolute; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 0; margin: 0; background: var(--color-surface-raised); border: 1px solid var(--color-border-subtle); border-radius: 0; color: var(--color-text-primary); font: var(--type-ui-table-strong); white-space: nowrap; cursor: default; transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease; }
  .node[aria-current='true'] { border-color: var(--color-annotation-measure); box-shadow: 0 0 0 4px var(--color-annotation-measure-soft); }
  .node.next { border: 1px dashed var(--color-annotation-measure); cursor: pointer; }
  .node.next:hover { background: color-mix(in srgb, var(--color-annotation-measure-soft) 40%, var(--color-surface-raised)); }
  .node:focus-visible { outline: 2px solid var(--color-annotation-measure); outline-offset: 3px; }
  .start { gap: 7px; border-color: var(--color-annotation-measure); border-radius: var(--radius-control); background: var(--color-annotation-measure); color: var(--color-surface-page); font: var(--type-ui-pill); }
  .start[aria-current='true'] { border-color: var(--color-annotation-measure); }
  .play { fill: currentColor; }
  .profile { flex-direction: column; align-items: flex-start; gap: 4px; padding: 0 15px; }
  .tabs { display: flex; font: var(--type-mono-small); color: var(--color-text-muted); }
  .tab + .tab::before { content: '·'; padding-inline: 8px; color: var(--color-text-muted); }
  .tab { transition: color 0.2s ease; }
  .tab.on { color: var(--color-annotation-measure); }

  .bar { display: flex; align-items: center; gap: var(--space-8); padding: var(--space-8) var(--space-12); border-top: 1px solid var(--color-border-subtle); background: var(--color-surface-page); }
  .now { margin: 0; color: var(--color-text-muted); white-space: nowrap; }
  .now b { font-weight: 400; color: var(--color-annotation-measure); }
  .hint { flex: 1; min-width: 0; margin: 0; font: var(--type-body-small); color: var(--color-text-muted); text-align: right; }
  [data-play] .i-play, [data-play][aria-pressed='true'] .i-pause { display: block; }
  [data-play] .i-pause, [data-play][aria-pressed='true'] .i-play { display: none; }
  @media (max-width: 520px) { .hint { display: none; } .now { flex: 1; } }
</style>
<script>
  import { gsap, reduceMotion } from '../../lib/motion';

  const W = 798, H = 398, MIN = 0.62;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>('[data-state-map]').forEach((root) => {
    // Fit the canvas to the box
    const scroll = root.querySelector<HTMLElement>('[data-scroll]')!;
    const fit = root.querySelector<HTMLElement>('[data-fit]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const fitTo = () => {
      if (!scroll.clientWidth) return;
      const s = Math.min(1, Math.max(MIN, scroll.clientWidth / W));
      stage.style.transform = `scale(${s})`;
      fit.style.width = `${W * s}px`;
      fit.style.height = `${H * s}px`;
    };
    new ResizeObserver(fitTo).observe(scroll);
    fitTo();

    const nodes = new Map([...root.querySelectorAll<HTMLButtonElement>('[data-node]')].map((n) => [n.dataset.node!, n]));
    const edges = [...root.querySelectorAll<SVGGElement>('[data-edge]')].map((g) => ({
      g, from: g.dataset.from!, to: g.dataset.to!,
      trace: g.querySelector<SVGPathElement>('.trace')!,
      chip: root.querySelector<HTMLElement>(`[data-chip="${g.dataset.edge}"]`),
    }));
    type Edge = (typeof edges)[number];
    const runs: string[][] = JSON.parse(root.querySelector('[data-runs]')!.textContent!);
    const start = [...nodes.values()].find((n) => n.hasAttribute('data-start'))!.dataset.node!;
    const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
    const now = root.querySelector<HTMLElement>('[data-now]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]')!;

    let current = start;
    let busy = false; // a dot is on its way
    let wanted = !reduceMotion(); // play on its own while in view
    let visible = false;
    let loopId = 0;
    let run = 0, step = 0;
    let tween: ReturnType<typeof gsap.to> | undefined;
    let epoch = 0; // goes up on every restart, so a move still on its way stops there

    const outs = (id: string) => edges.filter((e) => e.from === id);
    const name = (id: string) => nodes.get(id)!.querySelector('.name')!.textContent!;

    // Which states can be clicked: only the ones one move away, and only while nothing is moving
    const refresh = () => {
      const next = busy ? [] : outs(current).map((e) => e.to);
      nodes.forEach((n, id) => {
        const on = next.includes(id);
        n.classList.toggle('next', on);
        n.setAttribute('aria-disabled', String(!on));
        n.tabIndex = on ? 0 : -1;
        if (on) n.setAttribute('aria-label', `Go to ${name(id)}`); else n.removeAttribute('aria-label');
        if (id === current) n.setAttribute('aria-current', 'true'); else n.removeAttribute('aria-current');
      });
      now.textContent = name(current);
      const playing = wanted && visible;
      hint.textContent = playing ? '' : next.length ? 'Click a state with a dashed border to go there.' : 'End of the flow. Start again to go back.';
      playBtn.setAttribute('aria-pressed', String(wanted));
      playBtn.setAttribute('aria-label', wanted ? 'Pause' : 'Play');
    };

    const setTabs = (n: HTMLElement, upTo: number) => n.querySelectorAll('.tab').forEach((t, i) => t.classList.toggle('on', i === upTo));

    // Move along one line. With motion: the dot travels, the line draws in, the chip pulses; then the profile tabs
    // light up one by one. Without: it all lands at once.
    const travel = async (e: Edge, animate: boolean) => {
      const ep = epoch;
      busy = true;
      root.classList.add('live');
      refresh();
      e.g.classList.add('lit');
      e.chip?.classList.add('lit');
      if (animate) {
        const len = e.trace.getTotalLength();
        const p = { t: 0 };
        gsap.set(e.trace, { opacity: 1, strokeDasharray: len, strokeDashoffset: len });
        gsap.set(dot, { opacity: 1 });
        if (e.chip) gsap.fromTo(e.chip, { scale: 1.15 }, { scale: 1, duration: 0.5, ease: 'back.out(3)', clearProps: 'scale' });
        tween = gsap.to(p, {
          t: 1, duration: Math.max(0.5, len / 260), ease: 'power1.inOut',
          onUpdate: () => {
            const pt = e.trace.getPointAtLength(p.t * len);
            dot.setAttribute('cx', String(pt.x));
            dot.setAttribute('cy', String(pt.y));
            e.trace.style.strokeDashoffset = String(len * (1 - p.t));
          },
        });
        await tween;
        if (ep !== epoch) return;
        gsap.to(dot, { opacity: 0, duration: 0.2 });
        gsap.set(e.trace, { opacity: 0 });
      }
      current = e.to;
      refresh();
      const n = nodes.get(current)!;
      if (n.dataset.tabEnd) {
        const end = Number(n.dataset.tabEnd);
        if (animate) for (let i = 0; i <= end; i++) { setTabs(n, i); await wait(i === 0 ? 300 : 260); if (ep !== epoch) return; }
        else setTabs(n, end);
      }
      busy = false;
      refresh();
    };

    const reset = () => {
      loopId++;
      epoch++;
      tween?.kill();
      busy = false;
      gsap.set(dot, { opacity: 0 });
      edges.forEach((e) => { e.g.classList.remove('lit'); e.chip?.classList.remove('lit'); gsap.set(e.trace, { opacity: 0 }); });
      nodes.forEach((n) => setTabs(n, -1));
      root.classList.remove('live');
      current = start;
      step = 0;
      refresh();
    };

    // The runs, one after the other, while in view and not paused
    const loop = async () => {
      const id = ++loopId;
      const alive = () => id === loopId && wanted && visible;
      while (busy) { await wait(100); if (!alive()) return; }
      // Coming back after a pause or a click: carry on if the run still fits, else start again
      if (runs[run][step] !== current) { reset(); return loop(); }
      while (alive()) {
        const path = runs[run];
        if (step >= path.length - 1) {
          await wait(2000); if (!alive()) return;
          run = (run + 1) % runs.length;
          reset();
          return loop();
        }
        await wait(step === 0 ? 700 : 900); if (!alive()) return;
        const e = edges.find((x) => x.from === path[step] && x.to === path[step + 1])!;
        await travel(e, true);
        if (id !== loopId) return;
        step++;
      }
    };

    const update = () => { refresh(); if (wanted && visible) loop(); else loopId++; };

    new IntersectionObserver((entries) => {
      visible = entries.some((en) => en.isIntersecting);
      update();
    }, { threshold: 0.4 }).observe(root);

    playBtn.addEventListener('click', () => { wanted = !wanted; update(); });
    restartBtn.addEventListener('click', () => { reset(); update(); });
    nodes.forEach((n, id) => n.addEventListener('click', () => {
      if (busy) return;
      const e = outs(current).find((x) => x.to === id);
      if (!e) return;
      // You take over: it stops playing on its own, and says where it is
      wanted = false;
      loopId++;
      now.parentElement!.setAttribute('aria-live', 'polite');
      travel(e, !reduceMotion());
    }));

    refresh();
  });
</script>
