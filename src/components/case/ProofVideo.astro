---
// A screen recording used as proof (from auto() in the old fa-truth and fa-flows embeds). It plays when a third of it
// is in view and pauses when it leaves. With reduced motion it never starts on its own: it shows its controls instead.
// A video inside a hidden switch panel is out of view, so switching panels plays and pauses the right one.
interface Props { src: string; poster: string; label: string; width: number; height: number }
const { src, poster, label, width, height } = Astro.props;
---
<video data-proof-video muted playsinline loop controls preload="metadata" poster={poster} width={width} height={height} aria-label={label}><source src={src} type="video/mp4" /></video>
<style>
  video { display: block; width: 100%; height: auto; background: var(--color-surface-stage); }
</style>
<script>
  import { reduceMotion } from '../../lib/motion';

  const videos = document.querySelectorAll<HTMLVideoElement>('[data-proof-video]');
  if (reduceMotion()) {
    videos.forEach((v) => v.removeAttribute('loop'));
  } else {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => { v.controls = true; }); // blocked autoplay: give the controls back
      else v.pause();
    }), { threshold: 0.35 });
    videos.forEach((v) => { v.controls = false; io.observe(v); });
  }
</script>
