---
// A control that swaps the proof below it: kind="segmented" is the Segmented control, kind="tabs" the Tab (the shared
// Segmented.astro and Tabs.astro, the same ones as the header and the Experience client tabs). Every panel is in the
// HTML and only the selected one shows, so without JS the first choice (or `selected`) is still there. Clicks, arrow
// keys and motion come from src/lib/choice.ts. A video in a closed panel is out of view, so it pauses (autoplay.ts).
// `sizes` goes to each Proof (how wide the pictures show).
import Proof from './Proof.astro';
import Segmented from '../Segmented.astro';
import Tabs from '../Tabs.astro';
import type { ProofMedia } from './proof';
interface Item { label: string; caption: string; media: ProofMedia }
interface Props { kind: 'tabs' | 'segmented'; label: string; id: string; items: Item[]; selected?: number; sizes?: string }
const { kind, label, id, items, selected = 0, sizes } = Astro.props;
const tabs = kind === 'tabs';
const labels = items.map((it) => it.label);
---
<div class="proof-switch" data-switch={id}>
  {tabs
    ? <Tabs class="ctrl" label={label} id={id} tabs={labels} selected={selected} />
    : <Segmented class="ctrl" label={label} selected={selected} options={labels.map((l, i) => ({ label: l, attrs: { id: `${id}-tab-${i}`, 'aria-controls': `${id}-panel-${i}` } }))} />}
  <div class="panels">
    {items.map((it, i) => (
      <div data-proof-panel id={`${id}-panel-${i}`} role={tabs ? 'tabpanel' : undefined} aria-labelledby={tabs ? `${id}-tab-${i}` : undefined} hidden={i !== selected}>
        <Proof media={it.media} caption={it.caption} sizes={sizes} />
      </div>
    ))}
  </div>
</div>
<style>
  .proof-switch { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .proof-switch > :global(.ctrl) { flex-wrap: wrap; align-self: flex-start; max-width: 100%; }
</style>
<script>
  import { bindChoice } from '../../lib/choice';

  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((sw) => {
    const options = [...sw.querySelectorAll<HTMLButtonElement>('.ctrl button')];
    bindChoice({ options, panels: options.map((o) => sw.querySelector<HTMLElement>(`#${o.getAttribute('aria-controls')}`)), box: sw.querySelector<HTMLElement>('.panels')! });
  });
</script>
