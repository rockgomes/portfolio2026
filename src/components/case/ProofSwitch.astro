---
// A control that swaps the proof below it: kind="segmented" is the Segmented control (.ui-seg, Figma 193:119),
// kind="tabs" the Tab (.ui-tab, Figma 195:113), the same ones as the header and the Experience client tabs.
// Every panel is in the HTML and only the selected one shows, so without JS the first choice (or `selected`) is
// still there. Arrow keys stay inside this group. Motion as in Experience.astro: the new panel fades in and the height eases.
import Proof from './Proof.astro';
import type { ProofMedia } from './proof';
interface Item { label: string; caption: string; media: ProofMedia }
interface Props { kind: 'tabs' | 'segmented'; label: string; id: string; items: Item[]; selected?: number }
const { kind, label, id, items, selected = 0 } = Astro.props;
const tabs = kind === 'tabs';
const on = (i: number) => (i === selected ? 'true' : 'false');
---
<div class="proof-switch" data-switch={id}>
  <div class:list={['ctrl', tabs ? 'ui-tabs' : 'ui-seg']} role={tabs ? 'tablist' : 'radiogroup'} aria-label={label}>
    {items.map((it, i) => (
      <button type="button" id={`${id}-opt-${i}`} role={tabs ? 'tab' : 'radio'}
        aria-selected={tabs ? on(i) : undefined} aria-checked={tabs ? undefined : on(i)}
        class:list={[tabs && 'ui-tab']} aria-controls={`${id}-panel-${i}`} tabindex={i === selected ? 0 : -1}>{it.label}</button>
    ))}
  </div>
  <div class="panels">
    {items.map((it, i) => (
      <div data-proof-panel id={`${id}-panel-${i}`} role={tabs ? 'tabpanel' : undefined} aria-labelledby={`${id}-opt-${i}`} hidden={i !== selected}>
        <Proof media={it.media} caption={it.caption} />
      </div>
    ))}
  </div>
</div>
<style>
  .proof-switch { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .ctrl { flex-wrap: wrap; align-self: flex-start; max-width: 100%; }
  .ctrl button:focus-visible { outline: 2px solid var(--color-annotation-measure); outline-offset: 2px; }
  [data-proof-panel][hidden] { display: none; }
</style>
<script>
  import { bindChoice } from '../../lib/choice';

  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((sw) => {
    const options = [...sw.querySelectorAll<HTMLButtonElement>('.ctrl button')];
    const panels = options.map((o) => sw.querySelector<HTMLElement>(`#${o.getAttribute('aria-controls')}`));
    // A video in a panel that closes stops; the one in the new panel starts through its own in-view rule
    bindChoice({ options, panels, box: sw.querySelector<HTMLElement>('.panels')!, onSelect: (i) => panels.forEach((p, j) => { if (j !== i) p?.querySelectorAll('video').forEach((v) => v.pause()); }) });
  });
</script>
