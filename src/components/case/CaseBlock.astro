---
// One block of a case study section (sketch C: each decision, each step of "How I got there", "inspect"): a 400px
// text column (mono label, title, text, optional fact pills) and the proof next to it. Stacked below 1040px.
// Extra attributes (for example data-decision) go on the root.
interface Props { label: string; title: string; pills?: string[]; [attr: string]: unknown }
const { label, title, pills = [], ...attrs } = Astro.props;
---
<article class="block" data-case-block {...attrs}>
  <div class="text">
    <p class="label t-mono-label">{label}</p>
    <h3 class="title">{title}</h3>
    <div class="body"><slot /></div>
    {pills.length > 0 && <ul class="pills">{pills.map((p) => <li class="ui-pill ui-pill-sm">{p}</li>)}</ul>}
  </div>
  <div class="proof"><slot name="proof" /></div>
</article>
<style>
  .block { display: flex; gap: var(--space-80); align-items: flex-start; }
  .text { flex: 0 0 400px; display: flex; flex-direction: column; gap: var(--space-16); }
  .label { margin: 0; color: var(--color-annotation-measure); }
  .title { margin: 0; font: var(--type-heading-item); letter-spacing: var(--tracking-heading-item); color: var(--color-text-primary); }
  .body { font: var(--type-body-default); color: var(--color-text-secondary); }
  .body :global(p) { margin: 0; }
  .body :global(p + p) { margin-top: var(--space-12); }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .proof { flex: 1 1 0; min-width: 0; }
  @media (max-width: 1040px) { .block { flex-direction: column; gap: var(--space-24); } .text { flex-basis: auto; max-width: 560px; } .proof { width: 100%; } }
</style>
