---
// One part of a case study page (decisions, how I got there, ...). The Section header (Figma 20:28) without the
// number or the dimension line: case pages have no Figma layer. Title at the Heading/Section size, as in sketch C.
import SectionHeader from '../SectionHeader.astro';
interface Props { title: string; subtitle: string; id: string }
const { title, subtitle, id } = Astro.props;
---
<section class="case-section wrap" id={id} aria-labelledby={`${id}-title`}>
  <SectionHeader title={title} subtitle={subtitle} titleId={`${id}-title`} />
  <slot />
</section>
<style>
  .case-section { display: flex; flex-direction: column; gap: var(--space-48); padding-top: var(--space-120); }
  .case-section :global(.sh .title) { font: var(--type-heading-section); letter-spacing: var(--tracking-heading-section); }
  @media (max-width: 720px) { .case-section { padding-top: var(--space-80); } }
</style>
