---
// Before and after in one picture (sketch C 376:10255, from the old fa-cmp embed): the "before" picture covers the
// left part up to the handle. The control is a real range input laid over the picture, so arrow keys, touch and
// screen readers work; the line and the handle follow its value. Sits in the Proof frame; labels are Tags.
import Proof from './Proof.astro';
interface Pic { src: string; alt: string }
interface Props { before: Pic; after: Pic; beforeLabel: string; afterLabel: string; width: number; height: number; label: string; caption?: string }
const { before, after, beforeLabel, afterLabel, width, height, label, caption } = Astro.props;
---
<Proof caption={caption}>
  <div class="cmp" data-compare style="--x: 50%">
    <img class="after" src={after.src} alt={after.alt} width={width} height={height} loading="lazy" decoding="async" />
    <img class="before" src={before.src} alt={before.alt} width={width} height={height} loading="lazy" decoding="async" />
    <span class="line" aria-hidden="true"></span>
    <span class="handle" aria-hidden="true">⇆</span>
    <span class="ui-tag tag l">{beforeLabel}</span>
    <span class="ui-tag tag r">{afterLabel}</span>
    <input type="range" min="0" max="100" value="50" aria-label={label} />
  </div>
</Proof>
<style>
  .cmp { position: relative; touch-action: pan-y; user-select: none; }
  img { display: block; width: 100%; height: auto; }
  .before { position: absolute; inset: 0; height: 100%; object-fit: cover; object-position: top; clip-path: inset(0 calc(100% - var(--x)) 0 0); }
  .line { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; transform: translateX(-1px); background: var(--color-surface-page); }
  .handle { position: absolute; top: 50%; left: var(--x); transform: translate(-50%, -50%); display: grid; place-items: center; width: 32px; height: 32px; border-radius: 16px; border: 1px solid var(--color-border-strong); background: var(--color-surface-page); font: var(--type-ui-button); color: var(--color-text-primary); }
  .tag { position: absolute; bottom: var(--space-12); }
  .l { left: var(--space-12); } .r { right: var(--space-12); }
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .cmp:has(input:focus-visible) { outline: 2px solid var(--color-annotation-measure); outline-offset: 2px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((c) => {
    c.querySelector('input')!.addEventListener('input', (e) => c.style.setProperty('--x', `${(e.target as HTMLInputElement).value}%`));
  });
</script>
