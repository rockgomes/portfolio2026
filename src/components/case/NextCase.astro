---
// Figma: Next case study (377:10288) in sketch C. The next public project or experiment by card order (the homepage
// order: 01 to 11, then the experiments), after the last back to the first. The same Work card as the
// homepage, without its index (no Figma layer on case pages).
import WorkCard from '../WorkCard.astro';
import { workItems } from '../../lib/work';
interface Props { currentId: string }
const { currentId } = Astro.props;
const items = await workItems();
const i = items.findIndex((it) => it.id === currentId);
const next = items.length > 1 ? items[(i + 1) % items.length] : undefined;
---
{next && (
  <section class="next wrap" aria-labelledby="next-case-title" data-next-case>
    <h2 class="label t-mono-label" id="next-case-title">next case study</h2>
    <ul class="one">
      <WorkCard {...next} />
    </ul>
  </section>
)}
<style>
  .next { display: flex; flex-direction: column; gap: var(--space-24); padding-block: var(--space-120) var(--space-96); }
  .label { margin: 0; color: var(--color-text-muted); }
  .one { list-style: none; margin: 0; padding: 0; width: min(485px, 100%); }
  @media (max-width: 720px) { .next { padding-block: var(--space-80) var(--space-64); } }
</style>
