---
// Figma: Next case study (377:10288) in sketch C. The next public project by card order, after the last back to the
// first. The same Work card as the homepage, without its index (no Figma layer on case pages).
import { getCollection } from 'astro:content';
import WorkCard from '../WorkCard.astro';
import { isPrivate } from '../../lib/private';
interface Props { currentId: string }
const { currentId } = Astro.props;
const projects = (await getCollection('projects')).filter((p) => !isPrivate(p.data)).sort((a, b) => a.data.cardOrder - b.data.cardOrder);
const i = projects.findIndex((p) => p.id === currentId);
const next = projects.length > 1 ? projects[(i + 1) % projects.length] : undefined;
---
{next && (
  <section class="next wrap" aria-labelledby="next-case-title" data-next-case>
    <h2 class="label t-mono-label" id="next-case-title">next case study</h2>
    <ul class="one">
      <WorkCard id={next.id} href={`/project/${next.id}`} img={next.data.homeImage} alt={next.data.homeImageAlt} demo={next.data.demoUrl} d={next.data} />
    </ul>
  </section>
)}
<style>
  .next { display: flex; flex-direction: column; gap: var(--space-24); padding-block: var(--space-120) var(--space-96); }
  .label { margin: 0; color: var(--color-text-muted); }
  .one { list-style: none; margin: 0; padding: 0; width: min(485px, 100%); }
  @media (max-width: 720px) { .next { padding-block: var(--space-80) var(--space-64); } }
</style>
