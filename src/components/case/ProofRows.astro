---
// One thing seen by several people (Figma: Who sees what 557:1285). Each row: who it is and one line on the left, a real
// screen on the right with one part outlined and pinned (.ui-pin). `part` is in the screen's own pixels, and the outline
// and pin are children of the screen's box (overlays rule). `width` caps how wide a screen shows (a phone crop is narrower).
// Below 720px the line goes above the screen. One caption under all rows, like a Proof.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Part { x: number; y: number; w: number; h: number }
interface Row { label: string; text: string; src: ImageMetadata; alt: string; part: Part; width?: number }
interface Props { rows: Row[]; caption?: string }
const { rows, caption } = Astro.props;
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---
<figure class="rows" data-proof-rows>
  <ol class="list">
    {rows.map((r, i) => (
      <li class="row">
        <div class="who">
          <p class="label t-mono-label">{r.label}</p>
          <p class="text">{r.text}</p>
        </div>
        <div class="screen" style={r.width ? `max-width:${r.width}px` : undefined}>
          <Image class="pic" src={r.src} alt={r.alt} widths={[...new Set([576, 1152, r.src.width])].filter((w) => w <= r.src.width)} sizes="(min-width: 1040px) 576px, 100vw" loading="lazy" />
          <span class="part" aria-hidden="true" style={`left:${pct(r.part.x, r.src.width)};top:${pct(r.part.y, r.src.height)};width:${pct(r.part.w, r.src.width)};height:${pct(r.part.h, r.src.height)}`}>
            <span class="ui-pin">{i + 1}</span>
          </span>
        </div>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .rows { margin: 0; display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-32); }
  .row { display: flex; gap: var(--space-24); align-items: flex-start; }
  .who { flex: 0 0 200px; display: flex; flex-direction: column; gap: 6px; }
  .who p { margin: 0; }
  .label { color: var(--color-text-muted); }
  .text { font: var(--type-body-small); color: var(--color-text-secondary); }
  .screen { position: relative; flex: 1 1 0; min-width: 0; }
  .pic { display: block; width: 100%; height: auto; border: 1px solid var(--color-border-subtle); border-radius: 8px; }
  .part { position: absolute; border: 1.5px solid var(--color-annotation-redline); border-radius: 6px; }
  .part .ui-pin { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); }
  figcaption { font: var(--type-body-small); color: var(--color-text-muted); }
  @media (max-width: 720px) {
    .row { flex-direction: column; gap: var(--space-12); }
    .who { flex-basis: auto; }
    .screen { width: 100%; }
  }
</style>
