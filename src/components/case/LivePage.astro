---
// The live page of a project, scaled to fit (from the old Webflow embed fa-live), in the same framed box as Proof,
// under a small browser bar (Figma: Browser bar 427:83): three dots, the address (a small Pill) and a Reload button (the shared .btn .btn-icon) that
// starts the prototype again. The iframe is drawn at 1440x900 and scaled to the box width. Below half size (phones)
// the iframe is too small to use, so a screen recording shows instead, playing in view as every proof video does;
// there Reload starts the recording again. A page without a recording shows its still picture (poster) there, and no
// Reload. Without JS, or before JS runs, the recording (or the still) shows: nothing is ever blank or wider than the page.
// embed={false}: the site does not allow other pages to show it in a frame (X-Frame-Options), so the still shows at
// every size, under the same browser bar, with no Reload.
// clickToLoad: a heavy prototype (a Figma embed) does not load with the page. On desktop the still picture shows in
// the frame with a "Load the prototype" button; the iframe gets its address only after the click, and the picture stays
// until the prototype has loaded. Reload is hidden until then. Phones show the still, as before.
import Proof from './Proof.astro';
import IconRotateCw from '../IconRotateCw.astro';
interface Props { src: string; video?: string; poster: string; caption: string; title: string; videoLabel?: string; embed?: boolean; clickToLoad?: boolean }
const { src, video, poster, caption, title, videoLabel, embed = true, clickToLoad = false } = Astro.props;
const cover = embed && clickToLoad;
const address = src.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<div class="live" data-live data-phone data-still={!video || undefined} data-cover={cover || undefined}>
  <Proof caption={caption}>
    <div class="bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="ui-pill ui-pill-sm addr">{address}</span>
      <button type="button" class="btn btn-icon reload" data-live-reload aria-label="Reload the live page"><IconRotateCw /></button>
    </div>
    <div class="view" data-live-view>
      {embed && <iframe src={cover ? undefined : src} data-src={cover ? src : undefined} title={title} loading="lazy"></iframe>}
      {video
        ? <video muted loop playsinline controls preload="none" poster={poster} aria-label={videoLabel}><source src={video} type="video/mp4" /></video>
        : <img class="still" src={poster} alt={`${title}, a still picture`} width="1440" height="900" loading="lazy" decoding="async" />}
      {cover && <button type="button" class="btn btn-primary load" data-live-load>Load the prototype</button>}
    </div>
  </Proof>
</div>
<style>
  .bar { display: grid; grid-template-columns: 1fr minmax(0, auto) 1fr; align-items: center; gap: var(--space-12); padding: 6px var(--space-12); background: var(--color-surface-page); border-bottom: 1px solid var(--color-border-subtle); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 8px; height: 8px; border-radius: var(--radius-pill); border: 1px solid var(--color-border-strong); }
  .addr { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reload { justify-self: end; }
  .view { position: relative; overflow: hidden; }
  iframe { position: absolute; top: 0; left: 0; width: 1440px; height: 900px; border: 0; transform-origin: 0 0; }
  video, .still { display: none; width: 100%; height: auto; }
  .live[data-phone] iframe { display: none; }
  .live[data-phone] :is(video, .still) { display: block; }
  .live[data-phone][data-still] .reload { visibility: hidden; }
  .live[data-phone] .view { height: auto !important; }
  /* clickToLoad: on desktop the still covers the frame, with the button in the middle, until the prototype has loaded */
  .load { display: none; }
  .live[data-cover]:not([data-phone]) .still { display: block; position: absolute; inset: 0; z-index: 1; height: 100%; object-fit: contain; background: var(--color-surface-stage); }
  .live[data-cover]:not([data-phone]) .view::after { content: ''; position: absolute; inset: 0; z-index: 1; background: color-mix(in srgb, var(--color-surface-page) 45%, transparent); pointer-events: none; }
  .live[data-cover]:not([data-phone]) .load { display: inline-flex; position: absolute; z-index: 2; top: 50%; left: 50%; transform: translate(-50%, -50%); box-shadow: var(--shadow-panel); }
  .live[data-cover] .reload { visibility: hidden; }
  @media (max-width: 560px) { .dots { display: none; } .bar { grid-template-columns: minmax(0, 1fr) auto; } .addr { justify-self: start; } }
</style>
<script>
  import { autoplay, restart } from '../../lib/autoplay';

  const W = 1440, H = 900;
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((fig) => {
    const view = fig.querySelector<HTMLElement>('[data-live-view]')!;
    const frame = fig.querySelector('iframe');
    // No frame (embed={false}): the still stays at every size
    if (!frame) return;
    const video = fig.querySelector('video');
    const fit = () => {
      const s = view.clientWidth / W;
      if (s < 0.5) {
        fig.toggleAttribute('data-phone', true);
      } else {
        fig.toggleAttribute('data-phone', false);
        frame.style.transform = `scale(${s})`;
        view.style.height = `${Math.round(H * s)}px`;
      }
    };
    fit();
    new ResizeObserver(fit).observe(view);
    // Phones: the recording plays in view (src/lib/autoplay.ts); on desktop it is hidden, so it never plays
    if (video) autoplay(video);
    // clickToLoad: the prototype gets its address on the click; the picture goes once the frame has loaded. Figma sends no
    // "ready" message, so after that its own loading screen shows until the prototype is drawn.
    const load = fig.querySelector<HTMLButtonElement>('[data-live-load]');
    load?.addEventListener('click', () => {
      load.disabled = true;
      load.textContent = 'Loading the prototype…';
      frame.addEventListener('load', () => fig.removeAttribute('data-cover'), { once: true });
      frame.loading = 'eager';
      frame.src = frame.dataset.src!;
    });
    // Reload: the prototype starts again from the top (phones: the recording starts again)
    fig.querySelector('[data-live-reload]')!.addEventListener('click', () => {
      if (fig.hasAttribute('data-phone')) { if (video) restart(video); }
      else if (frame.getAttribute('src')) frame.src = frame.src;
    });
  });
</script>
