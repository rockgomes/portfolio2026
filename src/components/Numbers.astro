---
// Figma: Numbers (96:6863): the "in numbers" label and four Stats (Stats.astro, Stat (large) 61:2812).
import Stats, { type Stat } from './Stats.astro';
const stats: Stat[] = [
  { value: '10', unit: 'years', count: 10, text: 'Designing tools people use all day at work: loan back-offices, CRM integrations, sales data and support tools.' },
  { value: '3', unit: 'design systems', count: 3, text: 'Two built from zero at Inbank and Bigbank, one rebuilt at Well. Tokens, components and docs that teams actually use.' },
  { value: '170+', unit: 'countries', count: 170, suffix: '+', text: 'Pipedrive is used in 170+ countries. At Bigbank I designed for 7 markets, and the Inbank checkout runs in 4.' }, // Pipedrive's own figure
  { value: '7', unit: 'live demos', count: 7, text: 'Prototypes and products I built and shipped in code, from case study recreations to side projects.' },
];
---
<section class="numbers" aria-label="In numbers" data-recruiter-also>
  <div class="wrap inner">
    <div class="label t-mono-label"><span class="l">in numbers</span><span class="r">as of October 2026</span></div>
    <Stats stats={stats} />
  </div>
</section>
<style>
  .numbers { border-bottom: 1px solid var(--color-border-subtle); }
  .inner { display: flex; flex-direction: column; gap: var(--space-32); padding-block: var(--space-64); }
  .label { display: flex; justify-content: space-between; gap: var(--space-16); }
  .l { color: var(--color-annotation-measure); } .r { color: var(--color-text-muted); }
  @media (max-width: 560px) { .r { display: none; } }
</style>
