---
// Engineer view only: Design systems as a small Storybook. Figma: 1 - Storybook (218:2), its pages (228:2),
// the screen-size frames (238:2, 238:197) and the phone frames (243:15, 243:165).
// Every story renders the site's real classes and tokens. Values on the Colour page are read live from tokens.css.
import SectionHeader from './SectionHeader.astro';
import SbDropdown from './SbDropdown.astro';
const chevron = '<svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2.5 4l2.5 2.5L7.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>';

const systems = [
  { name: 'Inbank', when: '2023 - 2025', scope: 'Built from scratch right after the rebrand. One system for checkout in four countries and the back-office.' },
  { name: 'Bigbank', when: '2016 - 2020', scope: 'Built with one other designer. A coded component library, so the system is what ships.' },
  { name: 'Well', when: 'Contract', scope: 'Rebuilt the back-office design system. Colour tokens updated to meet AAA contrast.' },
];
const tree = [
  { group: 'Introduction', items: [{ id: 'intro', label: 'Design systems' }] },
  { group: 'Foundations', items: [{ id: 'colour', label: 'Colour' }, { id: 'modes', label: 'Modes' }] },
  { group: 'Components', items: [{ id: 'button', label: 'Button', canvas: true }, { id: 'segmented', label: 'Segmented control', canvas: true }, { id: 'pill', label: 'Status pill', canvas: true }] },
];
const colours: [string, string[]][] = [
  ['Surface', ['surface-page', 'surface-raised', 'surface-sunken', 'surface-stage']],
  ['Text', ['text-primary', 'text-secondary', 'text-muted', 'text-accent']],
  ['Border', ['border-strong', 'border-subtle', 'border-control']],
  ['Annotation', ['annotation-measure', 'annotation-measure-soft', 'annotation-redline', 'annotation-redline-soft']],
  ['Status', ['status-positive', 'status-positive-soft', 'status-negative-text']],
];
const preview = ['surface-page', 'text-primary', 'text-secondary', 'annotation-measure', 'annotation-redline', 'status-positive'];
const statuses = ['Lead', 'Trial', 'Customer', 'Churned'];
---
<section class="dsd" id="design-systems-dev" data-engineer aria-labelledby="dsd-title">
  <div class="wrap inner">
    <SectionHeader title="Design systems" titleId="dsd-title" subtitle="two built from zero, one rebuilt · this page runs on a fourth" />

    <div class="win" data-sb>
      <div class="navbar">
        <button type="button" class="menu" aria-expanded="false" aria-controls="sb-nav" data-sb-menu>
          <span class="crumb"><span class="mut" data-sb-crumb-group>Introduction /</span> <span class="cur" data-sb-crumb>Design systems</span></span>
          <span class="caret"><Fragment set:html={chevron} /></span>
        </button>
      </div>

      <nav class="side" id="sb-nav" aria-label="Design system pages">
        <p class="brand">rockgomes.com</p>
        <label class="search">
          <span class="sr-only">Find components</span>
          <input type="search" placeholder="Find components" autocomplete="off" spellcheck="false" data-sb-find />
          <kbd aria-hidden="true">/</kbd>
        </label>
        {tree.map((g) => (
          <div class="grp" data-sb-grp>
            <p class="gh">{g.group}</p>
            <ul>{g.items.map((i) => <li><button type="button" class="item" data-sb-go={i.id} data-sb-group={g.group} aria-current={i.id === 'intro' ? 'page' : undefined}>{i.label}</button></li>)}</ul>
          </div>
        ))}
        <p class="none" hidden data-sb-none>No match.</p>
      </nav>

      <div class="bar">
        <div class="tabs utabs" role="tablist" aria-label="Show">
          <button type="button" role="tab" class="utab" id="sb-tab-canvas" aria-selected="false" aria-disabled="true" data-sb-tab="canvas">Canvas</button>
          <button type="button" role="tab" class="utab" id="sb-tab-docs" aria-selected="true" data-sb-tab="docs">Docs</button>
        </div>
        <SbDropdown name="theme" label="Theme" options={['Light - Dev', 'Dark - Dev']} value="Light - Dev" />
      </div>

      <div class="scroll" role="region" aria-label="Design system page" tabindex="0" data-sb-scroll>
        <!-- Introduction -->
        <div class="page" data-sb-page="intro">
          <div class="docs" data-sb-panel="docs">
            <h3 class="ph">Design systems</h3>
            <p class="lede">I have built design systems from scratch at Inbank and Bigbank, and rebuilt one at Well. Each one had to survive real products, real deadlines and a real dev team. This page is the fourth: every story below renders the real components and tokens of rockgomes.com.</p>
            <table class="tbl sys">
              <thead><tr><th>System</th><th>Years</th><th>Scope</th></tr></thead>
              <tbody>{systems.map((s) => <tr><th scope="row">{s.name}</th><td class="mono">{s.when}</td><td>{s.scope}</td></tr>)}</tbody>
            </table>
            <div class="stories">
              <div class="story">
                <h4>Button</h4>
                <div class="canvas">
                  <div class="render grid-btn" aria-hidden="true">
                    {['', 'is-hover', 'is-focus'].map((s) => <div class="r"><span class:list={['btn', s]}>Button</span><span class:list={['btn btn-primary', s]}>Button</span></div>)}
                  </div>
                  <details class="code"><summary>Show code</summary><pre><code>{`<a class="btn" href="#">Button</a>\n<a class="btn btn-primary" href="#">Button</a>`}</code></pre></details>
                </div>
                <p class="cap">One component with Style and State. The same names are in base.css: .btn and .btn-primary.</p>
              </div>
              <div class="story">
                <h4>Colour</h4>
                <div class="canvas">
                  <ul class="render swatches">{preview.map((c) => <li><i class="sw" style={`background: var(--color-${c})`}></i><code>--color-{c}</code><span class="val" data-sb-val={c}></span></li>)}</ul>
                  <details class="code"><summary>Show code</summary><pre><code>{`.btn-primary {\n  background: var(--color-annotation-measure);\n}`}</code></pre></details>
                </div>
                <p class="cap">Figma variables are exported to tokens.css with the same names. A token in the spec is the token in the code.</p>
              </div>
              <div class="story">
                <h4>Modes</h4>
                <div class="canvas">
                  <div class="render"><div class="seg" role="radiogroup" aria-label="Theme of this page" data-sb-theme-seg><button type="button" role="radio" aria-checked="true" data-sb-set-theme="light">Light - Dev</button><button type="button" role="radio" aria-checked="false" data-sb-set-theme="dark">Dark - Dev</button></div></div>
                  <details class="code"><summary>Show code</summary><pre><code>{`<html data-view="engineer" data-theme="dark">`}</code></pre></details>
                </div>
                <p class="cap">This switch changes the theme of this page. The components do not change, only the token values do.</p>
              </div>
              <div class="story">
                <h4>Status pill</h4>
                <div class="canvas">
                  <div class="render">{statuses.map((s) => <span class={`pill pill-${s.toLowerCase()}`}><i></i>{s}</span>)}</div>
                  <details class="code"><summary>Show code</summary><pre><code>{`<span class="pill pill-customer"><i></i>Customer</span>`}</code></pre></details>
                </div>
                <p class="cap">One property with four values, not four components.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Colour -->
        <div class="page" data-sb-page="colour" hidden>
          <div class="docs" data-sb-panel="docs">
            <h3 class="ph">Colour</h3>
            <p class="lede">Every colour is a variable in the Figma tokens collection, exported to tokens.css with the same name. The values below are read from this page right now, in <span data-sb-mode-name>Light - Dev</span>.</p>
            {colours.map(([g, list]) => (
              <div class="cgrp">
                <h4>{g}</h4>
                <ul class="swatches">{list.map((c) => <li><i class="sw" style={`background: var(--color-${c})`}></i><code>--color-{c}</code><span class="val" data-sb-val={c}></span></li>)}</ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Modes -->
        <div class="page" data-sb-page="modes" hidden>
          <div class="docs" data-sb-panel="docs">
            <h3 class="ph">Modes</h3>
            <p class="lede">One set of components, six modes. The view switch sets data-view and the theme sets data-theme. Each pair picks one Figma mode, and only the token values change.</p>
            <table class="tbl modes-t">
              <thead><tr><th>View</th><th>data-view</th><th>Light</th><th>Dark</th></tr></thead>
              <tbody>
                <tr><th scope="row">Design lead</th><td class="mono">"design"</td><td class="mono">Light - Crisp</td><td class="mono">Dark</td></tr>
                <tr><th scope="row">Recruiter</th><td class="mono">"recruiter"</td><td class="mono">Light - Recruiter</td><td class="mono">Dark - Recruiter</td></tr>
                <tr class="here"><th scope="row">Engineer</th><td class="mono">"engineer"</td><td class="mono" data-sb-mode-cell="light">Light - Dev</td><td class="mono" data-sb-mode-cell="dark">Dark - Dev</td></tr>
              </tbody>
            </table>
            <p><button type="button" class="btn" data-sb-theme-btn2>Switch this page to dark</button></p>
            <h4>In tokens.css</h4>
            <pre class="block"><code>{`:root[data-view="engineer"]:not([data-theme="dark"]) {\n  --color-annotation-measure: #0a7d44;\n}\n:root[data-view="engineer"][data-theme="dark"] {\n  --color-annotation-measure: #3dd68c;\n}`}</code></pre>
          </div>
        </div>

        <!-- Button -->
        <div class="page" data-sb-page="button" hidden>
          <div class="cv" data-sb-panel="canvas" role="tabpanel" aria-labelledby="sb-tab-canvas">
            <div class="stage"><a class="btn btn-primary big" href="#design-systems-dev" data-sb-demo-btn>Button</a></div>
            <div class="controls">
              <p class="ct">Controls</p>
              <table class="tbl">
                <thead><tr><th>Name</th><th class="hide-s">Description</th><th>Control</th></tr></thead>
                <tbody>
                  <tr><th scope="row" class="mono">Label</th><td class="hide-s">Text on the button. A text property in Figma, the element content in code.</td><td><input class="ctl" type="text" value="Button" maxlength="20" aria-label="Label" data-sb-c-label /></td></tr>
                  <tr><th scope="row" class="mono">Style</th><td class="hide-s">Default is .btn, Primary adds .btn-primary.</td><td><span class="radios" role="radiogroup" aria-label="Style"><label><input type="radio" name="sb-style" value="default" data-sb-c-style /> Default</label><label><input type="radio" name="sb-style" value="primary" checked data-sb-c-style /> Primary</label></span></td></tr>
                  <tr><th scope="row" class="mono">State</th><td class="hide-s">Hover is :hover, Focus is :focus-visible.</td><td><SbDropdown name="state" label="State" options={['Default', 'Hover', 'Focus']} value="Default" /></td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <div class="docs" data-sb-panel="docs" role="tabpanel" aria-labelledby="sb-tab-docs" hidden>
            <h3 class="ph">Button</h3>
            <p class="lede">One component set in Figma with Style and State, and a Label text property. In code it is one class, plus one more for Primary.</p>
            <table class="tbl">
              <thead><tr><th>Figma property</th><th>Values</th><th>In code</th></tr></thead>
              <tbody>
                <tr><th scope="row" class="mono">Label</th><td>text</td><td class="mono">element content</td></tr>
                <tr><th scope="row" class="mono">Style</th><td>Default, Primary</td><td class="mono">.btn, .btn-primary</td></tr>
                <tr><th scope="row" class="mono">State</th><td>Default, Hover, Focus</td><td class="mono">:hover, :focus-visible</td></tr>
              </tbody>
            </table>
            <h4>CSS (base.css)</h4>
            <pre class="block"><code>{`.btn {\n  border: 1px solid var(--color-border-strong);\n  border-radius: var(--radius-control);\n}\n.btn-primary {\n  background: var(--color-annotation-measure);\n}`}</code></pre>
          </div>
        </div>

        <!-- Segmented control -->
        <div class="page" data-sb-page="segmented" hidden>
          <div class="cv" data-sb-panel="canvas" role="tabpanel" aria-labelledby="sb-tab-canvas">
            <div class="stage">
              <div class="seg" role="radiogroup" aria-label="Demo options" data-sb-demo-seg>
                <button type="button" role="radio" aria-checked="true" tabindex="0">Option</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Option</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Option</button>
              </div>
            </div>
            <p class="hint">Click an option, or use the arrow keys. This is the view switch from the header.</p>
          </div>
          <div class="docs" data-sb-panel="docs" role="tabpanel" aria-labelledby="sb-tab-docs" hidden>
            <h3 class="ph">Segmented control</h3>
            <p class="lede">The view switch in the header. Each option is a radio button, so it works with the keyboard and screen readers.</p>
            <table class="tbl">
              <thead><tr><th>Option property</th><th>Values</th><th>In code</th></tr></thead>
              <tbody>
                <tr><th scope="row" class="mono">Label</th><td>text</td><td class="mono">button content</td></tr>
                <tr><th scope="row" class="mono">Selected</th><td>No, Yes</td><td class="mono">aria-checked</td></tr>
                <tr><th scope="row" class="mono">State</th><td>Default, Hover, Focus</td><td class="mono">:hover, :focus-visible</td></tr>
              </tbody>
            </table>
            <h4>Markup</h4>
            <pre class="block"><code>{`<div class="seg">\n  <button type="button" role="radio" aria-checked="true">Option</button>\n  <button type="button" role="radio" aria-checked="false">Option</button>\n</div>`}</code></pre>
          </div>
        </div>

        <!-- Status pill -->
        <div class="page" data-sb-page="pill" hidden>
          <div class="cv" data-sb-panel="canvas" role="tabpanel" aria-labelledby="sb-tab-canvas">
            <div class="stage"><span class="pill pill-customer big" data-sb-demo-pill><i></i><span data-sb-demo-pill-label>Customer</span></span></div>
            <div class="controls">
              <p class="ct">Controls</p>
              <table class="tbl">
                <thead><tr><th>Name</th><th class="hide-s">Values</th><th>Control</th></tr></thead>
                <tbody><tr><th scope="row" class="mono">Status</th><td class="hide-s">{statuses.join(', ')}</td><td><SbDropdown name="status" label="Status" options={statuses} value="Customer" /></td></tr></tbody>
              </table>
            </div>
          </div>
          <div class="docs" data-sb-panel="docs" role="tabpanel" aria-labelledby="sb-tab-docs" hidden>
            <h3 class="ph">Status pill</h3>
            <p class="lede">The status column in the filter table. One component with a Status property, one class per value in code.</p>
            <h4>CSS</h4>
            <pre class="block"><code>{`.pill-lead { background: var(--color-surface-sunken); color: var(--color-text-secondary); }\n.pill-trial { background: var(--color-annotation-redline-soft); color: var(--color-status-negative-text); }\n.pill-customer { background: var(--color-status-positive-soft); color: var(--color-status-positive); }\n.pill-churned { background: transparent; color: var(--color-text-muted); }`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The engineer view swaps the design lead's section for this one */
  :global(html[data-view='engineer'] #design-systems) { display: none !important; }

  .inner { display: flex; flex-direction: column; gap: var(--space-32); padding-top: var(--space-120); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mono, code, pre { font-family: var(--font-mono); }
  .mut { color: var(--color-text-muted); }

  /* The window: fixed height on wide screens, the sidebar and the page scroll inside it */
  .win {
    display: grid; grid-template-columns: 232px minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas: 'side bar' 'side scroll';
    height: clamp(560px, calc(100vh - 240px), 820px);
    border: 1px solid var(--color-border-strong); border-radius: 8px; overflow: hidden; background: var(--color-surface-page);
  }
  .navbar { display: none; }
  .side { grid-area: side; display: flex; flex-direction: column; gap: 2px; padding: var(--space-16) var(--space-12); background: var(--color-surface-stage); border-right: 1px solid var(--color-border-subtle); overflow-y: auto; }
  .brand { margin: 0 0 var(--space-12); padding-left: var(--space-8); font: var(--type-ui-brand); color: var(--color-text-primary); }
  .search { display: flex; align-items: center; gap: var(--space-8); padding: 0 var(--space-8) 0 10px; border: 1px solid var(--color-border-control); border-radius: 6px; background: var(--color-surface-page); }
  .search:focus-within { outline: 2px solid var(--color-annotation-measure); outline-offset: 2px; }
  .search input { flex: 1; min-width: 0; padding: 6px 0; border: 0; background: transparent; font: var(--type-ui-control); color: var(--color-text-primary); outline: 0; }
  .search input::placeholder { color: var(--color-text-muted); }
  kbd { padding: 0 5px; border: 1px solid var(--color-border-strong); border-radius: 4px; font: var(--type-mono-label); color: var(--color-text-muted); }
  .grp ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .gh { margin: var(--space-16) 0 var(--space-4); padding-left: var(--space-8); font: var(--type-mono-label); letter-spacing: var(--tracking-mono-label); text-transform: uppercase; color: var(--color-text-muted); }
  .item { width: 100%; text-align: left; padding: 5px var(--space-8) 5px 20px; border: 0; border-radius: 4px; background: transparent; font: var(--type-ui-control); color: var(--color-text-secondary); cursor: pointer; }
  .item:hover { color: var(--color-text-primary); }
  .item[aria-current='page'] { background: var(--color-annotation-measure-soft); color: var(--color-annotation-measure); font: var(--type-ui-control-strong); }
  .none { margin: var(--space-16) 0 0; padding-left: var(--space-8); font: var(--type-ui-control); color: var(--color-text-muted); }

  /* Toolbar: the shared underline tabs (.utabs/.utab in base.css) and the theme dropdown */
  .bar { grid-area: bar; display: flex; align-items: flex-end; gap: var(--space-16); padding: 6px var(--space-16) 0; border-bottom: 1px solid var(--color-border-subtle); }
  .bar .utabs { flex: 1; padding: 0; border-bottom: 0; margin-bottom: -1px; }
  .bar :global(.dd) { margin-bottom: 6px; }
  .utab[aria-disabled='true'] { cursor: default; opacity: 0.5; }
  .utab[aria-disabled='true']:hover { color: var(--color-text-muted); }

  .scroll { grid-area: scroll; overflow-y: auto; overscroll-behavior: auto; }
  .scroll:focus-visible { outline-offset: -2px; } /* the window clips anything outside it */
  .page { animation: sb-in 0.18s ease-out; }
  @keyframes sb-in { from { opacity: 0; } to { opacity: 1; } }

  .docs { display: flex; flex-direction: column; gap: var(--space-24); padding: 36px var(--space-40) var(--space-40); }
  .docs > p, .docs h4 { margin: 0; }
  .ph { margin: 0; font: var(--type-heading-section); color: var(--color-text-primary); }
  .lede { margin: 0; max-width: 72ch; font: var(--type-body-default); color: var(--color-text-secondary); }
  .docs h4, .story h4, .cgrp h4 { margin: 0; font: var(--type-heading-item); color: var(--color-text-primary); }
  .cgrp h4 { font: var(--type-ui-brand); }

  .tbl { width: 100%; border-collapse: collapse; font: var(--type-ui-table); color: var(--color-text-secondary); }
  .tbl th, .tbl td { padding: 9px var(--space-16) 9px 0; text-align: left; vertical-align: middle; border-bottom: 1px solid var(--color-border-subtle); }
  .tbl thead th { padding-block: 6px; font: var(--type-mono-label); letter-spacing: var(--tracking-mono-label); text-transform: uppercase; color: var(--color-text-muted); border-bottom-color: var(--color-border-strong); }
  .tbl tbody th { font: var(--type-ui-table-strong); color: var(--color-text-primary); }
  .tbl tbody th.mono { font: var(--type-mono-small); }
  .tbl td.mono { font: var(--type-mono-small); color: var(--color-text-primary); }
  .sys td.mono { white-space: nowrap; color: var(--color-text-muted); }
  .modes-t .here th, .modes-t .here td { background: var(--color-annotation-measure-soft); }
  .modes-t [data-sb-active]::after { content: ' · this page'; color: var(--color-annotation-measure); }

  .stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); align-items: start; }
  .story { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .canvas { border: 1px solid var(--color-border-strong); border-radius: 6px; min-width: 0; }
  .render { box-sizing: border-box; display: flex; flex-wrap: wrap; gap: var(--space-12); align-items: center; justify-content: center; min-height: 170px; padding: var(--space-32) var(--space-24); }
  .grid-btn { flex-direction: column; flex-wrap: nowrap; }
  .grid-btn .r { display: flex; gap: var(--space-12); }
  .cap { margin: 0; font: var(--type-body-small); color: var(--color-text-secondary); }
  .code { border-top: 1px solid var(--color-border-subtle); }
  .code summary { padding: 6px var(--space-12); text-align: right; font: var(--type-ui-control); color: var(--color-text-secondary); cursor: pointer; list-style: none; }
  .code summary::-webkit-details-marker { display: none; }
  .code summary:hover { color: var(--color-text-primary); }
  .code[open] summary { border-bottom: 1px solid var(--color-border-subtle); }
  .code pre, .block { margin: 0; padding: 14px var(--space-16); background: var(--color-surface-stage); font: var(--type-mono-small); color: var(--color-text-primary); overflow-x: auto; }
  .block { border-radius: 6px; }

  /* Static Hover and Focus copies of the real .btn rules in base.css */
  .btn.is-hover { color: var(--color-text-primary); }
  .btn-primary.is-hover { background: color-mix(in srgb, var(--color-annotation-measure) 85%, var(--color-text-primary)); color: var(--color-surface-page); }
  .btn.is-focus { outline: 2px solid var(--color-annotation-measure); outline-offset: 2px; }
  .btn.big { font-size: 15px; line-height: 22px; padding: 7px 14px; }

  .swatches { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .render.swatches { align-items: stretch; justify-content: flex-start; }
  .swatches li { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: var(--space-12); align-items: center; }
  .swatches code { font: var(--type-mono-small); color: var(--color-text-primary); overflow-wrap: anywhere; }
  .sw { width: 44px; height: 24px; border-radius: 4px; border: 1px solid var(--color-border-strong); }
  .val { font: var(--type-mono-label); color: var(--color-text-muted); white-space: nowrap; }
  .cgrp { display: flex; flex-direction: column; gap: 10px; }

  /* Same look as the view switch in SiteHeader.astro */
  .seg { display: inline-flex; gap: 2px; padding: 3px; background: var(--color-surface-page); border: 1px solid var(--color-border-strong); border-radius: 8px; }
  .seg button { border: 0; background: transparent; padding: 4px 10px; border-radius: 6px; cursor: pointer; font: var(--type-ui-control-compact); color: var(--color-text-secondary); white-space: nowrap; }
  .seg button:hover { color: var(--color-text-primary); }
  .seg button[aria-checked='true'] { background: var(--color-annotation-measure-soft); color: var(--color-annotation-measure); font-weight: 500; }

  /* The pill colours are the global .pill-* classes from HeroTable.astro */
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px 2px 7px; border-radius: var(--radius-pill); font: 500 11.5px/16px var(--font-sans); }
  .pill i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .pill.big { font-size: 14px; line-height: 20px; padding: 4px 12px 4px 10px; }

  .cv { display: flex; flex-direction: column; min-height: 100%; }
  .stage { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 220px; padding: var(--space-48) var(--space-24); }
  .hint { margin: 0; padding: 0 var(--space-24) var(--space-24); text-align: center; font: var(--type-body-small); color: var(--color-text-muted); }
  .controls { border-top: 1px solid var(--color-border-strong); padding: 0 var(--space-16) var(--space-16); }
  .ct { margin: 0 0 var(--space-4); padding: 10px 0 8px; font: var(--type-ui-control-strong); color: var(--color-text-primary); }
  .ctl { padding: 5px 10px; border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); background: var(--color-surface-page); font: var(--type-ui-control); color: var(--color-text-primary); max-width: 100%; }
  .radios { display: inline-flex; gap: var(--space-16); flex-wrap: wrap; }
  .radios label { display: inline-flex; gap: 6px; align-items: center; font: var(--type-ui-control); color: var(--color-text-primary); cursor: pointer; }
  .radios input { accent-color: var(--color-annotation-measure); margin: 0; }

  @media (prefers-reduced-motion: reduce) { .page { animation: none; } .caret { transition: none; } }
  @media (max-width: 1040px) { .stories { grid-template-columns: minmax(0, 1fr); } .win { grid-template-columns: 200px minmax(0, 1fr); } }

  /* Phones: no fixed height and no inner scroll. The page scrolls, the sidebar becomes a menu button. */
  @media (max-width: 760px) {
    .inner { padding-top: var(--space-80); gap: var(--space-24); }
    .win { height: auto; grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'menu' 'side' 'bar' 'scroll'; }
    .navbar { grid-area: menu; display: block; padding: 10px var(--space-12); background: var(--color-surface-stage); border-bottom: 1px solid var(--color-border-subtle); }
    /* Same look as the Columns button in HeroTable.astro */
    .menu { display: flex; width: 100%; align-items: center; gap: 6px; padding: 5px 10px; border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); background: var(--color-surface-page); font: var(--type-ui-control); color: var(--color-text-secondary); text-align: left; cursor: pointer; }
    .menu:hover, .menu[aria-expanded='true'] { color: var(--color-text-primary); }
    .caret { display: inline-flex; transition: transform 0.2s; }
    .menu[aria-expanded='true'] .caret { transform: rotate(180deg); }
    .crumb { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cur { font: var(--type-ui-control-strong); color: var(--color-text-primary); }
    .side { display: none; border-right: 0; border-bottom: 1px solid var(--color-border-strong); overflow: visible; padding: var(--space-12); }
    .win[data-sb-open] .side { display: flex; }
    .brand { display: none; }
    .item { padding-block: 10px; }
    .bar { padding: 0 var(--space-12); }
    .scroll { overflow: visible; }
    .docs { padding: var(--space-24) var(--space-16) 28px; }
    .ph { font: var(--type-heading-item); letter-spacing: var(--tracking-heading-item); }
    .sys thead { display: none; }
    .sys tr { display: grid; grid-template-columns: 1fr auto; padding: 12px 0; border-bottom: 1px solid var(--color-border-subtle); }
    .sys th, .sys td { border: 0; padding: 0; }
    .sys td:last-child { grid-column: 1 / -1; padding-top: 4px; }
    .modes-t thead, .modes-t td:nth-child(2) { display: none; }
    .modes-t tr { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--space-12); padding: 10px var(--space-8); border-bottom: 1px solid var(--color-border-subtle); }
    .modes-t th, .modes-t td { border: 0; padding: 0; background: none !important; }
    .modes-t th { grid-column: 1 / -1; padding-bottom: 4px; }
    .modes-t .here { background: var(--color-annotation-measure-soft); }
    .modes-t [data-sb-active]::after { content: ' · here'; }
    .swatches li { grid-template-columns: 44px minmax(0, 1fr); }
    .swatches .val { grid-column: 2; margin-top: -8px; }
    .hide-s { display: none; }
    .grid-btn .r { flex-wrap: wrap; justify-content: center; }
  }
</style>

<script>
  import { reduceMotion } from '../lib/motion';

  const root = document.getElementById('design-systems-dev')!;
  const win = root.querySelector<HTMLElement>('[data-sb]')!;
  const scroll = root.querySelector<HTMLElement>('[data-sb-scroll]')!;
  const menu = root.querySelector<HTMLButtonElement>('[data-sb-menu]')!;
  const items = [...root.querySelectorAll<HTMLButtonElement>('[data-sb-go]')];
  const pages = [...root.querySelectorAll<HTMLElement>('[data-sb-page]')];
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-sb-tab]')];
  const phone = matchMedia('(max-width: 760px)');
  let current = 'intro';
  let panel: 'canvas' | 'docs' = 'docs';

  // Pages and the Canvas / Docs tabs. Component pages open on Canvas, the others only have Docs.
  function show(id: string, keepScroll = false) {
    current = id;
    const page = pages.find((p) => p.dataset.sbPage === id)!;
    const hasCanvas = !!page.querySelector('[data-sb-panel="canvas"]');
    panel = hasCanvas ? 'canvas' : 'docs';
    pages.forEach((p) => (p.hidden = p !== page));
    items.forEach((i) => (i.dataset.sbGo === id ? i.setAttribute('aria-current', 'page') : i.removeAttribute('aria-current')));
    const item = items.find((i) => i.dataset.sbGo === id)!;
    root.querySelector('[data-sb-crumb]')!.textContent = item.textContent;
    root.querySelector('[data-sb-crumb-group]')!.textContent = `${item.dataset.sbGroup} /`;
    paintTabs();
    if (!keepScroll) scroll.scrollTop = 0;
  }
  function paintTabs() {
    const page = pages.find((p) => p.dataset.sbPage === current)!;
    const hasCanvas = !!page.querySelector('[data-sb-panel="canvas"]');
    page.querySelectorAll<HTMLElement>('[data-sb-panel]').forEach((el) => (el.hidden = el.dataset.sbPanel !== panel));
    tabs.forEach((t) => {
      const on = t.dataset.sbTab === panel;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (t.dataset.sbTab === 'canvas') t.setAttribute('aria-disabled', String(!hasCanvas));
    });
  }
  items.forEach((i) => i.addEventListener('click', () => {
    show(i.dataset.sbGo!);
    if (phone.matches) { setMenu(false); win.scrollIntoView({ block: 'start', behavior: reduceMotion() ? 'auto' : 'smooth' }); }
  }));
  tabs.forEach((t) => t.addEventListener('click', () => {
    if (t.getAttribute('aria-disabled') === 'true') return;
    panel = t.dataset.sbTab as 'canvas' | 'docs'; paintTabs();
  }));
  root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key; if (k !== 'ArrowLeft' && k !== 'ArrowRight') return;
    const other = tabs.find((t) => t.dataset.sbTab !== panel)!;
    if (other.getAttribute('aria-disabled') === 'true') return;
    panel = other.dataset.sbTab as 'canvas' | 'docs'; paintTabs(); other.focus();
  });

  // Phones: the menu button opens the page list in place
  function setMenu(open: boolean) { menu.setAttribute('aria-expanded', String(open)); win.toggleAttribute('data-sb-open', open); }
  menu.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
  phone.addEventListener('change', () => setMenu(false));

  // Search filters the page list. "/" inside the window jumps to it.
  const find = root.querySelector<HTMLInputElement>('[data-sb-find]')!;
  find.addEventListener('input', () => {
    const q = find.value.trim().toLowerCase(); let any = false;
    root.querySelectorAll<HTMLElement>('[data-sb-grp]').forEach((g) => {
      let shown = 0;
      g.querySelectorAll<HTMLButtonElement>('[data-sb-go]').forEach((b) => { const ok = !q || b.textContent!.toLowerCase().includes(q); b.parentElement!.hidden = !ok; if (ok) shown++; });
      g.hidden = shown === 0; if (shown) any = true;
    });
    root.querySelector<HTMLElement>('[data-sb-none]')!.hidden = any;
  });
  win.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !t.matches('input, select, textarea')) { e.preventDefault(); if (phone.matches) setMenu(true); find.focus(); }
  });

  // Dropdowns (SbDropdown.astro): open on click, close on Escape or a click outside, arrow keys move in the menu
  const dds = [...root.querySelectorAll<HTMLElement>('[data-sb-dd]')];
  const pickers: Record<string, (v: string) => void> = {};
  function onPick(name: string, fn: (v: string) => void) { pickers[name] = fn; }
  const ddParts = (dd: HTMLElement) => ({ btn: dd.querySelector<HTMLButtonElement>('[data-sb-dd-btn]')!, menu: dd.querySelector<HTMLElement>('[role="menu"]')!, items: [...dd.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')] });
  function setDd(dd: HTMLElement, open: boolean, focus = false) {
    const { btn, menu, items } = ddParts(dd);
    menu.hidden = !open; btn.setAttribute('aria-expanded', String(open));
    if (open && focus) (items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
  }
  function setDdValue(dd: HTMLElement, v: string) {
    const { btn, items } = ddParts(dd);
    items.forEach((i) => i.setAttribute('aria-checked', String(i.dataset.value === v)));
    dd.querySelector('[data-sb-dd-value]')!.textContent = v;
    btn.setAttribute('aria-label', `${ddParts(dd).menu.getAttribute('aria-label')}: ${v}`);
  }
  dds.forEach((dd) => {
    const { btn, menu, items } = ddParts(dd);
    btn.addEventListener('click', () => { const open = btn.getAttribute('aria-expanded') !== 'true'; dds.forEach((d) => d !== dd && setDd(d, false)); setDd(dd, open); });
    btn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); setDd(dd, true, true); } else if (e.key === 'Escape') setDd(dd, false); });
    items.forEach((i) => i.addEventListener('click', () => { setDdValue(dd, i.dataset.value!); setDd(dd, false); btn.focus(); pickers[dd.dataset.sbDd!]?.(i.dataset.value!); }));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setDd(dd, false); btn.focus(); return; }
      const n = items.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); items[(n + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus(); }
    });
  });
  document.addEventListener('click', (e) => dds.forEach((dd) => { if (!dd.contains(e.target as Node)) setDd(dd, false); }));

  // Theme: one switch for this page (this visit only), shown in the toolbar, the Modes story and the Modes page
  const html = document.documentElement; const dark = matchMedia('(prefers-color-scheme: dark)');
  const theme = () => (html.dataset.theme === 'dark' || html.dataset.theme === 'light' ? html.dataset.theme : dark.matches ? 'dark' : 'light');
  const setTheme = (to: string) => {
    if (to === theme()) return;
    const go = () => { html.dataset.theme = to; };
    const d = document as any;
    if (d.startViewTransition && !reduceMotion()) d.startViewTransition(go); else go();
  };
  root.querySelector('[data-sb-theme-btn2]')!.addEventListener('click', () => setTheme(theme() === 'dark' ? 'light' : 'dark'));
  root.querySelectorAll<HTMLButtonElement>('[data-sb-set-theme]').forEach((b) => b.addEventListener('click', () => setTheme(b.dataset.sbSetTheme!)));

  // Live values: read each token from the page, so the Colour page always matches the mode you see
  function paintMode() {
    const t = theme(); const name = t === 'dark' ? 'Dark - Dev' : 'Light - Dev';
    root.querySelectorAll('[data-sb-mode-name]').forEach((el) => (el.textContent = name));
    setDdValue(root.querySelector<HTMLElement>('[data-sb-dd="theme"]')!, name);
    root.querySelectorAll<HTMLButtonElement>('[data-sb-set-theme]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.sbSetTheme === t)));
    root.querySelectorAll<HTMLElement>('[data-sb-mode-cell]').forEach((c) => c.toggleAttribute('data-sb-active', c.dataset.sbModeCell === t));
    root.querySelector('[data-sb-theme-btn2]')!.textContent = `Switch this page to ${t === 'dark' ? 'light' : 'dark'}`;
    const cs = getComputedStyle(html);
    root.querySelectorAll<HTMLElement>('[data-sb-val]').forEach((v) => (v.textContent = cs.getPropertyValue(`--color-${v.dataset.sbVal}`).trim()));
  }
  onPick('theme', (v) => setTheme(v === 'Dark - Dev' ? 'dark' : 'light'));
  new MutationObserver(paintMode).observe(html, { attributes: true, attributeFilter: ['data-theme', 'data-view'] });
  dark.addEventListener('change', paintMode);

  // Button story: the controls drive a real .btn
  const demo = root.querySelector<HTMLAnchorElement>('[data-sb-demo-btn]')!;
  demo.addEventListener('click', (e) => e.preventDefault());
  const label = root.querySelector<HTMLInputElement>('[data-sb-c-label]')!;
  let state = 'Default';
  function paintBtn() {
    demo.textContent = label.value || ' ';
    const style = root.querySelector<HTMLInputElement>('[data-sb-c-style]:checked')!.value;
    demo.classList.toggle('btn-primary', style === 'primary');
    demo.classList.toggle('is-hover', state === 'Hover');
    demo.classList.toggle('is-focus', state === 'Focus');
  }
  label.addEventListener('input', paintBtn);
  onPick('state', (v) => { state = v; paintBtn(); });
  root.querySelectorAll('[data-sb-c-style]').forEach((r) => r.addEventListener('change', paintBtn));

  // Segmented control story: a real radio group, with arrow keys
  const seg = [...root.querySelectorAll<HTMLButtonElement>('[data-sb-demo-seg] button')];
  const pickSeg = (b: HTMLButtonElement) => seg.forEach((s) => { const on = s === b; s.setAttribute('aria-checked', String(on)); s.tabIndex = on ? 0 : -1; });
  seg.forEach((b, i) => {
    b.addEventListener('click', () => pickSeg(b));
    b.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!step) return; e.preventDefault();
      const n = seg[(i + step + seg.length) % seg.length]; pickSeg(n); n.focus();
    });
  });

  // Status pill story
  const pill = root.querySelector<HTMLElement>('[data-sb-demo-pill]')!;
  onPick('status', (v) => {
    pill.className = `pill pill-${v.toLowerCase()} big`;
    root.querySelector('[data-sb-demo-pill-label]')!.textContent = v;
  });

  show('intro'); paintMode();
</script>
