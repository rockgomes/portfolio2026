---
// Figma: Section / Design systems (48:1690). The four "how I build them" cards are small working tools (motion plan, moment 05).
import SectionHeader from './SectionHeader.astro';
import Glyph from './Glyph.astro';
const systems = [
  { label: 'Inbank DS', name: 'Inbank', when: '2023 - 2025', facts: ['Built from scratch right after the rebrand', 'One system for checkout in four countries and the back-office', 'WCAG built in ahead of an audit'], tags: ['Tokens', 'Components', 'Accessibility'] },
  { label: 'Bigbank DS', name: 'Bigbank', when: '2016 - 2020', facts: ['Built together with one other designer', 'A component library in code, used directly in the product', 'One system for every branch and market'], tags: ['Components', 'Code', 'Research'] },
  { label: 'Well DS', name: 'Well', when: 'Contract', facts: ['Rebuilt the back-office design system', 'Colour tokens updated to meet AAA contrast', 'Worked side by side with the dev team'], tags: ['Tokens', 'AAA contrast', 'Handoff'] },
];
const variants = [{ name: 'Primary', cls: 'pri' }, { name: 'Secondary', cls: 'sec' }, { name: 'Ghost', cls: 'gho' }];
const states = [{ name: 'Default', cls: '' }, { name: 'Hover', cls: 'hov' }, { name: 'Disabled', cls: 'dis' }];
const chains = [
  { sw: 'brand', prim: 'blue.600', sem: 'color.action.primary', use: 'button.bg' }, // row 1 drives the Primary buttons in the Variants and Properties cards
  { sw: 'primary', prim: 'grey.050', sem: 'color.text.primary', use: 'h1, row title' },
  { sw: 'redline', prim: 'red.400', sem: 'color.redline', use: 'pin, cursor' },
];
---
<section class="ds" id="design-systems" aria-labelledby="ds-title">
  <div class="wrap inner section-top">
    <div class="head">
      <p class="fig t-mono-label"><Glyph kind="master" /> Section / Design systems</p>
      <SectionHeader anchor title="Design systems" titleId="ds-title" subtitle="two built from zero, one rebuilt · this page uses a fourth" />
    </div>

    <div class="intro">
      <div class="lede">
        <p><strong>I have built design systems from scratch at Inbank and Bigbank, and rebuilt one at Well.</strong> Dev teams used each one in live products, on real deadlines.</p>
        <p>Most of the work is in the logic under the UI kit: how tokens are layered, how components are split, which properties exist, and what happens when the brand or the theme changes.</p>
      </div>
      <div class="systems">
        {systems.map((s) => (
          <div class="sys">
            <p class="fig t-mono-label"><Glyph kind="variant" /> {s.label}</p>
            <div class="card">
              <div class="top"><h3 class="t-heading-item">{s.name}</h3><span class="t-mono-small when">{s.when}</span></div>
              <ul class="facts">{s.facts.map((f) => <li><span class="dash t-mono-small" aria-hidden="true">—</span><span class="t-body-small">{f}</span></li>)}</ul>
              <div class="tags">{s.tags.map((t) => <span class="ptag ui-tag ui-tag-component">{t}</span>)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="specimens">
      <p class="how t-mono-label">how I build them</p>
      <div class="spec-grid">
        <article class="spec">
          <h3 class="spec-h"><span class="t-heading-item">One button set with variants</span></h3>
          <div class="area">
            <div class="set-wrap">
            <p class="fig t-mono-label"><Glyph kind="master" /> Button<span class="pick" data-pick></span></p>
            <div class="set" role="group" aria-label="Button variants: pick one" data-set>
              {variants.map((v) => (
                <div class="vr">{states.map((st) => <button type="button" class:list={['b', v.cls, st.cls]} data-v={v.name} data-s={st.name} aria-pressed="false">{st.name}</button>)}</div>
              ))}
            </div>
            </div>
          </div>
          <p class="cap t-body-small">One component set with Variant, State and Size. Teams pick a combination, so nobody copies a button and changes it.</p>
        </article>

        <article class="spec">
          <h3 class="spec-h"><span class="t-heading-item">Properties for small changes</span></h3>
          <div class="area" data-drag-bounds>
            <div class="ip">
              <div class="inst" data-draggable>
                <p class="fig t-mono-label"><Glyph kind="variant" /> Button</p>
                <span class="btn-demo" data-btn data-variant="Primary" data-state="Default" data-size="Medium" aria-hidden="true"><span class="ico t-mono-small" data-icon>+</span><span data-label>Save as view</span></span>
              </div>
              <div class="props t-mono-label" role="group" aria-label="Button properties">
                <p class="ph"><Glyph kind="variant" /> Button</p>
                <p class="pr"><span class="k"><i class="mut"><Glyph kind="prop" /></i>Variant</span><button type="button" class="v" data-prop="variant" aria-label="Variant: Primary. Change">Primary ▾</button></p>
                <p class="pr"><span class="k"><i class="mut"><Glyph kind="prop" /></i>State</span><button type="button" class="v" data-prop="state" aria-label="State: Default. Change">Default ▾</button></p>
                <p class="pr"><span class="k"><i class="mut"><Glyph kind="prop" /></i>Size</span><button type="button" class="v" data-prop="size" aria-label="Size: Medium. Change">Medium ▾</button></p>
                <p class="pr"><label class="k" for="ds-label"><i class="pur">T</i>Label</label><input id="ds-label" class="v vin" data-prop="label" value="Save as view" maxlength="18" autocomplete="off" spellcheck="false" /></p>
                <p class="pr"><span class="k"><i class="pur"><Glyph kind="bool" /></i>Show icon</span><button type="button" class="tg" role="switch" aria-checked="true" aria-label="Show icon" data-prop="show"></button></p>
                <p class="pr"><span class="k"><i class="pur"><Glyph kind="variant" /></i>Icon</span><button type="button" class="v" data-prop="icon" aria-label="Icon: plus. Change"><Glyph kind="variant" /> <span data-icon-name>plus</span> ▾</button></p>
              </div>
            </div>
          </div>
          <p class="cap t-body-small">Text, boolean and instance-swap properties handle small changes. I use variants only for real visual changes, so the set stays small.</p>
        </article>

        <article class="spec">
          <h3 class="spec-h"><span class="t-heading-item">Three layers of tokens</span></h3>
          <div class="area">
            <div class="chains t-mono-small" data-chains>
              {chains.map((c, i) => (
                <p class="chain" data-brand-row={i === 0 ? '' : undefined}>
                  {i === 0 ? <button type="button" class="sw rebrand" data-rebrand aria-label="Rebrand: change the primitive colour" title="Click to rebrand"></button> : <i class={`sw sw-${c.sw}`}></i>}
                  <span class="prim" data-prim={i === 0 ? '' : undefined}>{c.prim}</span><span class="arr">→</span><span class="sem">{c.sem}</span><span class="arr">→</span><span class="use">{c.use}</span>
                </p>
              ))}
            </div>
            <p class="hint t-mono-label">click the first swatch to rebrand the buttons above</p>
          </div>
          <p class="cap t-body-small">Primitives hold the raw values. Semantic tokens say where each value is used. Components use only semantic tokens, so a rebrand changes only tokens.</p>
        </article>

        <article class="spec">
          <h3 class="spec-h"><span class="t-heading-item">Dark and light modes</span></h3>
          <div class="area">
            <div class="modes" aria-hidden="true">
              <div class="mode" data-theme-sample="dark"><p class="ml t-mono-label">mode: dark<span class="here" data-here="dark"> · this page</span></p><div class="sample"><p class="st">Dynamic Lists</p><p class="sd t-body-small">One list, many views.</p><span class="stag ui-tag">Data, SaaS</span></div></div>
              <div class="mode" data-theme-sample="light"><p class="ml t-mono-label">mode: light<span class="here" data-here="light"> · this page</span></p><div class="sample"><p class="st">Dynamic Lists</p><p class="sd t-body-small">One list, many views.</p><span class="stag ui-tag">Data, SaaS</span></div></div>
            </div>
            <button type="button" class="btn" data-mode-switch>Switch this page to dark</button>
          </div>
          <p class="cap t-body-small">One set of components with a Dark and a Light mode. This page switches between them, and no frame is copied.</p>
        </article>
      </div>
    </div>
  </div>
</section>
<style>
  /* --brand is color.action.primary in the tokens card. Primary buttons in the Variants and Properties cards read it, so a rebrand restyles them. */
  /* Same look as the site's buttons (.btn and .btn-primary in base.css) */
  .ds { --brand: var(--color-annotation-measure); --brand-hover: color-mix(in srgb, var(--brand) 85%, var(--color-text-primary)); }
  .inner { display: flex; flex-direction: column; gap: var(--space-48); }
  .head { display: flex; flex-direction: column; gap: 10px; }
  .fig { margin: 0; display: flex; gap: 5px; align-items: center; color: var(--color-figma-component); white-space: nowrap; }
  .intro { display: flex; gap: var(--space-80); align-items: stretch; }
  .lede { width: 380px; flex: none; display: flex; flex-direction: column; gap: 14px; }
  .lede p { margin: 0; font: var(--type-body-default); color: var(--color-text-secondary); }
  .lede strong { font-weight: 600; color: var(--color-text-primary); }
  .systems { flex: 1 0 0; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-24); }
  .sys { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
  .card { flex: 1 0 auto; display: flex; flex-direction: column; gap: 14px; padding: var(--space-24); background: var(--color-surface-raised); border: 1px solid var(--color-figma-component); }
  .top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-8); }
  .top h3 { margin: 0; color: var(--color-text-primary); white-space: nowrap; }
  .when { color: var(--color-text-muted); white-space: nowrap; }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .facts li { display: flex; gap: 10px; }
  .dash { color: var(--color-figma-component); flex: none; }
  .facts .t-body-small { color: var(--color-text-secondary); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; padding-top: var(--space-4); }
  .specimens { display: flex; flex-direction: column; gap: var(--space-24); }
  .how { margin: 0; color: var(--color-annotation-measure); }
  .spec-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); }
  .spec { display: flex; flex-direction: column; gap: 14px; padding: var(--space-24); background: var(--color-surface-raised); border: 1px solid var(--color-border-strong); min-width: 0; }
  .spec-h { margin: 0; display: flex; gap: 10px; align-items: baseline; color: var(--color-text-primary); }
  .area { flex: 1 0 auto; min-height: 230px; display: flex; flex-direction: column; gap: 10px; align-items: center; justify-content: center; padding: var(--space-32) var(--space-24); background: var(--color-surface-stage); overflow: hidden; }
  .cap { margin: 0; color: var(--color-text-secondary); }
  /* The set's name sits on its top-left corner, like an instance's name in the Properties card */
  .set-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-8); }
  .set { display: flex; flex-direction: column; gap: var(--space-12); padding: var(--space-16); border: 1px dashed var(--color-figma-component); border-radius: 4px; }
  .vr { display: flex; gap: var(--space-12); }
  .b { font: 400 12.5px/18px var(--font-sans); padding: 5px 10px; background: transparent; border: 1px solid transparent; border-radius: var(--radius-control); color: var(--color-text-secondary); white-space: nowrap; cursor: pointer; }
  .b[aria-pressed='true'], .b.lit { outline: 1.5px solid var(--color-annotation-measure); outline-offset: 2px; }
  .pick { color: var(--color-text-secondary); }
  .pri { background: var(--brand); border-color: var(--brand); color: var(--color-surface-page); font-weight: 500; transition: background-color 0.4s, border-color 0.4s; }
  .pri.hov { background: var(--brand-hover); border-color: var(--brand-hover); }
  .sec { border-color: var(--color-border-strong); }
  .sec.hov, .gho.hov { color: var(--color-text-primary); }
  .gho.hov { background: var(--color-border-subtle); }
  .dis { opacity: 0.4; }
  .ip { display: flex; gap: var(--space-24); align-items: center; }
  .inst { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  /* The demo button follows the properties panel (and the variant set) through data attributes */
  /* The purple outline is the selected instance, as in Figma; the button inside is the site's button */
  .btn-demo { display: inline-flex; gap: 6px; align-items: center; padding: 5px 10px; border-radius: var(--radius-control); background: var(--brand); color: var(--color-surface-page); border: 1px solid var(--brand); outline: 1px solid var(--color-figma-component); outline-offset: 2px; font: 500 12.5px/18px var(--font-sans); white-space: nowrap; transition: background-color 0.4s, border-color 0.4s; }
  .btn-demo[data-variant='Secondary'], .btn-demo[data-variant='Ghost'] { background: transparent; color: var(--color-text-secondary); font-weight: 400; }
  .btn-demo[data-variant='Secondary'] { border-color: var(--color-border-strong); }
  .btn-demo[data-variant='Ghost'] { border-color: transparent; }
  .btn-demo[data-state='Hover'][data-variant='Primary'] { background: var(--brand-hover); border-color: var(--brand-hover); }
  .btn-demo[data-state='Hover'][data-variant='Secondary'], .btn-demo[data-state='Hover'][data-variant='Ghost'] { color: var(--color-text-primary); }
  .btn-demo[data-state='Hover'][data-variant='Ghost'] { background: var(--color-border-subtle); }
  .btn-demo[data-state='Disabled'] { opacity: 0.4; }
  .btn-demo[data-size='Small'] { padding: 3px 8px; font-size: 12px; }
  .btn-demo[data-size='Large'] { padding: 8px 14px; font-size: 14px; }
  .props { width: 230px; display: flex; flex-direction: column; gap: 7px; padding: 10px 12px; background: var(--color-surface-raised); border: 1px solid var(--color-border-strong); border-radius: 4px; }
  .props p { margin: 0; }
  .ph { color: var(--color-figma-component); }
  .pr { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); white-space: nowrap; }
  .k { display: flex; gap: 6px; color: var(--color-text-secondary); }
  .k i { font-style: normal; display: inline-flex; align-items: center; } .mut { color: var(--color-text-muted); } .pur { color: var(--color-figma-component); }
  .v { color: var(--color-text-primary); }
  button.v, .vin { margin: -2px -4px; padding: 2px 4px; border: 0; border-radius: 3px; background: transparent; font: inherit; letter-spacing: inherit; cursor: pointer; }
  button.v:hover, .vin:hover, .vin:focus { background: var(--color-surface-stage); }
  .vin { width: 16ch; text-align: right; cursor: text; outline: 0; }
  .vin:focus-visible { outline: 2px solid var(--color-annotation-measure); outline-offset: 1px; }
  .tg { position: relative; width: 24px; height: 14px; flex: none; padding: 0; border: 0; border-radius: 7px; background: var(--color-figma-component); cursor: pointer; transition: background 0.2s; }
  .tg::after { content: ''; position: absolute; top: 2px; left: 12px; width: 10px; height: 10px; border-radius: 5px; background: var(--color-surface-page); transition: left 0.2s cubic-bezier(.2,.8,.2,1); }
  .tg[aria-checked='false'] { background: var(--color-border-strong); }
  .tg[aria-checked='false']::after { left: 2px; }
  .chains { display: flex; flex-direction: column; gap: 10px; }
  .chain { margin: 0; display: flex; gap: 10px; align-items: center; white-space: nowrap; }
  .sw { width: 10px; height: 10px; border: 1px solid var(--color-border-strong); flex: none; }
  .sw-measure { background: var(--color-annotation-measure); } .sw-primary { background: var(--color-text-primary); } .sw-redline { background: var(--color-annotation-redline); }
  .prim { width: 96px; color: var(--color-text-primary); } .sem { width: 170px; color: var(--color-annotation-measure); } .use { width: 110px; color: var(--color-text-secondary); }
  .arr { color: var(--color-text-muted); }
  .sw.rebrand { width: 12px; height: 12px; padding: 0; cursor: pointer; background: var(--brand); outline: 1.5px dashed var(--color-annotation-measure); outline-offset: 2px; }
  .rebrand:hover { outline-style: solid; }
  .chain > * { border-radius: var(--radius-tag); transition: background-color 0.35s; }
  .chain > .flash { background-color: var(--color-annotation-measure-soft); }
  .hint { margin: var(--space-4) 0 0; color: var(--color-text-muted); }
  .here { display: none; color: var(--color-text-muted); }
  .mode[data-active] .here { display: inline; }
  @media (prefers-reduced-motion: reduce) { .tg, .tg::after { transition: none; } }
  .modes { display: flex; gap: var(--space-16); }
  .mode { display: flex; flex-direction: column; gap: 6px; }
  .ml { margin: 0; color: var(--color-figma-component); }
  .sample { width: 200px; display: flex; flex-direction: column; gap: var(--space-8); align-items: flex-start; padding: 14px; border-radius: 4px; background: var(--s-page); border: 1px solid var(--s-border); }
  .sample p { margin: 0; }
  .st { font: 500 13px/1.4 var(--font-sans); color: var(--s-primary); }
  .sd { color: var(--s-secondary); }
  .stag { background: var(--s-soft); color: var(--s-measure); } /* the shared Tag, in the demo's own colours */
  /* The two samples always show their own mode, whatever the page theme is (Figma values). */
  [data-theme-sample='dark'] { --s-page: #111316; --s-border: rgba(232,234,238,0.14); --s-primary: #e8eaee; --s-secondary: #b0b5bd; --s-measure: #4fd3ea; --s-soft: rgba(79,211,234,0.14); }
  [data-theme-sample='light'] { --s-page: #ffffff; --s-border: rgba(0,0,0,0.1); --s-primary: #1d1d1f; --s-secondary: #4e5157; --s-measure: #0a62d4; --s-soft: rgba(27,111,227,0.14); }
  @media (max-width: 1240px) { .intro { flex-direction: column; gap: var(--space-32); } .lede { width: min(560px, 100%); } }
  @media (max-width: 1040px) { .spec-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) { .systems { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) {
    .area { height: auto; min-height: 230px; overflow-x: auto; justify-content: flex-start; align-items: flex-start; }
    .ip, .modes { flex-direction: column; align-items: flex-start; }
    .chain { flex-wrap: wrap; white-space: normal; } .prim, .sem, .use { width: auto; }
  }
</style>

<script>
  import { gsap, playOnce, reduceMotion } from '../lib/motion';

  const root = document.getElementById('design-systems')!;
  const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel as any)!;
  const btn = $('[data-btn]'); const icon = $('[data-icon]'); const label = $('[data-label]');
  const cells = [...root.querySelectorAll<HTMLButtonElement>('[data-set] .b')];
  const pick = $('[data-pick]');
  const VARIANTS = ['Primary', 'Secondary', 'Ghost'], STATES = ['Default', 'Hover', 'Disabled'], SIZES = ['Small', 'Medium', 'Large'];
  const ICONS = [['plus', '+'], ['arrow', '→'], ['check', '✓']];
  const st = { variant: 'Primary', state: 'Default', size: 'Medium', show: true, icon: 0, picked: false };
  const next = (list: string[], v: string) => list[(list.indexOf(v) + 1) % list.length];
  const pop = (el: Element) => { if (!reduceMotion()) gsap.fromTo(el, { scale: 0.94 }, { scale: 1, duration: 0.3, ease: 'back.out(2.2)' }); };

  // 01 + 02 share one button: the variant set picks Variant and State, the panel sets everything.
  function paint() {
    Object.assign(btn.dataset, { variant: st.variant, state: st.state, size: st.size });
    icon.hidden = !st.show; icon.textContent = ICONS[st.icon][1];
    for (const [prop, val] of [['variant', st.variant], ['state', st.state], ['size', st.size]] as const) {
      const b = $(`[data-prop="${prop}"]`); b.textContent = `${val} ▾`; b.setAttribute('aria-label', `${prop[0].toUpperCase() + prop.slice(1)}: ${val}. Change`);
    }
    $('[data-icon-name]').textContent = ICONS[st.icon][0];
    $('[data-prop="icon"]').setAttribute('aria-label', `Icon: ${ICONS[st.icon][0]}. Change`);
    $('[data-prop="show"]').setAttribute('aria-checked', String(st.show));
    cells.forEach((c) => c.setAttribute('aria-pressed', String(st.picked && c.dataset.v === st.variant && c.dataset.s === st.state)));
    pick.textContent = st.picked ? ` / ${st.variant}, ${st.state}` : '';
  }
  cells.forEach((c) => c.addEventListener('click', () => { st.variant = c.dataset.v!; st.state = c.dataset.s!; st.picked = true; paint(); pop(btn); }));
  root.querySelector('.props')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-prop]'); if (!b) return;
    const prop = b.dataset.prop;
    if (prop === 'variant') st.variant = next(VARIANTS, st.variant);
    else if (prop === 'state') st.state = next(STATES, st.state);
    else if (prop === 'size') st.size = next(SIZES, st.size);
    else if (prop === 'show') st.show = !st.show;
    else if (prop === 'icon') st.icon = (st.icon + 1) % ICONS.length;
    else return;
    if (prop === 'variant' || prop === 'state') st.picked = true;
    paint(); pop(btn);
  });
  $<HTMLInputElement>('[data-prop="label"]').addEventListener('input', (e) => { label.textContent = (e.target as HTMLInputElement).value || ' '; });

  // 01: the nine states light up one after another, once, when the card comes into view.
  playOnce($('[data-set]'), () => {}, () => {
    const tl = gsap.timeline({ delay: 0.2 });
    cells.forEach((c, i) => tl.add(() => c.classList.add('lit'), i * 0.12).add(() => c.classList.remove('lit'), i * 0.12 + 0.3));
    return tl;
  }, 0.6);

  // 03: each chain lights up from primitive to use, row by row. The blue swatch "rebrands" the primitive.
  const rows = [...root.querySelectorAll<HTMLElement>('[data-chains] .chain')];
  playOnce($('[data-chains]'), () => rows.forEach((r) => gsap.set([...r.children].slice(1), { opacity: 0.2 })), () => {
    const tl = gsap.timeline({ delay: 0.2 });
    rows.forEach((r, i) => tl.to([...r.children].slice(1), { opacity: 1, duration: 0.25, stagger: 0.12 }, i * 0.45));
    return tl;
  }, 0.6);
  // Rebrand: the first token row is color.action.primary. A click flows along the chain, then restyles the Primary
  // buttons in 01 and 02, which read --brand.
  const PALETTE = [['blue.600', '--color-annotation-measure'], ['violet.500', '--color-figma-component'], ['green.600', '--color-status-positive'], ['grey.900', '--color-text-primary']];
  let brand = 0;
  const brandRow = $('[data-brand-row]');
  const primaries = [...root.querySelectorAll<HTMLElement>('[data-set] .pri')];
  $('[data-rebrand]').addEventListener('click', () => {
    brand = (brand + 1) % PALETTE.length;
    const [name, token] = PALETTE[brand];
    const prim = brandRow.querySelector<HTMLElement>('[data-prim]')!;
    const apply = () => root.style.setProperty('--brand', `var(${token})`);
    prim.textContent = name;
    if (reduceMotion()) { apply(); return; }
    const parts = [...brandRow.children].slice(1) as HTMLElement[]; // primitive → semantic → use
    const tl = gsap.timeline();
    pop(prim);
    parts.forEach((el, i) => tl.add(() => el.classList.add('flash'), i * 0.12).add(() => el.classList.remove('flash'), i * 0.12 + 0.45));
    tl.add(() => { apply(); primaries.forEach((c) => c.classList.add('lit')); if (btn.dataset.variant === 'Primary') pop(btn); }, parts.length * 0.12)
      .add(() => primaries.forEach((c) => c.classList.remove('lit')), '+=0.7');
  });

  // 04: a real switch for this page's mode. It lasts for this visit only.
  const html = document.documentElement; const dark = matchMedia('(prefers-color-scheme: dark)');
  const current = () => (html.dataset.theme === 'dark' || html.dataset.theme === 'light' ? html.dataset.theme : dark.matches ? 'dark' : 'light');
  const sw4 = $<HTMLButtonElement>('[data-mode-switch]');
  function paintMode() {
    const now = current();
    root.querySelectorAll<HTMLElement>('[data-theme-sample]').forEach((m) => m.toggleAttribute('data-active', m.dataset.themeSample === now));
    sw4.textContent = `Switch this page to ${now === 'dark' ? 'light' : 'dark'}`;
  }
  sw4.addEventListener('click', () => {
    const go = () => { html.dataset.theme = current() === 'dark' ? 'light' : 'dark'; paintMode(); };
    const d = document as any;
    if (d.startViewTransition && !reduceMotion()) d.startViewTransition(go); else go();
  });
  dark.addEventListener('change', paintMode);
  paint(); paintMode();
</script>

