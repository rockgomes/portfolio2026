---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CasePage from '../../components/case/CasePage.astro';
import { isPrivate } from '../../lib/private';

export async function getStaticPaths() {
  const items = await getCollection('projects');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// A case study with the summary fields uses the new layout (docs/superpowers/specs/2026-10-27-case-study-design.md).
// The others keep the old layout until each one gets its own pull request.
const isCase = !!d.problem;
---
<Base title={`${d.name} - Rock Gomes`} description={d.heroDescription} noindex={isPrivate(d)}>
  {isCase ? <CasePage entry={entry} /> : (
    <article class="article">
      <div class="eyebrow">Case study</div>
      <h1>{d.heroTitle || d.name}</h1>
      {d.heroDescription && <p class="lead">{d.heroDescription}</p>}
      {d.homeImage && <Image class="hero-img" src={d.homeImage} alt={d.homeImageAlt} widths={[768, 1536]} sizes="(min-width: 800px) 768px, 100vw" loading="eager" />}
      <div class="prose"><Content /></div>
    </article>
  )}
</Base>
