---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CaseSummary from '../../components/case/CaseSummary.astro';
import LivePage from '../../components/case/LivePage.astro';
import { isPrivate } from '../../lib/private';

export async function getStaticPaths() {
  const items = await getCollection('projects');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// A case study with the summary fields uses the new layout (docs/superpowers/specs/2026-10-27-case-study-design.md).
// The others keep the old layout until each one gets its own pull request.
const isCase = !!d.problem;
---
<Base title={`${d.name} - Rock Gomes`} description={d.heroDescription} noindex={isPrivate(d)}>
  {isCase ? (
    <>
      <CaseSummary title={d.cardTitle || d.name} subtitle={d.subtitle} lead={d.heroDescription} facts={d.facts} problem={d.problem} decision={d.decision} result={d.result} links={d.links}>
        {d.live ? <LivePage {...d.live} /> : d.homeImage && <Image class="case-hero" src={d.homeImage} alt={d.homeImageAlt} widths={[768, 1536]} sizes="(min-width: 1440px) 1280px, 100vw" loading="eager" />}
      </CaseSummary>
      <div class="case-body"><Content /></div>
    </>
  ) : (
    <article class="article">
      <div class="eyebrow">Case study</div>
      <h1>{d.heroTitle || d.name}</h1>
      {d.heroDescription && <p class="lead">{d.heroDescription}</p>}
      {d.homeImage && <Image class="hero-img" src={d.homeImage} alt={d.homeImageAlt} widths={[768, 1536]} sizes="(min-width: 800px) 768px, 100vw" loading="eager" />}
      <div class="prose"><Content /></div>
    </article>
  )}
</Base>
<style>
  .case-hero { width: 100%; height: auto; display: block; border: 1px solid var(--color-border-strong); }
  /* Until each part moves to its own component (phases 2 and 3), the rest of the old body reads like the old page */
  .case-body { max-width: 768px; margin: 0 auto; padding: var(--space-48) var(--gutter) var(--space-96); }
</style>
