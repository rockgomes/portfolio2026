---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { isPrivate } from '../lib/private';

const projects = (await getCollection('projects')).filter((p) => !isPrivate(p.data));
const experiments = (await getCollection('experiments'))
  .filter((e) => !isPrivate(e.data))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<Base title="Rock Gomes - Senior Product Designer" description="Back-office systems, data-heavy SaaS, design systems.">
  <h2 class="list-title" id="work">Work</h2>
  <div class="grid">
    {projects.map((p) => (
      <a class="card" href={`/project/${p.id}`}>
        {p.data.homeImage ? <Image src={p.data.homeImage} alt={p.data.homeImageAlt} widths={[480, 800]} sizes="(min-width: 700px) 380px, 100vw" /> : <div class="ph" />}
        <h3>{p.data.name}</h3>
        <div class="tags">{[...p.data.industry, ...p.data.focus].map((t) => <span>{t}</span>)}</div>
      </a>
    ))}
  </div>
  <h2 class="list-title">Experiments</h2>
  <div class="grid">
    {experiments.map((e) => (
      <a class="card" href={`/experiments/${e.id}`}>
        {e.data.cardImage ? <Image src={e.data.cardImage} alt="" widths={[480, 800]} sizes="(min-width: 700px) 380px, 100vw" /> : <div class="ph" />}
        <h3>{e.data.name}</h3>
        <p>{e.data.summary}</p>
      </a>
    ))}
  </div>
</Base>
